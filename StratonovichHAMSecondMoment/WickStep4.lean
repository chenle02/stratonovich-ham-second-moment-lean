/-! ### A bounded continuous function is self-adjoint -/

lemma star_bcf {X : Type*} [TopologicalSpace X] (f : X →ᵇ ℝ) : star f = f := by
  ext x; simp

variable {N : ℕ}

/-! ### Monomials on the cube -/

/-- The cube `[0,1]^N`. -/
abbrev Cube (N : ℕ) := Fin N → I

/-- The monomial `y ↦ ∏_l y_l^{j_l}` on the cube. -/
def mono (j : Fin N → ℕ) : Cube N →ᵇ ℝ :=
  BoundedContinuousFunction.mkOfCompact ⟨fun y => ∏ l, (y l : ℝ) ^ (j l), by fun_prop⟩

lemma mono_apply (j : Fin N → ℕ) (y : Cube N) : mono j y = ∏ l, (y l : ℝ) ^ (j l) := rfl

lemma mono_mul (j j' : Fin N → ℕ) : mono j * mono j' = mono (j + j') := by
  ext y
  simp only [BoundedContinuousFunction.coe_mul, Pi.mul_apply, mono_apply, Pi.add_apply,
    pow_add, Finset.prod_mul_distrib]

lemma mono_zero : mono (0 : Fin N → ℕ) = 1 := by
  ext y; simp [mono_apply]

/-- The star subalgebra generated by the coordinate functions. -/
def monoAlg (N : ℕ) : StarSubalgebra ℝ (Cube N →ᵇ ℝ) :=
  StarAlgebra.adjoin ℝ (Set.range fun l : Fin N => mono (Pi.single l 1))

lemma mem_closure_mono {g : Cube N →ᵇ ℝ}
    (hg : g ∈ Submonoid.closure ((Set.range fun l : Fin N => mono (Pi.single l 1)) ∪
      star (Set.range fun l : Fin N => mono (Pi.single l 1)))) :
    ∃ j : Fin N → ℕ, g = mono j := by
  induction hg using Submonoid.closure_induction with
  | mem x hx =>
    rcases hx with ⟨l, rfl⟩ | ⟨l, hl⟩
    · exact ⟨_, rfl⟩
    · refine ⟨Pi.single l 1, ?_⟩
      have : star x = mono (Pi.single l 1) := hl.symm
      rw [← this, star_bcf]
  | one => exact ⟨0, mono_zero.symm⟩
  | mul x y _ _ hx hy =>
    obtain ⟨j, rfl⟩ := hx
    obtain ⟨j', rfl⟩ := hy
    exact ⟨j + j', mono_mul j j'⟩

/-- **Moment uniqueness on the cube** (TeX 1810-1811, "polynomial density determines a unique
cluster limit"). -/
theorem ext_of_moments {P P' : Measure (Cube N)} [IsFiniteMeasure P] [IsFiniteMeasure P']
    (h : ∀ j : Fin N → ℕ, ∫ y, mono j y ∂P = ∫ y, mono j y ∂P') : P = P' := by
  refine ext_of_forall_mem_subalgebra_integral_eq_of_pseudoEMetric_complete_countable
    (A := monoAlg N) ?_ ?_
  · intro x y hxy
    obtain ⟨l, hl⟩ := Function.ne_iff.1 hxy
    refine ⟨_, ⟨BoundedContinuousFunction.toContinuousMapStarₐ ℝ (mono (Pi.single l 1)),
      ⟨mono (Pi.single l 1), StarAlgebra.subset_adjoin ℝ _ ⟨l, rfl⟩, rfl⟩, rfl⟩, ?_⟩
    simp only [BoundedContinuousFunction.coe_toContinuousMapStarₐ, mono_apply]
    intro e
    apply hl
    apply Subtype.ext
    have e' : ∏ i, (x i : ℝ) ^ (Pi.single l 1 : Fin N → ℕ) i =
        ∏ i, (y i : ℝ) ^ (Pi.single l 1 : Fin N → ℕ) i := e
    rwa [Finset.prod_eq_single l (fun i _ hi => by simp [hi])
        (by simp), Finset.prod_eq_single l (fun i _ hi => by simp [hi])
        (by simp), Pi.single_eq_same, pow_one, pow_one] at e'
  · intro g hg
    have hg' : g ∈ Subalgebra.toSubmodule (monoAlg N).toSubalgebra := hg
    rw [monoAlg, StarAlgebra.adjoin_eq_span] at hg'
    clear hg
    induction hg' using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨j, rfl⟩ := mem_closure_mono hx
      exact h j
    | zero => simp
    | add x y _ _ hx hy =>
      simp only [BoundedContinuousFunction.coe_add, Pi.add_apply]
      rw [integral_add (x.integrable P) (y.integrable P),
        integral_add (x.integrable P') (y.integrable P'), hx, hy]
    | smul a x _ hx =>
      simp only [BoundedContinuousFunction.coe_smul, smul_eq_mul]
      rw [integral_const_mul, integral_const_mul, hx]

/-! ### Convergence on the cube from moment convergence -/

lemma eq_of_mapClusterPt_of_tendsto {X Y : Type*} [TopologicalSpace X] [T2Space X]
    {F : Filter Y} {g : Y → X} {x m : X} (hc : MapClusterPt x F g) (ht : Tendsto g F (𝓝 m)) :
    x = m := by
  have : (𝓝 x ⊓ 𝓝 m).NeBot := hc.neBot.mono (inf_le_inf_left _ ht)
  exact eq_of_nhds_neBot this

/-- **Step 4 on the cube** (TeX 1809-1811): finite measures on `[0,1]^N` with masses `≤ C` whose
integer moments converge along a filter converge weakly, and the limit has the limiting
moments. -/
theorem tendsto_of_moments {ι : Type*} {F : Filter ι} [F.NeBot] {νs : ι → FiniteMeasure (Cube N)}
    {C : ℝ≥0} (hC : ∀ i, (νs i).mass ≤ C) {mom : (Fin N → ℕ) → ℝ}
    (hm : ∀ j, Tendsto (fun i => ∫ y, mono j y ∂(νs i : Measure (Cube N))) F (𝓝 (mom j))) :
    ∃ ν : FiniteMeasure (Cube N), Tendsto νs F (𝓝 ν) ∧
      ∀ j, ∫ y, mono j y ∂(ν : Measure (Cube N)) = mom j := by
  have hK := isCompact_setOfPred_finiteMeasure_le_of_compactSpace (Cube N) C
  have hmem : ∀ᶠ i in F, νs i ∈ {μ : FiniteMeasure (Cube N) | μ.mass ≤ C} :=
    Eventually.of_forall hC
  have hmap : Filter.map νs F ≤ 𝓟 {μ : FiniteMeasure (Cube N) | μ.mass ≤ C} :=
    le_principal_iff.2 hmem
  have hclus : ∀ μ, MapClusterPt μ F νs → ∀ j, ∫ y, mono j y ∂(μ : Measure (Cube N)) = mom j :=
    fun μ hμ j => by
      have hcont := FiniteMeasure.continuous_integral_boundedContinuousFunction (mono j)
      have h2 := hμ.continuousAt_comp hcont.continuousAt
      exact eq_of_mapClusterPt_of_tendsto h2 (hm j)
  obtain ⟨ν, -, hν⟩ := hK.exists_mapClusterPt hmap
  refine ⟨ν, hK.tendsto_nhds_of_unique_mapClusterPt hmem fun μ _ hμ => ?_, hclus ν hν⟩
  apply FiniteMeasure.toMeasure_injective
  exact ext_of_moments fun j => by rw [hclus μ hμ j, hclus ν hν j]

/-! ### Integrals of bounded functions continuous off a null zero set (the cutoff) -/

section Cutoff

variable {X : Type*} [TopologicalSpace X] [MeasurableSpace X] [OpensMeasurableSpace X]

/-- The cutoff value `max 0 (min 1 (g x / δ))` (TeX 1817-1819: "cutting off a neighborhood of
those zero faces"). -/
def cutv (g : X → ℝ) (δ : ℝ) (x : X) : ℝ := max 0 (min 1 (g x / δ))

omit [TopologicalSpace X] [MeasurableSpace X] [OpensMeasurableSpace X] in
lemma cutv_nonneg (g : X → ℝ) (δ : ℝ) (x : X) : 0 ≤ cutv g δ x := le_max_left _ _

omit [TopologicalSpace X] [MeasurableSpace X] [OpensMeasurableSpace X] in
lemma cutv_le_one (g : X → ℝ) (δ : ℝ) (x : X) : cutv g δ x ≤ 1 :=
  max_le zero_le_one (min_le_left _ _)

omit [MeasurableSpace X] [OpensMeasurableSpace X] in
lemma continuous_cutv {g : X → ℝ} (hg : Continuous g) (δ : ℝ) : Continuous (cutv g δ) := by
  unfold cutv; fun_prop

/-- The cutoff as a bounded continuous function. -/
def cut {g : X → ℝ} (hg : Continuous g) (δ : ℝ) : X →ᵇ ℝ :=
  BoundedContinuousFunction.ofNormedAddCommGroup (cutv g δ) (continuous_cutv hg δ) 1
    fun x => by
      rw [Real.norm_eq_abs, abs_of_nonneg (cutv_nonneg g δ x)]; exact cutv_le_one g δ x

omit [MeasurableSpace X] [OpensMeasurableSpace X] in
lemma cut_apply {g : X → ℝ} (hg : Continuous g) (δ : ℝ) (x : X) : cut hg δ x = cutv g δ x := rfl

/-- **Weak convergence tested by a bounded measurable function continuous off a null zero
set.** -/
theorem tendsto_integral_of_null {ι : Type*} {F : Filter ι}
    {μs : ι → FiniteMeasure X} {ν : FiniteMeasure X} (h : Tendsto μs F (𝓝 ν))
    {g : X → ℝ} (hg : Continuous g) (hg0 : ∀ x, 0 ≤ g x)
    (hν : (ν : Measure X) {x | g x = 0} = 0) {Φ : X → ℝ} (hΦm : Measurable Φ) {C : ℝ}
    (hΦC : ∀ y, |Φ y| ≤ C) (hΦc : ∀ y, g y ≠ 0 → ContinuousAt Φ y) :
    Tendsto (fun i => ∫ y, Φ y ∂(μs i : Measure X)) F (𝓝 (∫ y, Φ y ∂(ν : Measure X))) := by
  classical
  obtain ⟨x0⟩ | hX := isEmpty_or_nonempty X
  · simp [Subsingleton.elim (fun _ => _ : X → ℝ) 0]
    exact tendsto_const_nhds
  have hC0 : 0 ≤ C := (abs_nonneg _).trans (hΦC (Classical.arbitrary X))
  set chi : ℝ → X →ᵇ ℝ := fun δ => cut hg δ with hchi
  have chi_nonneg : ∀ δ y, 0 ≤ chi δ y := fun δ y => cutv_nonneg g δ y
  have chi_le_one : ∀ δ y, chi δ y ≤ 1 := fun δ y => cutv_le_one g δ y
  have chi_zero : ∀ δ y, g y = 0 → chi δ y = 0 := fun δ y hy => by
    simp [hchi, cut_apply, cutv, hy]
  have hψc : ∀ δ : ℝ, Continuous fun y : X => chi δ y * Φ y := fun δ => by
    refine continuous_iff_continuousAt.2 fun y => ?_
    by_cases hy : g y = 0
    · have hc0 : chi δ y = 0 := chi_zero δ y hy
      rw [ContinuousAt, hc0, zero_mul]
      refine squeeze_zero_norm (a := fun z : X => C * chi δ z) (fun z => ?_) ?_
      · rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg (chi_nonneg δ z), mul_comm]
        exact mul_le_mul_of_nonneg_right (hΦC z) (chi_nonneg δ z)
      · have := ((chi δ).continuous.tendsto y).const_mul C
        rwa [hc0, mul_zero] at this
    · exact ((chi δ).continuous.continuousAt).mul (hΦc y hy)
  have hint : ∀ (ρ : Measure X) [IsFiniteMeasure ρ] (f : X → ℝ), Measurable f →
      (∀ y, |f y| ≤ C) → Integrable f ρ := fun ρ _ f hf hfC =>
    Integrable.of_bound hf.aestronglyMeasurable C (Eventually.of_forall fun y => by
      rw [Real.norm_eq_abs]; exact hfC y)
  have hχm : ∀ δ : ℝ, Measurable fun y : X => chi δ y := fun δ => (chi δ).continuous.measurable
  have hb1 : ∀ δ : ℝ, ∀ y, |chi δ y * Φ y| ≤ C := fun δ y => by
    rw [abs_mul, abs_of_nonneg (chi_nonneg δ y)]
    calc chi δ y * |Φ y| ≤ 1 * C := mul_le_mul (chi_le_one δ y) (hΦC y) (abs_nonneg _)
          zero_le_one
      _ = C := one_mul C
  have hb2 : ∀ δ : ℝ, ∀ y, |(1 - chi δ y) * Φ y| ≤ C := fun δ y => by
    have h1 : 0 ≤ 1 - chi δ y := sub_nonneg.2 (chi_le_one δ y)
    have h2 : 1 - chi δ y ≤ 1 := by linarith [chi_nonneg δ y]
    rw [abs_mul, abs_of_nonneg h1]
    calc (1 - chi δ y) * |Φ y| ≤ 1 * C := mul_le_mul h2 (hΦC y) (abs_nonneg _) zero_le_one
      _ = C := one_mul C
  have hdec : ∀ δ : ℝ, ∀ (ρ : Measure X) [IsFiniteMeasure ρ],
      ∫ y, Φ y ∂ρ = ∫ y, chi δ y * Φ y ∂ρ + ∫ y, (1 - chi δ y) * Φ y ∂ρ := fun δ ρ _ => by
    refine Eq.trans ?_ (integral_add (f := fun y => chi δ y * Φ y)
      (g := fun y => (1 - chi δ y) * Φ y) ?_ ?_)
    · congr 1; funext y; ring
    · exact hint ρ _ ((hχm δ).mul hΦm) (hb1 δ)
    · exact hint ρ _ ((measurable_const.sub (hχm δ)).mul hΦm) (hb2 δ)
  have htail : ∀ δ : ℝ, ∀ (ρ : Measure X) [IsFiniteMeasure ρ],
      |∫ y, (1 - chi δ y) * Φ y ∂ρ| ≤ C * ∫ y, (1 - chi δ y) ∂ρ := fun δ ρ _ => by
    rw [← integral_const_mul, ← Real.norm_eq_abs]
    refine norm_integral_le_of_norm_le
      (((1 - chi δ).integrable ρ).const_mul C) (Eventually.of_forall fun y => ?_)
    have h1 : 0 ≤ 1 - chi δ y := sub_nonneg.2 (chi_le_one δ y)
    rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg h1, mul_comm]
    exact mul_le_mul_of_nonneg_right (hΦC y) h1
  -- the cutoff mass of the limit vanishes as `δ ↓ 0`
  have hA : Tendsto (fun δ : ℝ => ∫ y, (1 - chi δ y) ∂(ν : Measure X)) (𝓝[>] 0) (𝓝 0) := by
    have hae : ∀ᵐ y ∂(ν : Measure X), g y ≠ 0 := by
      rw [ae_iff]; simpa using hν
    have := tendsto_integral_filter_of_dominated_convergence (μ := (ν : Measure X))
      (l := 𝓝[>] (0 : ℝ))
      (F := fun δ : ℝ => fun y : X => 1 - chi δ y) (f := fun _ => (0 : ℝ)) (fun _ => (1 : ℝ))
      (Eventually.of_forall fun δ => (measurable_const.sub (hχm δ)).aestronglyMeasurable)
      (Eventually.of_forall fun δ => Eventually.of_forall fun y => by
        have h1 : 0 ≤ 1 - chi δ y := sub_nonneg.2 (chi_le_one δ y)
        rw [Real.norm_eq_abs, abs_of_nonneg h1]
        linarith [chi_nonneg δ y])
      (integrable_const _) (hae.mono fun y hy => ?_)
    · simpa using this
    · have hy0 : 0 < g y := lt_of_le_of_ne (hg0 y) (Ne.symm hy)
      refine tendsto_const_nhds.congr' ?_
      filter_upwards [Ioo_mem_nhdsGT hy0] with δ hδ
      have : 1 ≤ g y / δ := (one_le_div hδ.1).2 hδ.2.le
      simp only [hchi, cut_apply, cutv, min_eq_left this, max_eq_right zero_le_one, sub_self]
  rw [Metric.tendsto_nhds]
  intro ε hε
  set η : ℝ := ε / (8 * (C + 1)) with hη
  have hη0 : 0 < η := by positivity
  have hCη : C * η ≤ ε / 8 := by
    rw [hη, mul_div_assoc', div_le_div_iff₀ (by positivity) (by positivity)]
    nlinarith
  obtain ⟨δ, hδA, -⟩ := ((tendsto_order.1 hA).2 η hη0 |>.and self_mem_nhdsWithin).exists
  -- the approximating cutoff masses
  have hB := ((FiniteMeasure.continuous_integral_boundedContinuousFunction
    (1 - chi δ)).tendsto ν).comp h
  simp only [Function.comp_def, BoundedContinuousFunction.coe_sub,
    BoundedContinuousFunction.coe_one, Pi.sub_apply, Pi.one_apply] at hB
  have hνA : ∫ y, (1 - chi δ y) ∂(ν : Measure X) < η := hδA
  have hB' := (tendsto_order.1 hB).2 (2 * η) (by linarith)
  -- the continuous part
  let ψ : X →ᵇ ℝ := BoundedContinuousFunction.ofNormedAddCommGroup
    (fun y => chi δ y * Φ y) (hψc δ) C fun y => by rw [Real.norm_eq_abs]; exact hb1 δ y
  have hCc := ((FiniteMeasure.continuous_integral_boundedContinuousFunction ψ).tendsto ν).comp h
  have hC' := Metric.tendsto_nhds.1 hCc (ε / 2) (by positivity)
  filter_upwards [hB', hC'] with i hi1 hi2
  simp only [Function.comp_def] at hi2
  change dist (∫ y, chi δ y * Φ y ∂(μs i : Measure X)) (∫ y, chi δ y * Φ y ∂(ν : Measure X))
    < ε / 2 at hi2
  rw [hdec δ, hdec δ, Real.dist_eq]
  rw [Real.dist_eq] at hi2
  have t1 := htail δ (μs i : Measure X)
  have t2 := htail δ (ν : Measure X)
  have e : ∀ a b c d : ℝ, a + b - (c + d) = (a - c) + b - d := fun a b c d => by ring
  rw [e]
  calc |(∫ y, chi δ y * Φ y ∂(μs i : Measure X) - ∫ y, chi δ y * Φ y ∂(ν : Measure X)) +
        ∫ y, (1 - chi δ y) * Φ y ∂(μs i : Measure X) - ∫ y, (1 - chi δ y) * Φ y ∂(ν : Measure X)|
      ≤ |∫ y, chi δ y * Φ y ∂(μs i : Measure X) - ∫ y, chi δ y * Φ y ∂(ν : Measure X)| +
        |∫ y, (1 - chi δ y) * Φ y ∂(μs i : Measure X)| +
        |∫ y, (1 - chi δ y) * Φ y ∂(ν : Measure X)| := by
        refine (abs_sub _ _).trans ?_
        gcongr
        exact abs_add_le _ _
    _ < ε / 2 + C * (2 * η) + C * η := by
        have := mul_le_mul_of_nonneg_left hi1.le hC0
        have := mul_le_mul_of_nonneg_left hνA.le hC0
        linarith
    _ ≤ ε := by nlinarith

end Cutoff

/-! ### The change of variables `y = e^{-r}` -/

/-- The closed orthant `[0,∞)^N`. -/
def nonneg (N : ℕ) : Set (Fin N → ℝ) := Set.pi univ fun _ => Ici 0

lemma measurableSet_nonneg (N : ℕ) : MeasurableSet (nonneg N) :=
  MeasurableSet.univ_pi fun _ => measurableSet_Ici

lemma mem_nonneg {r : Fin N → ℝ} : r ∈ nonneg N ↔ ∀ l, 0 ≤ r l := by
  simp only [nonneg, Set.mem_univ_pi, Set.mem_Ici]

/-- `y_l = e^{-r_l}` (with `r_l` replaced by `max r_l 0`, so the map is defined and continuous
on all of `ℝ^N`; it is used only on the closed orthant). -/
def expNeg (r : Fin N → ℝ) : Cube N := fun l =>
  ⟨Real.exp (-(max (r l) 0)), (Real.exp_pos _).le,
    Real.exp_le_one_iff.2 (neg_nonpos.2 (le_max_right _ _))⟩

lemma continuous_expNeg : Continuous (expNeg : (Fin N → ℝ) → Cube N) :=
  continuous_pi fun _ => Continuous.subtype_mk (by fun_prop) _

lemma measurable_expNeg : Measurable (expNeg : (Fin N → ℝ) → Cube N) :=
  continuous_expNeg.measurable

/-- The inverse `r_l = -log y_l` (Lean's `log 0 = 0` at the zero faces, which are null). -/
def logNeg (y : Cube N) : Fin N → ℝ := fun l => -Real.log (y l)

lemma measurable_logNeg : Measurable (logNeg : Cube N → Fin N → ℝ) := by
  unfold logNeg; fun_prop

lemma logNeg_mem_nonneg (y : Cube N) : logNeg y ∈ nonneg N :=
  mem_nonneg.2 fun l => neg_nonneg.2 (Real.log_nonpos (y l).2.1 (y l).2.2)

lemma logNeg_expNeg {r : Fin N → ℝ} (hr : r ∈ nonneg N) : logNeg (expNeg r) = r := by
  funext l
  simp [logNeg, expNeg, max_eq_left (mem_nonneg.1 hr l), Real.log_exp]

lemma expNeg_logNeg {y : Cube N} (hy : ∀ l, y l ≠ 0) : expNeg (logNeg y) = y := by
  funext l
  have hy0 : (0 : ℝ) < y l := lt_of_le_of_ne (y l).2.1 (fun e => hy l (Subtype.ext e.symm))
  apply Subtype.ext
  have hl : 0 ≤ -Real.log (y l : ℝ) := neg_nonneg.2 (Real.log_nonpos (y l).2.1 (y l).2.2)
  simp only [expNeg, logNeg, max_eq_left hl, neg_neg, Real.exp_log hy0]

lemma continuousAt_logNeg {y : Cube N} (hy : ∀ l, y l ≠ 0) : ContinuousAt logNeg y := by
  refine continuousAt_pi.2 fun l => ?_
  have hy0 : (y l : ℝ) ≠ 0 := fun e => hy l (Subtype.ext e)
  have h1 : ContinuousAt (fun y : Cube N => Real.log ((y l : I) : ℝ)) y :=
    (Real.continuousAt_log hy0).comp
      (f := fun y : Cube N => ((y l : I) : ℝ)) (by fun_prop : Continuous fun y : Cube N => ((y l : I) : ℝ)).continuousAt
  exact h1.neg

/-- The product `∏_l y_l`, zero exactly on the `y`-zero faces. -/
def prodC (y : Cube N) : ℝ := ∏ l, (y l : ℝ)

lemma continuous_prodC : Continuous (prodC : Cube N → ℝ) := by unfold prodC; fun_prop

lemma prodC_nonneg (y : Cube N) : 0 ≤ prodC y := Finset.prod_nonneg fun l _ => (y l).2.1

lemma prodC_le_one (y : Cube N) : prodC y ≤ 1 :=
  Finset.prod_le_one₀ (fun l _ => (y l).2.1) fun l _ => (y l).2.2

lemma prodC_ne_zero {y : Cube N} (hy : prodC y ≠ 0) (l : Fin N) : y l ≠ 0 := by
  intro e; apply hy
  exact Finset.prod_eq_zero (Finset.mem_univ l) (by simp [e])

/-- The Laplace test function `e^{-Σ_l λ_l (r_l ∨ 0)}`. -/
def lap (lam : Fin N → ℝ) (r : Fin N → ℝ) : ℝ := Real.exp (-∑ l, lam l * max (r l) 0)

lemma continuous_lap (lam : Fin N → ℝ) : Continuous (lap lam) := by unfold lap; fun_prop

lemma lap_pos (lam : Fin N → ℝ) (r : Fin N → ℝ) : 0 < lap lam r := Real.exp_pos _

lemma lap_le_one {lam : Fin N → ℝ} (hlam : ∀ l, 0 ≤ lam l) (r : Fin N → ℝ) : lap lam r ≤ 1 :=
  Real.exp_le_one_iff.2 (neg_nonpos.2 (Finset.sum_nonneg fun l _ =>
    mul_nonneg (hlam l) (le_max_right _ _)))

lemma lap_of_nonneg (lam : Fin N → ℝ) {r : Fin N → ℝ} (hr : r ∈ nonneg N) :
    lap lam r = Real.exp (-∑ l, lam l * r l) := by
  simp only [lap, max_eq_left (mem_nonneg.1 hr _)]

/-- `lap λ` as a bounded continuous function (`λ ≥ 0`). -/
def lapB (lam : Fin N → ℝ) (hlam : ∀ l, 0 ≤ lam l) : (Fin N → ℝ) →ᵇ ℝ :=
  BoundedContinuousFunction.ofNormedAddCommGroup (lap lam) (continuous_lap lam) 1 fun r => by
    rw [Real.norm_eq_abs, abs_of_pos (lap_pos lam r)]; exact lap_le_one hlam r

lemma lapB_apply (lam : Fin N → ℝ) (hlam : ∀ l, 0 ≤ lam l) (r : Fin N → ℝ) :
    lapB lam hlam r = lap lam r := rfl

lemma mono_expNeg (j : Fin N → ℕ) (r : Fin N → ℝ) :
    mono j (expNeg r) = lap (fun l => (j l : ℝ)) r := by
  simp only [mono_apply, expNeg, lap, ← Finset.sum_neg_distrib, Real.exp_sum]
  refine Finset.prod_congr rfl fun l _ => ?_
  rw [← Real.exp_nat_mul]; ring_nf

lemma prodC_expNeg_rpow (c : ℝ) (r : Fin N → ℝ) :
    prodC (expNeg r) ^ c = lap (fun _ => c) r := by
  simp only [prodC, expNeg, lap, ← Real.exp_sum, ← Real.exp_mul]
  congr 1
  rw [Finset.sum_mul, ← Finset.sum_neg_distrib]
  refine Finset.sum_congr rfl fun l _ => ?_
  ring

lemma ae_nonneg_of_null {P : Measure (Fin N → ℝ)} (hP : P (nonneg N)ᶜ = 0) :
    ∀ᵐ r ∂P, r ∈ nonneg N := by
  rw [ae_iff]; exact hP

/-- **Uniqueness from integer Laplace transforms**: finite measures on the closed orthant with
the same Laplace transforms at the integer points are equal. -/
theorem ext_of_laplace {P P' : Measure (Fin N → ℝ)} [IsFiniteMeasure P] [IsFiniteMeasure P']
    (hP : P (nonneg N)ᶜ = 0) (hP' : P' (nonneg N)ᶜ = 0)
    (h : ∀ j : Fin N → ℕ, ∫ r, lap (fun l => (j l : ℝ)) r ∂P =
      ∫ r, lap (fun l => (j l : ℝ)) r ∂P') : P = P' := by
  have hmap : P.map expNeg = P'.map expNeg := by
    have : IsFiniteMeasure (P.map expNeg) := Measure.isFiniteMeasure_map _ _
    have : IsFiniteMeasure (P'.map expNeg) := Measure.isFiniteMeasure_map _ _
    refine ext_of_moments fun j => ?_
    rw [integral_map measurable_expNeg.aemeasurable (mono j).continuous.aestronglyMeasurable,
      integral_map measurable_expNeg.aemeasurable (mono j).continuous.aestronglyMeasurable]
    simp only [mono_expNeg]
    exact h j
  have back : ∀ (Q : Measure (Fin N → ℝ)), Q (nonneg N)ᶜ = 0 → (Q.map expNeg).map logNeg = Q :=
    fun Q hQ => by
      rw [Measure.map_map measurable_logNeg measurable_expNeg]
      have hae : (logNeg ∘ expNeg) =ᵐ[Q] id := by
        filter_upwards [ae_nonneg_of_null hQ] with r hr using logNeg_expNeg hr
      rw [Measure.map_congr hae, Measure.map_id]
  rw [← back P hP, ← back P' hP', hmap]

/-! ### Step 4 assembled -/

/-- **Step 4 of `L:spatial-wick-measures`** (TeX 1802-1820), abstract form.  Finite measures
`μs i` on `ℝ^N` with masses `≤ C`, eventually carried by the closed orthant, whose Laplace
transforms converge at every `λ ≥ 0` to `Lim λ`, with `Lim` right-continuous at `0` along the
diagonal, converge weakly to a finite measure carried by the closed orthant whose Laplace
transform is `Lim`. -/
theorem step4 {ι : Type*} {F : Filter ι} [F.NeBot] {μs : ι → FiniteMeasure (Fin N → ℝ)}
    {C : ℝ≥0} (hC : ∀ i, (μs i).mass ≤ C)
    (hsupp : ∀ᶠ i in F, (μs i : Measure (Fin N → ℝ)) (nonneg N)ᶜ = 0)
    {Lim : (Fin N → ℝ) → ℝ}
    (hL : ∀ lam : Fin N → ℝ, (∀ l, 0 ≤ lam l) →
      Tendsto (fun i => ∫ r, lap lam r ∂(μs i : Measure (Fin N → ℝ))) F (𝓝 (Lim lam)))
    (hcont : Tendsto (fun c : ℝ => Lim fun _ => c) (𝓝[>] 0) (𝓝 (Lim 0))) :
    ∃ ν : FiniteMeasure (Fin N → ℝ), Tendsto μs F (𝓝 ν) ∧
      (ν : Measure (Fin N → ℝ)) (nonneg N)ᶜ = 0 ∧
      ∀ lam : Fin N → ℝ, (∀ l, 0 ≤ lam l) →
        ∫ r, lap lam r ∂(ν : Measure (Fin N → ℝ)) = Lim lam := by
  set νs : ι → FiniteMeasure (Cube N) := fun i => (μs i).map expNeg with hνs
  have hmapint : ∀ (μ : FiniteMeasure (Fin N → ℝ)) (f : Cube N → ℝ), Continuous f →
      ∫ y, f y ∂((μ.map expNeg : FiniteMeasure (Cube N)) : Measure (Cube N)) =
        ∫ r, f (expNeg r) ∂(μ : Measure (Fin N → ℝ)) := fun μ f hf => by
    rw [FiniteMeasure.toMeasure_map, integral_map measurable_expNeg.aemeasurable
      hf.aestronglyMeasurable]
  obtain ⟨νc, hνc, hmom⟩ := tendsto_of_moments (νs := νs) (C := C)
    (mom := fun j => Lim fun l => (j l : ℝ))
    (fun i => (FiniteMeasure.mass_map_le measurable_expNeg.aemeasurable).trans (hC i))
    (fun j => by
      simp only [hνs, hmapint _ _ (mono j).continuous, mono_expNeg]
      exact hL _ fun l => Nat.cast_nonneg _)
  -- real moments `∫ (∏ y)^c`
  have hcpow : ∀ c : ℝ, 0 < c → Continuous fun y : Cube N => prodC y ^ c := fun c hc =>
    (Real.continuous_rpow_const hc.le).comp continuous_prodC
  have hrp : ∀ c : ℝ, 0 < c → ∫ y, prodC y ^ c ∂(νc : Measure (Cube N)) = Lim fun _ => c :=
    fun c hc => by
      let f : Cube N →ᵇ ℝ := BoundedContinuousFunction.ofNormedAddCommGroup
        (fun y => prodC y ^ c) (hcpow c hc) 1 fun y => by
          rw [Real.norm_eq_abs, abs_of_nonneg (Real.rpow_nonneg (prodC_nonneg y) _)]
          exact Real.rpow_le_one (prodC_nonneg y) (prodC_le_one y) hc.le
      have h1 := ((FiniteMeasure.continuous_integral_boundedContinuousFunction f).tendsto
        νc).comp hνc
      refine tendsto_nhds_unique h1 ?_
      simp only [Function.comp_def, hνs]
      have : ∀ i, ∫ y, f y ∂(((μs i).map expNeg : FiniteMeasure (Cube N)) : Measure (Cube N)) =
          ∫ r, lap (fun _ => c) r ∂(μs i : Measure (Fin N → ℝ)) := fun i => by
        rw [hmapint _ _ f.continuous]
        simp only [f, BoundedContinuousFunction.coe_ofNormedAddCommGroup, prodC_expNeg_rpow]
      simp only [this]
      exact hL _ fun _ => hc.le
  -- no mass on the `y`-zero faces
  have h0 : (νc : Measure (Cube N)) {y | prodC y = 0} = 0 := by
    have hlim : Tendsto (fun c : ℝ => ∫ y, prodC y ^ c ∂(νc : Measure (Cube N))) (𝓝[>] 0)
        (𝓝 (∫ y, ({y | prodC y = 0}ᶜ : Set (Cube N)).indicator (fun _ => (1 : ℝ)) y
          ∂(νc : Measure (Cube N)))) := by
      refine tendsto_integral_filter_of_dominated_convergence (fun _ => (1 : ℝ))
        (eventually_nhdsWithin_of_forall fun c hc =>
          (hcpow c hc).measurable.aestronglyMeasurable)
        (eventually_nhdsWithin_of_forall fun c hc => Eventually.of_forall fun y => ?_)
        (integrable_const _) (Eventually.of_forall fun y => ?_)
      · rw [Real.norm_eq_abs, abs_of_nonneg (Real.rpow_nonneg (prodC_nonneg y) _)]
        exact Real.rpow_le_one (prodC_nonneg y) (prodC_le_one y) (le_of_lt hc)
      · by_cases hy : prodC y = 0
        · rw [Set.indicator_of_notMem (show y ∉ ({y | prodC y = 0}ᶜ : Set (Cube N)) by simp [hy])]
          refine tendsto_const_nhds.congr' (eventually_nhdsWithin_of_forall fun c hc => ?_)
          simp [hy, Real.zero_rpow (ne_of_gt hc)]
        · rw [Set.indicator_of_mem (show y ∈ ({y | prodC y = 0}ᶜ : Set (Cube N)) from hy)]
          have := (Real.continuousAt_const_rpow hy (b := 0)).tendsto
          rw [Real.rpow_zero] at this
          exact this.mono_left nhdsWithin_le_nhds
    have hL0 : Lim 0 = (νc : Measure (Cube N)).real univ := by
      have := hmom 0
      simp only [mono_zero, BoundedContinuousFunction.coe_one, Pi.one_apply, integral_const,
        smul_eq_mul, mul_one, Pi.zero_apply, Nat.cast_zero] at this
      exact this.symm
    have e1 : ∫ y, ({y | prodC y = 0}ᶜ : Set (Cube N)).indicator (fun _ => (1 : ℝ)) y
        ∂(νc : Measure (Cube N)) = (νc : Measure (Cube N)).real univ := by
      rw [← hL0]
      refine tendsto_nhds_unique hlim (hcont.congr' (eventually_nhdsWithin_of_forall
        fun c hc => (hrp c hc).symm))
    have hms : MeasurableSet {y : Cube N | prodC y = 0} :=
      measurableSet_eq_fun continuous_prodC.measurable measurable_const
    rw [integral_indicator hms.compl, setIntegral_const, smul_eq_mul, mul_one,
      measureReal_compl hms] at e1
    have : (νc : Measure (Cube N)).real {y | prodC y = 0} = 0 := by linarith
    exact (measureReal_eq_zero_iff).1 this
  -- pullback
  have hconv : Tendsto μs F (𝓝 (νc.map logNeg)) := by
    rw [FiniteMeasure.tendsto_iff_forall_integral_tendsto]
    intro φ
    have hm : Measurable fun y : Cube N => φ (logNeg y) :=
      φ.continuous.measurable.comp measurable_logNeg
    have key : ∀ᶠ i in F, ∫ r, φ r ∂(μs i : Measure (Fin N → ℝ)) =
        ∫ y, φ (logNeg y) ∂(νs i : Measure (Cube N)) := by
      filter_upwards [hsupp] with i hi
      rw [hνs, FiniteMeasure.toMeasure_map, integral_map measurable_expNeg.aemeasurable
        hm.aestronglyMeasurable]
      refine integral_congr_ae ?_
      filter_upwards [ae_nonneg_of_null hi] with r hr
      rw [logNeg_expNeg hr]
    have hlim : ∫ r, φ r ∂((νc.map logNeg : FiniteMeasure (Fin N → ℝ)) : Measure (Fin N → ℝ)) =
        ∫ y, φ (logNeg y) ∂(νc : Measure (Cube N)) := by
      rw [FiniteMeasure.toMeasure_map, integral_map measurable_logNeg.aemeasurable
        φ.continuous.aestronglyMeasurable]
    rw [hlim]
    refine Tendsto.congr' (EventuallyEq.symm key) ?_
    exact tendsto_integral_of_null hνc continuous_prodC prodC_nonneg h0 hm (C := ‖φ‖)
      (fun y => by rw [← Real.norm_eq_abs]; exact φ.norm_coe_le_norm _)
      (fun y hy => φ.continuous.continuousAt.comp (continuousAt_logNeg (prodC_ne_zero hy)))
  refine ⟨νc.map logNeg, hconv, ?_, fun lam hlam => ?_⟩
  · rw [FiniteMeasure.toMeasure_map, Measure.map_apply measurable_logNeg
      (measurableSet_nonneg N).compl]
    have : logNeg ⁻¹' (nonneg N)ᶜ = (∅ : Set (Cube N)) := by
      ext y; simp [logNeg_mem_nonneg y]
    rw [this, measure_empty]
  · have h1 := ((FiniteMeasure.continuous_integral_boundedContinuousFunction
      (lapB lam hlam)).tendsto _).comp hconv
    exact tendsto_nhds_unique h1 (hL lam hlam)

end StratonovichHAMSecondMoment.WickStep4
