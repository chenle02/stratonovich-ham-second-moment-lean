/-! ### Closed Gaussian polynomial spaces and products (TeX 2181-2201) -/

section Poly

variable {X : Type v} {Ω : Type u} [MeasurableSpace Ω] {P : Measure Ω} {W : X → Ω → ℝ}
  {K : X → X → ℝ}

/-- The products `∏_{j<k} W(p_j)` of at most `n` field values, `k ≤ n` (`k = 0`: the constant
`1`), as `L²` classes (`TerminalWick.prodL2`). -/
def polyGen (hW : CenteredGaussianField W K P) (n : ℕ) : Set (Lp ℝ 2 P) :=
  {F | ∃ (k : ℕ) (p : Fin k → X), k ≤ n ∧ F = prodL2 hW p}

/-- **`P_(<=n)`, the closed Gaussian polynomial space of total degree at most `n`** (TeX
2181-2185 at revision edf7085f (book 1.1.3); decision 4): the closed linear span in `L²(Ω)` of
the products of at most `n` values of the centered Gaussian field `W`.  For the source field
(`SourceField`) the points range over all space-time points with all positive width pairs: "the
coupled source fields". -/
def PolyLE (hW : CenteredGaussianField W K P) (n : ℕ) : Submodule ℝ (Lp ℝ 2 P) :=
  (Submodule.span ℝ (polyGen hW n)).topologicalClosure

/-- **The centered linear Gaussian variables** of the field (TeX 2188: "any centered linear
Gaussian variable `H`"): the closed linear span in `L²(Ω)` of the field values. -/
def LinG (hW : CenteredGaussianField W K P) : Submodule ℝ (Lp ℝ 2 P) :=
  (Submodule.span ℝ (Set.range (fieldL2 hW))).topologicalClosure

end Poly

section Mul

variable {Ω : Type u} [MeasurableSpace Ω] {P : Measure Ω}

/-- **The product `HF` of two `L²` classes**: the class of the pointwise product of
representatives when it lies in `L²`, and the junk value `0` otherwise.  The junk value is
never relied on: the targets assert the `MemLp` of their products, except `GreenWidthMildTarget`
(both products `W_a X_(n-1)` and `W_a u`) and `ExternalVertexTarget` (only `W_a X_(n-1)`), whose
products are proved square integrable (module docstring of
`StratonovichHAMSecondMoment.MildInterface`). -/
def mulL2 (F G : Lp ℝ 2 P) : Lp ℝ 2 P :=
  haveI := Classical.propDecidable (MemLp (fun ω => F ω * G ω) 2 P)
  if h : MemLp (fun ω => F ω * G ω) 2 P then h.toLp _ else 0

end Mul

/-! ### Total fields, the mild measure and the mild integrals (TeX 2156-2161, 2236-2243) -/

section Fields

variable {d : ℕ} {α₀ : ℝ} {Γ : Measure (Rd d)} {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω}
  {W : SrcPt d → Ω → ℝ}

/-- A real width pair `e = (ε, δ)` as a positive width pair; the value `(1, 1)` off the open
quadrant is junk, never seen by `𝓝[>] 0 ×ˢ 𝓝[>] 0` (`eventually_toPosW`). -/
def toPosW (e : ℝ × ℝ) : PosW :=
  if h : 0 < e.1 ∧ 0 < e.2 then ⟨e, h⟩ else ⟨(1, 1), by norm_num⟩

/-- **The external field `W_a(s,y)`** at one width pair `a = (ε, δ)` (TeX 2236-2237), as an
`L²(Ω)` vector on `ℝ × ℝ^d`: L19's field value `W(s, y, a)` for `s ≥ 0`, `0` for `s < 0`. -/
def Wa (hW : SourceField α₀ Γ P W) (a : PosW) (p : ℝ × Rd d) : Lp ℝ 2 P :=
  if h : 0 ≤ p.1 then fieldL2 hW ((⟨p.1, h⟩, p.2), a) else 0

/-- **`Y_n^b(s,y)` as a total field** (TeX 2219-2226): L19's `Ya` at `s ≥ 0`, `0` for `s < 0`. -/
def Yf (hW : SourceField α₀ Γ P W) {n : ℕ} (b : Fin n → PosW) (p : ℝ × Rd d) : Lp ℝ 2 P :=
  if h : 0 ≤ p.1 then Ya hW p.1 h p.2 b else 0

/-- **`X_n(s,y)` as a total field** (TeX 2211-2230): L19's `XL2` at `s ≥ 0`, `0` for `s < 0`. -/
def Xf (hW : SourceField α₀ Γ P W) (n : ℕ) (p : ℝ × Rd d) : Lp ℝ 2 P :=
  if h : 0 ≤ p.1 then XL2 hW p.1 h p.2 n else 0

/-- **`u(s,y)` as a total field** (TeX 2211-2230, 2318-2324): L19's `uL2` at `s ≥ 0`, `0` for
`s < 0`. -/
def uf (hW : SourceField α₀ Γ P W) (p : ℝ × Rd d) : Lp ℝ 2 P :=
  if h : 0 ≤ p.1 then uL2 hW p.1 h p.2 else 0

/-- The time-space point `(s, y)` of an order-one terminal chain. -/
def mildPt {t : ℝ} (z : Fin 1 → Pt d t) : ℝ × Rd d := (((z 0).1 : ℝ), (z 0).2)

/-- **The mild measure `1_{(0,t)}(s) ds G(t-s, x-dy)`** (TeX 2158-2159, 2241-2242; it is
`E:terminal-chain-measure` 4276-4285 at `n = 1`): the image on `ℝ × ℝ^d` of L19's order-one
terminal chain measure `chainMeasure d 1 t ht x`.  In d = 3 the Green measure is the wave
Green measure M1 (decision 3). -/
def mildMeasure (d : ℕ) (t : ℝ) (ht : 0 ≤ t) (x : Rd d) : Measure (ℝ × Rd d) :=
  (chainMeasure d 1 t ht x).map mildPt

/-- The Green-smoothed mild measure `1_{(0,t)}(s) ds (p_η * G)(t-s, x-dy)` (TeX 2278-2279):
the image of L11's order-one `chainMeasureReg` (common-noise construction). -/
def mildMeasureReg (d : ℕ) (t : ℝ) (ht : 0 ≤ t) (x : Rd d) (η : ℝ) : Measure (ℝ × Rd d) :=
  (chainMeasureReg d 1 t ht x η).map mildPt

/-- **The mild integral `∫_0^t ∫ G(t-s, x-dy) f(s,y) ds`** of an `L²(Ω)`-valued integrand
(TeX 2158-2159), as a Bochner integral against `mildMeasure` (junk `0` if `f` is not
integrable; the targets assert the integrability). -/
def mildInt (f : ℝ × Rd d → Lp ℝ 2 P) (t : ℝ) (ht : 0 ≤ t) (x : Rd d) : Lp ℝ 2 P :=
  ∫ p, f p ∂mildMeasure d t ht x

/-- The Green-smoothed mild integral against `mildMeasureReg` (TeX 2278-2279). -/
def mildIntReg (f : ℝ × Rd d → Lp ℝ 2 P) (t : ℝ) (ht : 0 ≤ t) (x : Rd d) (η : ℝ) :
    Lp ℝ 2 P :=
  ∫ p, f p ∂mildMeasureReg d t ht x η

/-- **`I_{n,a}(t,x) = ∫_0^t ∫ G(t-s, x-dy) W_a(s,y) X_{n-1}(s,y) ds`** (TeX 2240-2243 at
revision edf7085f (book 1.1.3)), for `n ≥ 1` (at `n = 0` the natural subtraction gives the
value of `n = 1`; no target uses `n = 0`). -/
def Ina (hW : SourceField α₀ Γ P W) (a : PosW) (n : ℕ) (t : ℝ) (ht : 0 ≤ t) (x : Rd d) :
    Lp ℝ 2 P :=
  mildInt (fun p => mulL2 (Wa hW a p) (Xf hW (n - 1) p)) t ht x

/-- **`I_a(t,x) = ∫_0^t ∫ G(t-s, x-dy) W_a(s,y) u(s,y) ds`** (TeX 2323-2325; the integral of
`E:mild-construction` 2157-2159 at the width pair `a`). -/
def Ia (hW : SourceField α₀ Γ P W) (a : PosW) (t : ℝ) (ht : 0 ≤ t) (x : Rd d) : Lp ℝ 2 P :=
  mildInt (fun p => mulL2 (Wa hW a p) (uf hW p)) t ht x

end Fields

/-- **The variance `V_a = γ⁰_δ(0) γ_{2ε}(0)` of `W_a`** (TeX 2237-2238; `γ⁰_δ` is the capped
kernel `κ_δ` of 1366-1367, `kerA α₀ (capSet δ)`): `srcCov` on the diagonal (`Va_eq_srcCov`). -/
def Va (α₀ : ℝ) {d : ℕ} (Γ : Measure (Rd d)) (a : PosW) : ℝ :=
  (kerA α₀ (capSet a.del) 0).toReal * gammaEps Γ (a.eps + a.eps) 0

/-- The first moment `t ↦ E u(t,x)` as a total function on `ℝ` (value `0` at `t ≤ 0`), the
`Eu` of `LowAlphaUpper.lower_rate_le` (TeX 5839-5841). -/
def firstMean {d : ℕ} {α₀ : ℝ} {Γ : Measure (Rd d)} {Ω : Type*} [MeasurableSpace Ω]
    {P : Measure Ω} {W : SrcPt d → Ω → ℝ} (hW : SourceField α₀ Γ P W) (x : Rd d) (t : ℝ) : ℝ :=
  if ht : 0 < t then ∫ ω, srcU hW t ht.le x ω ∂P else 0

/-! ### Frozen targets: item A (Step 1, TeX 2178-2201) -/

/-- **A target, `E:occupied-multiplication` and the closedness of multiplication** (TeX
2187-2201 at revision edf7085f (book 1.1.3); decision 4: proved for ANY centered Gaussian field,
then specialized): for every centered Gaussian field `W` on a probability space, every centered
linear Gaussian variable `H ∈ LinG hW` and every `F ∈ P_(<=n)`, the product `HF` is in `L²` and
`‖HF‖₂ ≤ 2√(n+1) ‖H‖₂ ‖F‖₂` (2189-2191; `H = 0` included; `F` may depend on `H`, 2201); and
multiplication is closed (2198-2201): if `F_k → F` in `L²`, every `H F_k` is in `L²` and
`H F_k → G` in `L²`, then `HF` is in `L²` and equals `G`. -/
def OccupiedMultTarget : Prop :=
  ∀ {X : Type v} {Ω : Type u} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
    (W : X → Ω → ℝ) (K : X → X → ℝ) (hW : CenteredGaussianField W K P),
    (∀ (n : ℕ), ∀ H ∈ LinG hW, ∀ F ∈ PolyLE hW n,
      MemLp (fun ω => H ω * F ω) 2 P ∧
        ‖mulL2 H F‖ ≤ 2 * Real.sqrt ((n : ℝ) + 1) * ‖H‖ * ‖F‖) ∧
    ∀ (H : Lp ℝ 2 P) (F : ℕ → Lp ℝ 2 P) (F₀ G : Lp ℝ 2 P),
      (∀ k, MemLp (fun ω => H ω * F k ω) 2 P) → Tendsto F atTop (𝓝 F₀) →
      Tendsto (fun k => mulL2 H (F k)) atTop (𝓝 G) →
      MemLp (fun ω => H ω * F₀ ω) 2 P ∧ mulL2 H F₀ = G

/-! ### Frozen targets: item B (TeX 2181-2185) -/

/-- **B target, the fixed-width terminal integrals and their limits lie in `P_(<=n)`** (TeX
2183-2185 at revision edf7085f (book 1.1.3)): under `H:homog`, for every source field, `t ≥ 0`
(at `t = 0` the positive orders vanish, 2210), `x` and `n`, every `Y_n^a(t,x)` (positive
vertexwise widths `a`) and `X_n(t,x)` lie in `PolyLE hW n`.  (Partial sums of `u` then lie in
`PolyLE hW N` by `PolyLE_mono`.) -/
def PolyMemTarget (d : ℕ) : Prop :=
  ∀ {alpha α₀ : ℝ} {Γ μ : Measure (Rd d)}, HomogCovariance d alpha α₀ Γ μ →
    ∀ {Ω : Type u} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
      (W : SrcPt d → Ω → ℝ) (hW : SourceField α₀ Γ P W) (t : ℝ) (ht : 0 ≤ t) (x : Rd d)
      (n : ℕ),
      (∀ a : Fin n → PosW, Ya hW t ht x a ∈ PolyLE hW n) ∧ XL2 hW t ht x n ∈ PolyLE hW n

/-! ### Frozen targets: item C (Step 2, TeX 2204-2230) -/

/-- **C target, joint strong measurability** (TeX 2213-2219 at revision edf7085f (book
1.1.3)): under `H:homog`, for every source field, the total fields `(s,y) ↦ W_a(s,y)`,
`Y_n^b(s,y)`, `X_n(s,y)` and `u(s,y)` are strongly measurable as `L²(Ω)`-valued functions on
`ℝ × ℝ^d` ("All fields are strongly measurable as `L²(Ω)` vectors ... joint strong
measurability in `(s,y)` ... for `X_n`, then for the series"). -/
def JointMeasTarget (d : ℕ) : Prop :=
  ∀ {alpha α₀ : ℝ} {Γ μ : Measure (Rd d)}, HomogCovariance d alpha α₀ Γ μ →
    ∀ {Ω : Type u} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
      (W : SrcPt d → Ω → ℝ) (hW : SourceField α₀ Γ P W),
      (∀ a : PosW, StronglyMeasurable (Wa hW a)) ∧
      (∀ (n : ℕ) (b : Fin n → PosW), StronglyMeasurable (Yf hW b)) ∧
      (∀ n : ℕ, StronglyMeasurable (Xf hW n)) ∧ StronglyMeasurable (uf hW)

/-- **C target, spatial mean-square continuity and stationarity** (TeX 2219-2230 at revision
edf7085f (book 1.1.3)): under `H:homog`, for every source field and every time `s ≥ 0`: the
positive-width terminal terms `y ↦ Y_n^b(s,y)` are `L²`-continuous (2220-2222); the stationarity
identity `‖Y_n^b(s,y) - X_n(s,y)‖₂ = ‖Y_n^b(s,0) - X_n(s,0)‖₂` (2222-2227; `b` of length `n`);
and `y ↦ X_n(s,y)`, `y ↦ u(s,y)` are `L²`-continuous (2228-2230: "have continuous `L²`
representatives"; the Lean fields are the `L²`-valued maps themselves). -/
def FieldContTarget (d : ℕ) : Prop :=
  ∀ {alpha α₀ : ℝ} {Γ μ : Measure (Rd d)}, HomogCovariance d alpha α₀ Γ μ →
    ∀ {Ω : Type u} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
      (W : SrcPt d → Ω → ℝ) (hW : SourceField α₀ Γ P W) (s : ℝ) (hs : 0 ≤ s),
      (∀ (n : ℕ) (b : Fin n → PosW), Continuous fun y : Rd d => Ya hW s hs y b) ∧
      (∀ (n : ℕ) (b : Fin n → PosW) (y : Rd d),
        ‖Ya hW s hs y b - XL2 hW s hs y n‖ = ‖Ya hW s hs 0 b - XL2 hW s hs 0 n‖) ∧
      (∀ n : ℕ, Continuous fun y : Rd d => XL2 hW s hs y n) ∧
      Continuous fun y : Rd d => uL2 hW s hs y

/-- **C target, Step 2 in full** (TeX 2204-2230 at revision edf7085f (book 1.1.3)): joint
strong measurability and spatial continuity with stationarity. -/
def FieldMeasTarget (d : ℕ) : Prop :=
  JointMeasTarget.{u} d ∧ FieldContTarget.{u} d

/-- **Named input (fallback for C): `JointMeasurability`** — the joint strong measurability of
the fields (TeX 2213-2219 at revision edf7085f (book 1.1.3)), exactly `JointMeasTarget`.  True
(it is the TeX claim); declared; no theorem uses it (`MildFinal.field_meas_l20`). -/
structure JointMeasurability (d : ℕ) : Prop where
  holds : JointMeasTarget.{u} d

/-! ### Frozen targets: item D (Step 3, TeX 2233-2265, with 4276-4285) -/

/-- **D target, the terminal-kernel Fubini at positive widths** (TeX 2257-2260 with the
last-vertex reading of `E:terminal-chain-measure` 4276-4285, at revision edf7085f (book
1.1.3)): under `H:homog`, for every source field, `t > 0`, `x`, inner widths `b` on `m` vertices
and the terminal width `a`, the integrand `W_a Y_m^b` is in `L²` at every point and
mild-integrable, and
`Y_{m+1}^{(b,a)}(t,x) = ∫_0^t ∫ G(t-s, x-dy) W_a(s,y) Y_m^b(s,y) ds` (`a` at the last vertex,
next to `(t,x)`).  At `m = 0` the inner term is `Y_0 = 1` ("For `n = 1` ... the identity is
exact", 2260). -/
def TerminalFubiniTarget (d : ℕ) : Prop :=
  ∀ {alpha α₀ : ℝ} {Γ μ : Measure (Rd d)}, HomogCovariance d alpha α₀ Γ μ →
    ∀ {Ω : Type u} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
      (W : SrcPt d → Ω → ℝ) (hW : SourceField α₀ Γ P W) (t : ℝ) (ht : 0 < t) (x : Rd d)
      (m : ℕ) (b : Fin m → PosW) (a : PosW),
      (∀ p : ℝ × Rd d, MemLp (fun ω => Wa hW a p ω * Yf hW b p ω) 2 P) ∧
      Integrable (fun p => mulL2 (Wa hW a p) (Yf hW b p)) (mildMeasure d t ht.le x) ∧
      Ya hW t ht.le x (Fin.snoc b a : Fin (m + 1) → PosW) =
