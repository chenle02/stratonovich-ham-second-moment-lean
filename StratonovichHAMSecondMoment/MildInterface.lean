          ((k ! : ℝ) * (k : ℝ) ^ ((2 - α) * k)) ∧
      (2 * Zc α₀ * Kgen α (specV μ).toReal) ^ k * t ^ ((4 - α - α₀) * k) /
          ((k ! : ℝ) * (k : ℝ) ^ ((2 - α) * k)) ≤
        (2 * Zc α₀ * Kgen α (specV μ).toReal) ^ k * t ^ ((4 - α - α₀) * k) /
          (k ! : ℝ) ^ (3 - α)) ∧
    ∫ ω, srcU hW t ht.le x ω ^ 2 ∂P ≤
      Real.exp (C2 α α₀ (Kgen α (specV μ).toReal) * t ^ kappa α α₀)

/-- **W target, `ρ > κ`** (TeX 2369, proof 2431-2432 at revision edf7085f (book 1.1.3)): under
`H:homog`, `κ = (4-α-α₀)/(3-α) < ρ = β/(β-1) = (4-α-α₀)/(3-α-α₀)`. -/
def RhoGtKappaTarget : Prop :=
  ∀ {d : ℕ} {alpha α₀ : ℝ} {Γ μ : Measure (Rd d)}, HomogCovariance d alpha α₀ Γ μ →
    kappa alpha α₀ < (4 - alpha - α₀) / (3 - alpha - α₀)

/-- **W target, `P:envelope` in full** (TeX 2352-2373 at revision edf7085f (book 1.1.3)): the
conclusions of `SourceFinal.envelope_paper_l19` with the same `K`, plus `E:envelope-growth`
(2366-2370: `c t^ρ ≤ log B_K(t) ≤ C t^ρ` for all large `t`, `ρ = (4-α-α₀)/(3-α-α₀)`; the
lower bound concerns the numerical majorant only, 2371-2372) and `ρ > κ` (2369). -/
def EnvelopeTarget (d : ℕ) : Prop :=
  ∀ {alpha α₀ : ℝ} {Γ μ : Measure (Rd d)}, HomogCovariance d alpha α₀ Γ μ →
    ∃ K : ℝ, 0 < K ∧
      (∀ (t : ℝ) (ht : 0 < t) {Ω : Type u} [MeasurableSpace Ω]
        (P : Measure Ω) [IsProbabilityMeasure P] (W : SrcPt d → Ω → ℝ)
        (hW : SourceField α₀ Γ P W) (x : Rd d),
        (∀ m n k : ℕ, m + n = 2 * k → 1 ≤ k → ∀ θ : ℝ, 0 < θ →
          ∫ ω, srcX hW t ht.le x m ω * srcX hW t ht.le x n ω ∂P ≤
            (Pi2 m n).card * K ^ k * Real.exp (2 * θ * t) * θ ^ (-((4 - alpha - α₀) * k))) ∧
        ∫ ω, srcU hW t ht.le x ω ^ 2 ∂P ≤ BK K (4 - alpha - α₀) t) ∧
      (∃ c C T : ℝ, 0 < c ∧ 0 < C ∧ ∀ t : ℝ, T ≤ t →
        c * t ^ ((4 - alpha - α₀) / (3 - alpha - α₀)) ≤ Real.log (BK K (4 - alpha - α₀) t) ∧
          Real.log (BK K (4 - alpha - α₀) t) ≤ C * t ^ ((4 - alpha - α₀) / (3 - alpha - α₀))) ∧
      kappa alpha α₀ < (4 - alpha - α₀) / (3 - alpha - α₀)

/-! ### Sanity lemmas (interface only) -/

section Sanity

section PolySanity

variable {X : Type v} {Ω : Type u} [MeasurableSpace Ω] {P : Measure Ω} {W : X → Ω → ℝ}
  {K : X → X → ℝ}

/-- `P_(<=m) ⊆ P_(<=n)` for `m ≤ n` ("It includes all lower-degree contractions", 2182-2183). -/
theorem PolyLE_mono (hW : CenteredGaussianField W K P) {m n : ℕ} (h : m ≤ n) :
    PolyLE hW m ≤ PolyLE hW n := by
  unfold PolyLE
  refine Submodule.topologicalClosure_mono (Submodule.span_mono ?_)
  rintro F ⟨k, p, hk, rfl⟩
  exact ⟨k, p, hk.trans h, rfl⟩

/-- A product of at most `n` field values lies in `P_(<=n)`. -/
theorem prodL2_mem_PolyLE (hW : CenteredGaussianField W K P) {n k : ℕ} (hk : k ≤ n)
    (p : Fin k → X) : prodL2 hW p ∈ PolyLE hW n :=
  Submodule.le_topologicalClosure _ (Submodule.subset_span ⟨k, p, hk, rfl⟩)

/-- The constant `1` (the empty product) lies in every `P_(<=n)`. -/
theorem one_mem_PolyLE (hW : CenteredGaussianField W K P) (n : ℕ) :
    prodL2 hW (Fin.elim0 : Fin 0 → X) ∈ PolyLE hW n :=
  prodL2_mem_PolyLE hW (Nat.zero_le n) _

/-- Every field value is a centered linear Gaussian variable. -/
theorem fieldL2_mem_LinG (hW : CenteredGaussianField W K P) (p : X) : fieldL2 hW p ∈ LinG hW :=
  Submodule.le_topologicalClosure _ (Submodule.subset_span ⟨p, rfl⟩)

end PolySanity

section MulSanity

variable {Ω : Type u} [MeasurableSpace Ω] {P : Measure Ω}

/-- On an `L²` product, `mulL2` is the honest product class. -/
theorem mulL2_of_memLp {F G : Lp ℝ 2 P} (h : MemLp (fun ω => F ω * G ω) 2 P) :
    mulL2 F G = h.toLp _ := by
  unfold mulL2; simp [h]

/-- On an `L²` product, `mulL2 F G = F G` almost surely. -/
theorem coeFn_mulL2 {F G : Lp ℝ 2 P} (h : MemLp (fun ω => F ω * G ω) 2 P) :
    mulL2 F G =ᵐ[P] fun ω => F ω * G ω := by
  rw [mulL2_of_memLp h]; exact MemLp.coeFn_toLp _

end MulSanity

/-- On the open quadrant `toPosW` is the honest width pair. -/
theorem toPosW_of_pos {e : ℝ × ℝ} (h : 0 < e.1 ∧ 0 < e.2) : toPosW e = ⟨e, h⟩ := by
  unfold toPosW; simp [h]

/-- The external width filter only sees honest width pairs. -/
theorem eventually_toPosW :
    ∀ᶠ e : ℝ × ℝ in 𝓝[>] (0 : ℝ) ×ˢ 𝓝[>] (0 : ℝ),
      (toPosW e).eps = e.1 ∧ (toPosW e).del = e.2 := by
  filter_upwards [prod_mem_prod (self_mem_nhdsWithin : Ioi (0 : ℝ) ∈ 𝓝[>] (0 : ℝ))
    (self_mem_nhdsWithin : Ioi (0 : ℝ) ∈ 𝓝[>] (0 : ℝ))] with e he
  rw [toPosW_of_pos ⟨he.1, he.2⟩]
  exact ⟨rfl, rfl⟩

section FieldSanity

variable {d : ℕ} {α₀ : ℝ} {Γ : Measure (Rd d)} {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω}
  {W : SrcPt d → Ω → ℝ}

theorem Wa_of_nonneg (hW : SourceField α₀ Γ P W) (a : PosW) {s : ℝ} (hs : 0 ≤ s) (y : Rd d) :
    Wa hW a (s, y) = fieldL2 hW ((⟨s, hs⟩, y), a) := by
  unfold Wa; simp [hs]

theorem Yf_of_nonneg (hW : SourceField α₀ Γ P W) {n : ℕ} (b : Fin n → PosW) {s : ℝ}
    (hs : 0 ≤ s) (y : Rd d) : Yf hW b (s, y) = Ya hW s hs y b := by
  unfold Yf; simp [hs]

theorem Xf_of_nonneg (hW : SourceField α₀ Γ P W) (n : ℕ) {s : ℝ} (hs : 0 ≤ s) (y : Rd d) :
    Xf hW n (s, y) = XL2 hW s hs y n := by
  unfold Xf; simp [hs]

theorem uf_of_nonneg (hW : SourceField α₀ Γ P W) {s : ℝ} (hs : 0 ≤ s) (y : Rd d) :
    uf hW (s, y) = uL2 hW s hs y := by
  unfold uf; simp [hs]

end FieldSanity

/-- `V_a` is the variance `srcCov(p, p)` of the field at any point with widths `a`. -/
theorem Va_eq_srcCov {d : ℕ} (α₀ : ℝ) (Γ : Measure (Rd d)) (a : PosW)
    (z : ↥(Set.Ici (0 : ℝ)) × Rd d) : Va α₀ Γ a = srcCov α₀ Γ (z, a) (z, a) := by
  rw [srcCov_diag]; rfl

/-- `V_a ≥ 0`. -/
theorem Va_nonneg {d : ℕ} (α₀ : ℝ) (Γ : Measure (Rd d)) (a : PosW) : 0 ≤ Va α₀ Γ a := by
  rw [Va_eq_srcCov α₀ Γ a ((⟨0, le_refl 0⟩ : ↥(Set.Ici (0 : ℝ))), 0)]
  exact srcCov_nonneg _ _

/-- `FieldMeasTarget` unfolds to its two halves. -/
theorem fieldMeas_iff (d : ℕ) :
    FieldMeasTarget.{u} d ↔ JointMeasTarget.{u} d ∧ FieldContTarget.{u} d := Iff.rfl

/-- **Non-vacuity bookkeeping**: `MildConstructionTarget` at `Type` gives `P:mild-construction`
for the constructed model M9. -/
theorem mildConstructionM9_of {d : ℕ} (h : MildConstructionTarget.{0} d) :
    MildConstructionM9 d := fun hH t ht x =>
  (h hH (m9 (SourceFinal.source_field_l19 d) hH).P (m9 (SourceFinal.source_field_l19 d) hH).W
    (m9 (SourceFinal.source_field_l19 d) hH).field t ht x).2.2

end Sanity

