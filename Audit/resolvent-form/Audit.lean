namespace StratonovichHAMSecondMoment.Audit.ResolventForm

open StratonovichHAMSecondMoment.ResolventForm
open HomogHypothesis (Rd)
open scoped BesselPotentialSpace

set_option pp.all false in
/-- Consumer: a bounded real potential `V` (`|V| ≤ M`, `1 ≤ M`) gives, through the wrapper,
a contraction resolvent on `L²` that is self-adjoint, positive and injective, with the form
lower bound `‖u‖₂² ≤ q_V(u) + (2 + M²) ‖u‖₂²`. -/
theorem audit_consumer {d : ℕ} (V : Rd d → ℝ) (hV : Measurable V) (M : ℝ)
    (hM : ∀ x, |V x| ≤ M) (hM1 : 1 ≤ M) :
    (∀ u : H^{1}(Rd d), ‖embL2 u‖ ^ 2 ≤
      (inner ℂ (formOp (potOp V hV M hM) (2 + M ^ 2) u) u).re) ∧
    ∃ R : MeasureTheory.Lp ℂ 2 (MeasureTheory.volume : MeasureTheory.Measure (Rd d)) →L[ℂ]
        MeasureTheory.Lp ℂ 2 (MeasureTheory.volume : MeasureTheory.Measure (Rd d)),
      IsSelfAdjoint R ∧ R.IsPositive ∧ ‖R‖ ≤ 1 ∧ Function.Injective R := by
  obtain ⟨-, hlow, -, R, S, -, -, -, h4, h5, h6, h7⟩ :=
    signed_closed_form_resolvent_paper (potOp_isSelfAdjoint V hV M hM)
      (potOp_signedMultiplierForm V hV M hM) (max_le hM1 le_rfl)
  exact ⟨hlow, R, h4, h5, h6, h7⟩

#check @audit_consumer
#print axioms audit_consumer

end StratonovichHAMSecondMoment.Audit.ResolventForm
