open StratonovichHAMSecondMoment.FiniteWick StratonovichHAMSecondMoment.TerminalWick
  StratonovichHAMSecondMoment.TerminalWickInputs
  StratonovichHAMSecondMoment.TerminalWickRegularization

/-- Consumer of the wrapper: `Y_2^η → Y_2` in `L²` as `η ↓ 0`, the mixed second moment
`E[Y_1^{η₁} Y_3^{η₂}]` converges, and the regularized `g_2` has mass `T^4/24`. -/
private theorem audit_consumer {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω)
    [IsProbabilityMeasure P] (d : ℕ) (hd : d = 1 ∨ d = 2 ∨ d = 3) (T : ℝ) (hT : 0 < T)
    (x : HomogHypothesis.Rd d) (W : Pt d T → Ω → ℝ) (K : Pt d T → Pt d T → ℝ)
    (hW : CenteredGaussianField W K P)
    (hVfin : BddAbove (Set.range fun p => K p p)) (hcell : MeanSquareCellContinuous K) :
    Tendsto (fun η => chainIntegral (fun n => chainMeasureReg d n T hT.le x η) hW 2)
        (𝓝[>] 0) (𝓝 (chainIntegral (fun n => chainMeasure d n T hT.le x) hW 2)) ∧
      Tendsto (fun p : ℝ × ℝ =>
          ∫ ω, chainIntegral (fun n => chainMeasureReg d n T hT.le x p.1) hW 1 ω *
            chainIntegral (fun n => chainMeasureReg d n T hT.le x p.2) hW 3 ω ∂P)
        (𝓝[>] 0 ×ˢ 𝓝[>] 0)
        (𝓝 (∫ ω, chainIntegral (fun n => chainMeasure d n T hT.le x) hW 1 ω *
          chainIntegral (fun n => chainMeasure d n T hT.le x) hW 3 ω ∂P)) ∧
      chainMeasureReg d 2 T hT.le x 1 Set.univ = ENNReal.ofReal (T ^ 4 / 24) := by
  have h := terminal_wick_regularization_paper P d hd T hT x W K hW hVfin hcell
  refine ⟨h.2.2.1 2, h.2.2.2 1 3, ?_⟩
  rw [chainMeasureReg_univ d hd 2 T hT.le x 1]
  norm_num [Nat.factorial]

#check @audit_consumer
#print axioms audit_consumer

end StratonovichHAMSecondMoment.Audit.TerminalWickRegularization
