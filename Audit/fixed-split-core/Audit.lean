open MeasureTheory Finset StratonovichHAMSecondMoment

namespace StratonovichHAMSecondMoment.Audit.FixedSplitCore

open StratonovichHAMSecondMoment.FixedSplitCore StratonovichHAMSecondMoment.IntervalScalar

/-- Consumer of the wrapper: under `H:homog`, the before-absorption bound for
every split yields the `hfixed` input of
`IntervalScalarCompleted.interval_coefficient_assembly_paper_completed`
with `Cs = splitConst δ`, which is nonnegative. -/
private theorem audit_consumer {d : ℕ} {alpha alpha0 : ℝ} {Γ μ : Measure (HomogHypothesis.Rd d)}
    (hH : HomogHypothesis.HomogCovariance d alpha alpha0 Γ μ)
    {R T δ V : ℝ} {M k : ℕ} (h σ : Fin M → ℝ) (Q : (Fin M → ℕ × ℕ) → ℝ)
    (hRdef : R = alpha * Real.pi * (μ (Metric.ball 0 1)).toReal /
      (2 * Real.sin (Real.pi * alpha / 2)))
    (hRpos : 0 < R) (hk : 1 ≤ k) (hT : 0 < T) (hV : 0 ≤ V) (hδ : 0 < δ)
    (hh : ∀ i, 0 < h i) (hσpos : ∀ i, 0 < σ i)
    (hbefore : ∀ κ ∈ (univ : Finset (Fin M)).finsuppAntidiag k,
      ∀ p ∈ Fintype.piFinset (fun i => antidiagonal (2 * κ i)),
        |Q p| ≤ (k : ℝ) ^ 2 * Mk k ^ 2 * V *
          ∏ i, beforeFactor alpha δ R (σ i) (h i) (k / T) (κ i) (p i)) :
    0 ≤ splitConst δ ∧
      ∀ κ ∈ (univ : Finset (Fin M)).finsuppAntidiag k,
        ∀ p ∈ Fintype.piFinset (fun i => antidiagonal (2 * κ i)),
          |Q p| ≤ (k : ℝ) ^ 2 * splitConst δ ^ k * R ^ k * V *
            ∏ i, splitFactor alpha (σ i) (h i) (k / T) (κ i) (p i) :=
  ⟨splitConst_nonneg δ,
    split_explicit_constant_paper hH h σ Q hRdef hRpos hk hT hV hδ hh hσpos hbefore⟩

#check @audit_consumer
#print axioms audit_consumer

end StratonovichHAMSecondMoment.Audit.FixedSplitCore
