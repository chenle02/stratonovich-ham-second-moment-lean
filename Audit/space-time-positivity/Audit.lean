open MeasureTheory StratonovichHAMSecondMoment

namespace StratonovichHAMSecondMoment.Audit.SpaceTimePositivity

open StratonovichHAMSecondMoment.SpaceTimePositivity

/-- Consumer of the wrapper: under `H:homog`, `Γ ≠ 0`, `a = α₀` and `Ψ ∈ C_pos`, for every
continuous compactly supported `g`, `∫_I ∫ h_{Ψ,t} g_t² ≤ √(v_Ψ A(g))` with `A(g) ≥ 0`. -/
private theorem audit_consumer {d : ℕ} {alpha alpha0 : ℝ} {Γ μ : Measure (HomogHypothesis.Rd d)}
    (hH : HomogHypothesis.HomogCovariance d alpha alpha0 Γ μ) (hΓ : Γ ≠ 0)
    {Ψ : ℝ × HomogHypothesis.Rd d → ℝ} (hΨ : Ψ ∈ VariationalDilation.CPos d)
    {g : ℝ × HomogHypothesis.Rd d → ℝ} (hg : Continuous g) (hgs : HasCompactSupport g) :
    0 ≤ stForm alpha0 Γ (fun p => g p ^ 2) (fun p => g p ^ 2) ∧
      ∫ t in Set.Ioo (0 : ℝ) 1, ∫ x, VariationalDilation.mean alpha0 Γ Ψ t x * g (t, x) ^ 2 ≤
        Real.sqrt (VariationalDilation.rawCost alpha0 Γ Ψ *
          stForm alpha0 Γ (fun p => g p ^ 2) (fun p => g p ^ 2)) := by
  obtain ⟨-, h2, -, -, -, h6⟩ := occupation_raw_square_cc_paper hH hΓ rfl hΨ hg hgs
  exact ⟨h2, h6⟩

/-- Consumer of the interface for item L8-c2. -/
private theorem audit_consumer_cs {d : ℕ} {alpha alpha0 : ℝ}
    {Γ μ : Measure (HomogHypothesis.Rd d)}
    (hH : HomogHypothesis.HomogCovariance d alpha alpha0 Γ μ) : SpaceTimeCS alpha0 Γ :=
  spaceTimeCS_holds hH

end StratonovichHAMSecondMoment.Audit.SpaceTimePositivity
