namespace StratonovichHAMSecondMoment.Audit.VariationalRate

open MeasureTheory Set StratonovichHAMSecondMoment HomogHypothesis VariationalDilation
  VariationalRate

/-- Consumer of the wrappers: under the section's hypotheses every
`Ψ ∈ C_pos` has `I_Ψ > 0`, and under `S1Bdd` the coefficient-two supremum is
`2^{(4-α)/(3-α)}` times the positive coefficient-one supremum. -/
theorem audit_consumer {d : ℕ} {alpha alpha0 : ℝ} {Γ μ : Measure (Rd d)}
    (hH : HomogCovariance d alpha alpha0 Γ μ) (hΓ0 : Γ ≠ 0) {Ψ : ℝ × Rd d → ℝ}
    (hΨ : Ψ ∈ CPos d) (hB : S1Bdd alpha0 Γ) :
    0 < integratedRate alpha0 Γ Ψ ∧
      sSup (scoreSet alpha0 Γ 2) = 2 ^ ((4 - alpha) / (3 - alpha)) *
        S1pos alpha0 Γ := by
  obtain ⟨ε, -, -, hε, -, -, -, -, -, -, -, -, hI, -⟩ :=
    variational_unmasked_rate_paper hH hΓ0 hΨ
  exact ⟨(Real.sqrt_pos.mpr hε).trans_le hI,
    ((variational_positive_scores_sSup_paper hH hΓ0 hB).2 2 two_pos).2.2.2⟩

end StratonovichHAMSecondMoment.Audit.VariationalRate
