namespace StratonovichHAMSecondMoment.Audit.EndpointLemmas

open MeasureTheory StratonovichHAMSecondMoment.EndpointLemmas
open StratonovichHAMSecondMoment.HomogHypothesis (Rd)

/-- Consumer: with the supplied input, the product target of `L:product-endpoints` and every
invertible linear image of it satisfy `H:three-endpoints` (`L:endpoint-closure`). -/
theorem audit_consumer (hPD : RieszProductPD) {a : Fin 3 → ℝ} {θ c : ℝ}
    (ha0 : ∀ j, 0 ≤ a j) (ha1 : ∀ j, a j < 1) (hα1 : 1 < ∑ j, a j) (hα2 : ∑ j, a j < 2)
    (hθ0 : 0 < θ) (hθ : θ < 2 - ∑ j, a j) (hc : 0 < c) (T : Rd 3 ≃L[ℝ] Rd 3) :
    ThreeEndpoints θ (chi (∑ j, a j) θ) (prodRieszMeasure c a) ∧
      ThreeEndpoints θ (chi (∑ j, a j) θ) ((prodRieszMeasure c a).map T) := by
  obtain ⟨-, hcov, -, hpair⟩ := product_endpoints_paper hPD ha0 ha1 hα1 hα2 hθ0 hθ hc
  have h1 : θ ≤ 1 := by linarith
  exact ⟨⟨_, _, hpair⟩, ⟨_, _, (endpoint_closure_map hθ0.le h1 hcov.1.1 hpair T).1⟩⟩

#check @audit_consumer
#print axioms audit_consumer

end StratonovichHAMSecondMoment.Audit.EndpointLemmas
