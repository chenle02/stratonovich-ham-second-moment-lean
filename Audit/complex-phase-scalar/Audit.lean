set_option pp.all false

namespace StratonovichHAMSecondMoment.Audit.ComplexPhaseScalar

open StratonovichHAMSecondMoment.ComplexPhaseScalar StratonovichHAMSecondMoment.StaticPhaseCauchy

/-- Consumer of the wrapper: under the hypotheses of `L:complex-phase`, every
point of the numerical range of `A_0 - zB` has `|Im r| ≤ λ` for each square
root `r`, and `|C_h| ≤ e^{λh}` there. -/
private theorem audit_consumer {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H] (A0 B : H →L[ℂ] H) (hA0 : A0.IsPositive) (hB : IsSelfAdjoint B)
    {a d : ℝ} (ha0 : 0 < a) (ha1 : a < 1) (hd : 0 < d)
    (hsand : ∀ ρ > 0, ‖invSqrtShift A0 ρ * B * invSqrtShift A0 ρ‖ ≤ d * ρ ^ (a - 2))
    {lam : ℝ} (hlam : 0 < lam) {z : ℂ} (hz : ‖z‖ ≤ deltaA a * lam ^ (2 - a) / d)
    {h : ℝ} (hh : 0 ≤ h) (w : ℂ) (hw : w ∈ numRange (A0 - z • B)) :
    (∀ r : ℂ, r ^ 2 = w → |r.im| ≤ lam) ∧ ‖phaseC h w‖ ≤ Real.exp (lam * h) :=
  let hR := complex_phase_range_paper A0 B hA0 hB ha0 ha1 hd hsand hlam hz hh w hw
  ⟨hR.2.2.2.2.1, hR.2.2.2.2.2.1⟩

#check @audit_consumer
#print axioms audit_consumer

example : phaseG 3 0 = 3 := by simp [phaseG]

end StratonovichHAMSecondMoment.Audit.ComplexPhaseScalar
