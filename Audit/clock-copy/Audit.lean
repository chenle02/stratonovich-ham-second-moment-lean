open MeasureTheory in
/-- Consumer: no member of the clock-copying family reproduces the cross-pair
transform, `J_{Γ,ρ}(θ) < K_Γ(θ)` for every `-1 ≤ ρ ≤ 1`. -/
private theorem clock_copy_consumer {d : ℕ} {alpha alpha0 : ℝ}
    {Γ μ : Measure (StratonovichHAMSecondMoment.HomogHypothesis.Rd d)}
    (h : StratonovichHAMSecondMoment.HomogHypothesis.HomogCovariance d alpha alpha0 Γ μ)
    (hI : StratonovichHAMSecondMoment.SpectralHomog.SpectralHomogeneous μ alpha)
    (hΓ : Γ ≠ 0) (θ : ℝ) (hθ : 0 < θ) (ρ : ℝ) (hρ : -1 ≤ ρ ∧ ρ ≤ 1) :
    StratonovichHAMSecondMoment.ClockCopy.J alpha0 θ μ ρ <
      StratonovichHAMSecondMoment.DampedNorms.N2sq alpha0 θ μ := by
  obtain ⟨-, -, -, -, -, -, -, hle, -, -, hlt, -⟩ :=
    StratonovichHAMSecondMoment.ClockCopy.clock_copy_obstruction_paper h hI hΓ θ hθ ρ hρ
  exact lt_of_le_of_lt hle hlt
#check @clock_copy_consumer
#print axioms clock_copy_consumer
/- Example: `N₂(θ)² ≥ 0` at the degenerate zero witness of `HomogCovariance`
(`Γ ≠ 0` is not needed for this part). -/
open MeasureTheory in
example : 0 ≤ StratonovichHAMSecondMoment.DampedNorms.N2sq (d := 1) (1 / 2) 1 0 :=
  StratonovichHAMSecondMoment.ClockCopy.damped_N2_nonneg_paper (alpha := 1 / 2) (Γ := 0)
    { dim := Or.inl rfl
      alpha0_pos := by norm_num
      alpha0_lt_one := by norm_num
      Γ_radon := inferInstance
      Γ_even := by simp [StratonovichHAMSecondMoment.HomogHypothesis.IsEven]
      Γ_tempered := ⟨0, by simp⟩
      Γ_posdef := fun _ => by simp
      μ_radon := inferInstance
      μ_even := by simp [StratonovichHAMSecondMoment.HomogHypothesis.IsEven]
      μ_tempered := ⟨0, by simp⟩
      spectral := fun _ => by simp
      scaling := fun _ _ _ _ => by simp
      threshold := by norm_num
      alpha_range := Or.inl ⟨by norm_num, by norm_num⟩ }
    (fun _ _ _ _ => by simp) 1 one_pos
example : StratonovichHAMSecondMoment.ClockCopy.vRho 1 2 5 = 3 := by
  rw [StratonovichHAMSecondMoment.ClockCopy.vRho_one]; norm_num
