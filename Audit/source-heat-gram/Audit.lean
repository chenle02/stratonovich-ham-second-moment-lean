/-- Consumer of the heat wrapper: under `H:homog` and `Γ ≠ 0`, for `ε > 0` and a real test
`f`, `‖ι(p_ε * f)‖ ≤ ‖ι f‖`. -/
private theorem audit_consumer {d : ℕ} {alpha alpha0 : ℝ} {Γ μ : Measure (HomogHypothesis.Rd d)}
    (hH : HomogHypothesis.HomogCovariance d alpha alpha0 Γ μ) (hΓ0 : Γ ≠ 0) {ε : ℝ}
    (hε : 0 < ε) {f : HomogHypothesis.Rd d → ℝ} (hf : WeakSobolev.IsTestFunction f) :
    ‖vec μ (heatConv ε f)‖ ≤ ‖vec μ f‖ := by
  obtain ⟨-, -, -, -, h4, -⟩ := source_spatial_heat_paper hH hΓ0
  obtain ⟨-, -, hn, -, hv⟩ := h4 ε hε
  rw [← hv f hf]
  calc ‖(heatH Γ μ ε ⟨vec μ f, vec_mem_HGamma μ hf⟩ : Lp ℂ 2 μ)‖
      = ‖heatH Γ μ ε ⟨vec μ f, vec_mem_HGamma μ hf⟩‖ := rfl
    _ ≤ ‖heatH Γ μ ε‖ * ‖(⟨vec μ f, vec_mem_HGamma μ hf⟩ : HGamma μ)‖ :=
        ContinuousLinearMap.le_opNorm _ _
    _ ≤ 1 * ‖(⟨vec μ f, vec_mem_HGamma μ hf⟩ : HGamma μ)‖ :=
        mul_le_mul_of_nonneg_right hn (norm_nonneg _)
    _ = ‖vec μ f‖ := one_mul _

#check @audit_consumer
#print axioms audit_consumer

/-- Consumer of the Gram wrapper: the factored diagonal entries
`⟨h_i,h_i⟩_{H_t} B_Γ(f_i², f_i²)` are nonnegative. -/
private theorem audit_consumer_gram {d : ℕ} {alpha alpha0 : ℝ}
    {Γ μ : Measure (HomogHypothesis.Rd d)}
    (hH : HomogHypothesis.HomogCovariance d alpha alpha0 Γ μ) (hΓ0 : Γ ≠ 0)
    {ι : Type*} [Fintype ι] (A : ι → Set ℝ) (hA : ∀ i, MeasurableSet (A i))
    (hAI : ∀ i, A i ⊆ Set.Ioo 0 1) (hdisj : Pairwise (Function.onFun Disjoint A))
    (hne : ∀ i, (A i).Nonempty) (hpos : ∀ i, 0 < volume.real (A i))
    (hsum : ∑ i, volume.real (A i) = 1)
    (f : ι → HomogHypothesis.Rd d → ℝ) (hf : ∀ i, WeakSobolev.IsTestFunction (f i))
    (hf2 : ∀ i, ∫ x, f i x ^ 2 = 1) (η : HomogHypothesis.Rd d → ℝ)
    (hη : ContDiff ℝ (⊤ : ℕ∞) η) (hη01 : ∀ x, 0 ≤ η x ∧ η x ≤ 1)
    (hη1 : ∀ x, ‖x‖ ≤ 1 → η x = 1) (hη2 : ∀ x, 2 < ‖x‖ → η x = 0) (i : ι) :
    0 ≤ tPair alpha0 (A i) (A i) * SpatialFourierBound.spatialPair Γ (fun x => f i x ^ 2)
      (fun x => f i x ^ 2) := by
  obtain ⟨-, h2, -, -⟩ := positive_physical_gram_paper hH hΓ0 A hA hAI hdisj hne hpos hsum f
    hf hf2 η hη hη01 hη1 hη2 (R := 1) le_rfl
  rw [← h2 i i]
  exact real_inner_self_nonneg

#check @audit_consumer_gram
#print axioms audit_consumer_gram

/-- Consumer of the wave-L14 integration: `H_I` of this module is the completion
`OccupationCompletion.HK` of item K1a, and its kernel form is K1a's `kform`. -/
private theorem audit_unified (p : KernParams) {G : Type*} [NormedAddCommGroup G]
    [InnerProductSpace ℝ G] [CompleteSpace G] (F H : Lp G 2 SpaceTimePositivity.timeMeasure) :
    HI p G = OccupationCompletion.HK p G ∧
      inner ℝ (JI p G F) (JI p G H) = OccupationCompletion.kform p.a ⇑F ⇑H ∧
      JI p G F = OccupationCompletion.J p G F :=
  ⟨rfl, inner_JI F H, rfl⟩

#check @audit_unified
#print axioms audit_unified

end StratonovichHAMSecondMoment.Audit.SourceHeatGram

