open MeasureTheory StratonovichHAMSecondMoment

namespace StratonovichHAMSecondMoment.Audit.SpatialSmoothRatio

open StratonovichHAMSecondMoment.SpatialSmoothRatio

/-- Consumer of the wrappers: under `H:homog` and `Γ ≠ 0`, `R_0` is a positive
real number bounded by `2^{1+α} R_Γ(1)`, and with the static-control input
every unit test's smooth score bound is approached by controls. -/
private theorem audit_consumer {d : ℕ} {alpha alpha0 : ℝ} {Γ μ : Measure (HomogHypothesis.Rd d)}
    (h : HomogHypothesis.HomogCovariance d alpha alpha0 Γ μ) (hΓ : Γ ≠ 0)
    (hSC : StaticControls alpha0 Γ) {g : HomogHypothesis.Rd d → ℝ}
    (hg : SpatialFourierBound.IsUnitTest g) :
    0 < R0 Γ alpha ∧ R0 Γ alpha ≤ 2 ^ (1 + alpha) * SpectralHomog.resolvent μ 1 ∧
      ∃ Ψ ∈ VariationalDilation.CPos d,
        smoothScoreBound alpha alpha0 (ratio Γ alpha g) - 1 <
          VariationalDilation.integratedRate alpha0 Γ Ψ -
            VariationalDilation.rawCost alpha0 Γ Ψ / 2 :=
  ⟨(spatial_smooth_ratio_paper h hΓ hSC).1.2.2.1, (spatial_smooth_ratio_paper h hΓ hSC).1.2.2.2.1,
    (spatial_smooth_ratio_paper h hΓ hSC).2 g hg _ (by linarith)⟩

#check @audit_consumer
#print axioms audit_consumer

end StratonovichHAMSecondMoment.Audit.SpatialSmoothRatio
