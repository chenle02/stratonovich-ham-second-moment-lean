namespace StratonovichHAMSecondMoment.Audit.ClassOBridge

open StratonovichHAMSecondMoment StratonovichHAMSecondMoment.ClassOBridge
open StratonovichHAMSecondMoment.ClassOH1 MeasureTheory
open StratonovichHAMSecondMoment.HomogHypothesis (Rd HomogCovariance)

set_option pp.all false in
/-- Consumer: under the manuscript's hypotheses (`H:homog` with `a = α₀`, `Γ ≠ 0`,
`D = q - 2a`), the four-linear pairing is continuous on `(H¹)⁴`, every field of the class `𝒪`
has `0 ≤ J(g) ≤ R_⋆ R_sp T(g)^{α/2}`, and the occupation energies over `𝒪` equal the
joint-representative values. -/
theorem audit_consumer {d : ℕ} {alpha a : ℝ} {Γ μ : Measure (Rd d)}
    (hH : HomogCovariance d alpha a Γ μ) (hΓ : Γ ≠ 0) :
    Continuous (fun x : H1R d × H1R d × H1R d × H1R d =>
      SpatialFourLinear.C4 Γ (fn x.1) (fn x.2.1) (fn x.2.2.1) (fn x.2.2.2)) ∧
    (∀ u : ℝ → H1R d, IsClassO u →
      0 ≤ OccupationPhysicalClass.J a ((4 - alpha) - 2 * a) Γ (gO u) ∧
      OccupationPhysicalClass.J a ((4 - alpha) - 2 * a) Γ (gO u) ≤
        OccupationKernelRow.Rstar a ((4 - alpha) - 2 * a) * SpatialFourLinear.Rsp Γ alpha *
          OccupationPhysicalClass.T (dgO u) ^ (alpha / 2)) ∧
    0 < EstarClassO a ((4 - alpha) - 2 * a) Γ ∧
    CoccO a alpha Γ = RawOccupationEnergy.Cocc a alpha Γ := by
  have := hH.Γ_radon
  obtain ⟨-, -, -, -, -, -, -, hC, -⟩ := spatial_four_linear_whole_paper hH hΓ
  obtain ⟨hall, -, -, hpos, -⟩ := occupation_physical_class_whole_paper hH hΓ _ rfl
  refine ⟨hC, fun u hu => ?_, hpos, CoccO_eq a alpha Γ⟩
  obtain ⟨-, -, -, -, -, -, -, h0, hle⟩ := hall u hu
  exact ⟨h0, hle⟩

#check @audit_consumer
#print axioms audit_consumer

end StratonovichHAMSecondMoment.Audit.ClassOBridge
