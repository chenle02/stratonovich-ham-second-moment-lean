open MeasureTheory StratonovichHAMSecondMoment

namespace StratonovichHAMSecondMoment.Audit.WaveGreenFourier

open StratonovichHAMSecondMoment.WaveGreenFourier

/-- Consumer of the wrapper: the `d = 3` wave Green measure at `h = 2` has
Fourier transform `sin(2|ξ|)/|ξ|` at `ξ ≠ 0`, and mass `2`. -/
private theorem audit_consumer (ξ : HomogHypothesis.Rd 3) (hξ : ξ ≠ 0) :
    ∫ x, Complex.exp (Complex.I * ((inner ℝ ξ x : ℝ) : ℂ)) ∂(WaveGreen.waveGreen 3 2) =
        ((Real.sin (2 * ‖ξ‖) / ‖ξ‖ : ℝ) : ℂ) ∧
      WaveGreen.waveGreen 3 2 Set.univ = ENNReal.ofReal 2 := by
  obtain ⟨-, h2, h3⟩ := waveGreen_fourier_paper 3 (Or.inr (Or.inr rfl)) 2 two_pos ξ
  exact ⟨by rw [h2]; simp [hξ], h3⟩

/-- Consumer of Archimedes' law (Bochner form) with the constant `1`. -/
private theorem audit_archimedes (e : HomogHypothesis.Rd 3) (he : ‖e‖ = 1) :
    ∫ _ω : Metric.sphere (0 : HomogHypothesis.Rd 3) 1, (1 : ℝ)
        ∂(volume : Measure (HomogHypothesis.Rd 3)).toSphere =
      (2 * Real.pi) • ∫ _t in Set.Icc (-1 : ℝ) 1, (1 : ℝ) :=
  (integral_sphere_inner e he (fun _ => (1 : ℝ)) continuous_const.integrableOn_Icc).2

end StratonovichHAMSecondMoment.Audit.WaveGreenFourier
