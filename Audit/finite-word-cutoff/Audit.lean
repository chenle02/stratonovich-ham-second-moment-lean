namespace StratonovichHAMSecondMoment.Audit.FiniteWordCutoff

open StratonovichHAMSecondMoment.FiniteWordCutoff StratonovichHAMSecondMoment.FixedSplit
open StratonovichHAMSecondMoment.FixedSplitCore StratonovichHAMSecondMoment.IntervalScalar
open Finset MeasureTheory

/-- Consumer: for one degree split and one split `p = (r, q)`, the Duhamel word
expansion and the supplied inputs of `L:fixed-split` bound the real part of the
uncut inner product `⟨U_r v, U_q v⟩_{1/T}` (the `Q_{r,q}` of
`P:interval-coefficients`) by the fixed-split bound, with no hypothesis on `Q`. -/
private theorem audit_consumer {d : ℕ} {alpha alpha0 : ℝ} {Γ μ : Measure (HomogHypothesis.Rd d)}
    (hH : HomogHypothesis.HomogCovariance d alpha alpha0 Γ μ)
    {ι : Type} [Fintype ι] [DecidableEq ι] {X : Type} [NormedAddCommGroup X]
    [InnerProductSpace ℂ X] [CompleteSpace X] {β α Ω : Type} [MeasurableSpace Ω] {m : ℕ}
    (col : Fin m → ι) (κ : ι → ℕ) (p : ι → ℕ × ℕ) (S : ℝ → X →L[ℂ] X)
    (Mlt : Fin m → X →L[ℂ] X) (Pb : X →L[ℂ] X)
    (P : (ι → ℂ) → ℝ → ℝ → PhaseSp X col (fun i => 2 * κ i) →
      PhaseSp X col (fun i => 2 * κ i))
    (cf : (ι → ℕ) → PhaseSp X col (fun i => 2 * κ i)) (U : (ι → ℕ) → FullPhase X m)
    (u w : X) (a b h σ : ι → ℝ) {δ R T V : ℝ} {k : ℕ}
    (Fr : β → X × X →L[ℂ] X × X) (A₁ A₂ : Finset α) (ν₁ ν₂ : α → Measure Ω)
    (ω₁ ω₂ : α → Ω → β × List (ι × β))
    (hRdef : R = alpha * Real.pi * (μ (Metric.ball 0 1)).toReal /
      (2 * Real.sin (Real.pi * alpha / 2)))
    (hRpos : 0 < R) (hT : 0 < T) (hk : 1 ≤ k) (hsum : ∑ i, κ i = k)
    (hp : ∀ i, (p i).1 + (p i).2 = 2 * κ i) (hδ : 0 < δ) (hσ : ∀ i, 0 < σ i) (hh : ∀ i, 0 < h i)
    (hlen : ∀ i, b i - a i ≤ h i) (habC : ∀ i ∈ crossSet κ p, 0 ≤ a i ∧ b i ≤ T)
    (hSs : ∀ ρ u w, inner ℂ (S ρ u) w = inner ℂ u (S ρ w))
    (hSn : ∀ ρ : ℝ, 0 < ρ → ∀ f, ‖S ρ f‖ ≤ ρ⁻¹ * ‖f‖)
    (hScmp : ∀ ρ ρ' : ℝ, 0 < ρ → 0 < ρ' → ∀ g, ‖S ρ' g‖ ≤ max 1 (ρ / ρ') * ‖S ρ g‖)
    (hM : ∀ j u w, inner ℂ (Mlt j u) w = inner ℂ u (Mlt j w))
    (hPs : ∀ u w, inner ℂ (Pb u) w = inner ℂ u (Pb w)) (hPP : ∀ u, Pb (Pb u) = Pb u)
    (hPS : ∀ ρ u, Pb (S ρ u) = S ρ (Pb u))
    (hcol : ∀ i (ρ : ℝ), 0 < ρ →
      FockForm.FockColumn (fun j => S ρ ∘L colorMask col i Mlt j) (R * ρ ^ (alpha - 2)))
    (hV : ‖u‖ ^ 2 + ‖S (1 / T) w‖ ^ 2 ≤ V)
    (hD₁ : DuhamelWords col (fun i => 2 * κ i) σ (fun j => Pb ∘L Mlt j ∘L Pb) Fr u w A₁ ν₁ ω₁
      (fun i => (p i).1) (U fun i => (p i).1) (cf fun i => (p i).1))
    (hD₂ : DuhamelWords col (fun i => 2 * κ i) σ (fun j => Pb ∘L Mlt j ∘L Pb) Fr u w A₂ ν₂ ω₂
      (fun i => (p i).2) (U fun i => (p i).2) (cf fun i => (p i).2))
    (hin : SplitInputs col κ p S Mlt Pb P cf u w a b h σ alpha δ R T k) :
    |(fullInner S (1 / T) (U fun i => (p i).1) (U fun i => (p i).2)).re| ≤
      (k : ℝ) ^ 2 * splitConst δ ^ k * R ^ k * V *
        ∏ i, splitFactor alpha (σ i) (h i) ((k : ℝ) / T) (κ i) (p i) := by
  rw [Q_identification col (fun i => 2 * κ i) σ _ Fr u w S (1 / T) A₁ A₂ ν₁ ν₂ ω₁ ω₂
    (fun i => (p i).1) (fun i => (p i).2) U cf hD₁ hD₂ (fun i => by have := hp i; omega)
    (fun i => by have := hp i; omega)]
  exact (Complex.abs_re_le_norm _).trans (fixed_split_paper hH col κ p S Mlt Pb P cf u w a b h σ
    hRdef hRpos hT hk hsum hp hδ hσ hh hlen habC hSs hSn hScmp hM hPs hPP hPS hcol hV hin)

#check @audit_consumer
#print axioms audit_consumer

end StratonovichHAMSecondMoment.Audit.FiniteWordCutoff
