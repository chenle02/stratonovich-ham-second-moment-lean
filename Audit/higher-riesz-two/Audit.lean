open MeasureTheory StratonovichHAMSecondMoment

namespace StratonovichHAMSecondMoment.Audit.HigherRieszTwo

open StratonovichHAMSecondMoment.HigherRieszTwo

/-- Consumer of the wrapper: under the manuscript's hypotheses of
`L:higher-riesz` in `d = 2`, the real-valued pairing of `E:higher-convolution`
is integrable and bounded by `M_2 h^{-(α-1)}`. -/
private theorem audit_consumer {c α α₀ : ℝ} {μ : Measure (HomogHypothesis.Rd 2)}
    (hH : HomogHypothesis.HomogCovariance 2 α α₀ (volume.withDensity (riesz c α)) μ)
    (hc : 0 < c) (hα1 : 1 < α) (hα : α < 3 / 2) {h ε η : ℝ} (hh : 0 < h) (hε : 0 < ε)
    (hη : 0 ≤ η) (z : HomogHypothesis.Rd 2) :
    ∫ y, (smoothCov (riesz c α) ε (y + z)).toReal ∂(smoothGreen (WaveGreen.waveGreen 2 h) η)
      ≤ M2 c α * h ^ (-(α - 1)) :=
  ((higher_riesz_two_paper hH hc hα1 hα).real_form (measurable_riesz c α) hh z hε hη).2.2

#check @audit_consumer
#print axioms audit_consumer

end StratonovichHAMSecondMoment.Audit.HigherRieszTwo
