/-- Consumer of the wrapper: along exact flows (`D_m = P_{σ_m}`, deviation `0`)
on any `ω`-adjacent chain, the observable of the product is positive. -/
theorem consumer_exact_flow_positive {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F]
    {d : ℕ} {alpha alpha0 : ℝ} {Γ μ : MeasureTheory.Measure (HomogHypothesis.Rd d)}
    (hH : HomogHypothesis.HomogCovariance d alpha alpha0 Γ μ) (hΓ : Γ ≠ 0)
    (G : GroundFamily F) :
    ∃ B : ℕ, 1 ≤ B ∧ ∃ ω : ℝ, 0 < ω ∧
      ∀ N : ℕ, 1 ≤ N → ∀ σ : ℕ → ℝ, (∀ m ≤ N, σ m ∈ paramI) →
        (∀ m < N, |σ (m + 1) - σ m| ≤ ω) → ∀ u ∈ Icc (0 : ℝ) B,
          0 < G.obs (G.P (σ N) u (chainState (fun m t => G.P (σ m) t) B G.e0 N)) := by
  obtain ⟨B, hB, ω, hω, ε, hε, c, _, _, hall⟩ :=
    indexed_cone_paper hH hΓ G (ϱ := 1 / 4) (by norm_num) (by norm_num)
  refine ⟨B, hB, ω, hω, fun N hN σ hσ hadj u hu => ?_⟩
  obtain ⟨h1, h2⟩ := hall N hN σ hσ hadj (fun m t => G.P (σ m) t)
    (fun _ _ _ _ => by simp [hε.le]) u hu
  exact lt_of_lt_of_le h2 h1

