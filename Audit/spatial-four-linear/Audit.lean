open MeasureTheory Filter Topology

namespace StratonovichHAMSecondMoment.Audit.SpatialFourLinear

open StratonovichHAMSecondMoment.HomogHypothesis (Rd)

/-- Consumer of the wrapper: under `H:homog`, `Γ ≠ 0` and the density input, every real `H¹`
profile has finite `A_sp`, and `R_sp = R_0`. -/
private theorem audit_consumer {d : ℕ} {alpha alpha0 : ℝ} {Γ μ : Measure (Rd d)}
    (hH : HomogHypothesis.HomogCovariance d alpha alpha0 Γ μ) (hΓ : Γ ≠ 0)
    (hdense : ∀ (f : Rd d → ℝ) (g : Rd d → Rd d), MemLp f 2 volume → MemLp g 2 volume →
        WeakSobolev.HasWeakGradient f g →
        ∃ φ : ℕ → Rd d → ℝ, (∀ n, WeakSobolev.IsTestFunction (φ n)) ∧
          Tendsto (fun n => eLpNorm (fun x => φ n x - f x) 2 volume) atTop (𝓝 0) ∧
          Tendsto (fun n => eLpNorm (fun x => VariationalFloor.grad (φ n) x - g x) 2 volume)
            atTop (𝓝 0))
    {f : Rd d → ℝ} {g : Rd d → Rd d}
    (hfg : SpatialFourLinear.IsH1Pair f g) :
    OccupationKernelRow.pairing Γ (SpatialStaticControls.zE fun x => f x ^ 2)
        (SpatialStaticControls.zE fun x => f x ^ 2) < ⊤ ∧
      SpatialFourLinear.Rsp Γ alpha = SpatialSmoothRatio.R0 Γ alpha :=
  ⟨((SpatialFourLinear.spatial_four_linear_paper hH hΓ hdense).1 f g hfg).trans_lt
    ENNReal.ofReal_lt_top, (SpatialFourLinear.spatial_four_linear_paper hH hΓ hdense).2.2.2.2.1⟩

#check @audit_consumer
#print axioms audit_consumer

end StratonovichHAMSecondMoment.Audit.SpatialFourLinear
