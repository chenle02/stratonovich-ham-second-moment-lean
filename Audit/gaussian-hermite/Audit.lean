open MeasureTheory ProbabilityTheory StratonovichHAMSecondMoment

namespace StratonovichHAMSecondMoment.Audit.GaussianHermite

open StratonovichHAMSecondMoment.GaussianHermite

/-- Consumer: distinct multi-index Hermite functions are orthogonal and each has
unit norm under `stdPi m`. -/
private theorem audit_consumer {m : ℕ} (k l : Fin m → ℕ) (h : k ≠ l) :
    ∫ x, hk k x * hk l x ∂GaussianIBP.stdPi m = 0 ∧
      ∫ x, hk k x * hk k x ∂GaussianIBP.stdPi m = 1 := by
  rw [integral_hk_mul_hk, integral_hk_mul_hk]; simp [h]

#check @audit_consumer
#print axioms audit_consumer

end StratonovichHAMSecondMoment.Audit.GaussianHermite
