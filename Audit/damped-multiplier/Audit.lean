set_option pp.all false

open MeasureTheory StratonovichHAMSecondMoment

namespace StratonovichHAMSecondMoment.Audit.DampedMultiplier

open StratonovichHAMSecondMoment.DampedMultiplier StratonovichHAMSecondMoment.DampedNormsHomog

/-- Consumer of the wrapper: under `H:homog`, for `θ > 0` and `v ≥ 0` the
Gaussian-multiplied second norm over the full Laplace domain lies between `0`
and `N₂(θ)²`-with-kernel-`K_{(0,∞)}`, and Gaussian smoothing of the wave Green
measures leaves `N₀(θ) = θ^{-2}`. -/
private theorem audit_consumer {d : ℕ} {alpha alpha0 : ℝ}
    {Γ μ : Measure (HomogHypothesis.Rd d)}
    (h : HomogHypothesis.HomogCovariance d alpha alpha0 Γ μ) (v θ : ℝ) (hv : 0 ≤ v)
    (hθ : 0 < θ) :
    0 ≤ N2onSq alpha0 θ Set.univ (smoothed μ (gaussMult v)) ∧
      N2onSq alpha0 θ Set.univ (smoothed μ (gaussMult v)) ≤ N2onSq alpha0 θ Set.univ μ ∧
      N0 (fun s => gaussKernel v ∗ WaveGreen.waveGreen d s) θ = θ ^ (-(2 : ℝ)) := by
  obtain ⟨-, -, -, -, -, h6, h7, -, h9⟩ := damped_homogeneous_norms_full_wave h
  obtain ⟨-, -, -, -, -, hlo, hup⟩ := h6 θ hθ _ (h7 v hv) Set.univ Set.univ
    MeasurableSet.univ MeasurableSet.univ le_rfl
  exact ⟨hlo, hup, ((h9 v hv).2.1 θ hθ).2.2⟩

#check @audit_consumer
#print axioms audit_consumer

end StratonovichHAMSecondMoment.Audit.DampedMultiplier
