namespace StratonovichHAMSecondMoment.Audit.H1Mathlib

open StratonovichHAMSecondMoment.H1Mathlib StratonovichHAMSecondMoment.WeakSobolev
open MeasureTheory TemperedDistribution
open HomogHypothesis (Rd)
open scoped Real

set_option pp.all false in
/-- Consumer: from the manuscript's hypotheses, the Mathlib-norm identity, the manuscript
norm bound and membership in Mathlib's `H^{1,2}` together. -/
theorem audit_consumer {d : ℕ} {f : Rd d → ℝ} {g : Rd d → Rd d} (hf : MemLp f 2 volume)
    (hg : MemLp g 2 volume) (hw : HasWeakGradient f g) :
    ∃ h : MemH1 f, MemSobolev 1 2 (toDistr hf) ∧
      ‖toH1 h‖ ^ 2 = (∫ x, f x ^ 2) + ((2 * π) ^ 2)⁻¹ * ∫ x, ‖g x‖ ^ 2 ∧
      manuscriptH1NormSq f g ≤ (2 * π) ^ 2 * ‖toH1 h‖ ^ 2 := by
  have h : MemH1 f := ⟨hf, g, hg, hw⟩
  obtain ⟨hiff, hrest⟩ := h1_identification_paper hf
  obtain ⟨e, -, hle⟩ := (hrest h).1 g hg hw
  exact ⟨h, hiff.mp h, e, hle⟩

#check @audit_consumer
#print axioms audit_consumer

end StratonovichHAMSecondMoment.Audit.H1Mathlib
