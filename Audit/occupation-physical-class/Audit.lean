open MeasureTheory StratonovichHAMSecondMoment

namespace StratonovichHAMSecondMoment.Audit.OccupationPhysicalClass

open StratonovichHAMSecondMoment.OccupationPhysicalClass

/-- Consumer of the wrapper: under `H:homog`, `Γ ≠ 0`, `D = (4 - α) - 2a` and the supplied
bounds of `P:spatial-four-linear` at `R_0`, every field of `𝒪` has `J(g) - T(g)/2 ≤ 𝓔_⋆^𝒪`,
and `𝓔_⋆^𝒪` is a positive real number below the explicit bound. -/
private theorem audit_consumer {d : ℕ} {alpha a : ℝ} {Γ μ : Measure (HomogHypothesis.Rd d)}
    (hH : HomogHypothesis.HomogCovariance d alpha a Γ μ) (hΓ : Γ ≠ 0) (D : ℝ)
    (hD : D = (4 - alpha) - 2 * a)
    (hB : SquarePairingBounds Γ alpha (SpatialSmoothRatio.R0 Γ alpha))
    {G : ℝ → HomogHypothesis.Rd d → ℝ} {DG : ℝ → HomogHypothesis.Rd d → HomogHypothesis.Rd d}
    (hO : IsOccField G DG) :
    J a D Γ G - T DG / 2 ≤ EstarO a D Γ ∧ 0 < EstarO a D Γ ∧
      EstarO a D Γ ≤ OccupationKernelRow.Rstar a D ^ (2 / (2 - alpha)) *
        spEnergyVal alpha (SpatialSmoothRatio.R0 Γ alpha) := by
  obtain ⟨-, -, hbdd, hpos, hle⟩ := occupation_physical_class_paper hH hΓ D hD hB
  exact ⟨le_csSup hbdd ⟨G, DG, hO, rfl⟩, hpos, hle⟩

#check @audit_consumer
#print axioms audit_consumer

example : spEnergyVal 1 1 = 1 / 2 := by unfold spEnergyVal; norm_num

end StratonovichHAMSecondMoment.Audit.OccupationPhysicalClass
