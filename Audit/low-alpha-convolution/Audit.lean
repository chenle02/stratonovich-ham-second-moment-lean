open MeasureTheory StratonovichHAMSecondMoment

namespace StratonovichHAMSecondMoment.Audit.LowAlphaConvolution

open StratonovichHAMSecondMoment.LowAlphaConvolution

/-- Consumer of the wrapper: under `H:homog` in `d = 1` with `α < 1`, the
smoothed pairing is bounded by `V h^{1-α}/(1-α)` uniformly in `ε`, `η`, `z`,
and that bound is finite and nonnegative. -/
private theorem audit_consumer {alpha alpha0 : ℝ} {Γ μ : Measure (HomogHypothesis.Rd 1)}
    (h : HomogHypothesis.HomogCovariance 1 alpha alpha0 Γ μ) (ha1 : alpha < 1)
    (z : HomogHypothesis.Rd 1) :
    |∫ y, gammaEps Γ 1 (y + z) ∂(smoothedGreen (WaveGreen.waveGreen 1) 1 0)| ≤
      (specV μ).toReal / (1 - alpha) := by
  obtain ⟨-, -, -, -, -, H⟩ := low_alpha_convolution_one h ha1
  obtain ⟨-, h0, h1⟩ := H 1 one_pos 1 one_pos 0 le_rfl z
  rw [abs_of_nonneg h0]
  simpa using h1

#check @audit_consumer
#print axioms audit_consumer

end StratonovichHAMSecondMoment.Audit.LowAlphaConvolution
