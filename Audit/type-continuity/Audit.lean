open MeasureTheory Filter Topology Set StratonovichHAMSecondMoment

namespace StratonovichHAMSecondMoment.Audit.TypeContinuity

open StratonovichHAMSecondMoment.TypeContinuity

/-- Consumer of the two wrappers: under `H:homog`, `Γ ≠ 0` and the named
inputs, `log Λ̄_2` is convex on `[0, a_max)`, and `Λ̄_2(a) → 2^{κ_st} L_0`
as `a ↓ 0`. -/
private theorem audit_consumer {d : ℕ} {alpha alpha0 : ℝ}
    {Γ μ : Measure (HomogHypothesis.Rd d)}
    (h : HomogHypothesis.HomogCovariance d alpha alpha0 Γ μ) (hΓ : Γ ≠ 0)
    (mom : ℕ → ℝ → ℝ → ℝ) (c : ℕ → ℝ → ℕ → ℝ) (L0 : ℝ)
    (hin : TypeContinuityInputs d alpha mom c L0) :
    ConvexOn ℝ (Ico 0 (amaxOf alpha))
        (fun a => Real.log (growthUpper (kappaOf alpha a) (mom 2 a)).toReal) ∧
      Tendsto (fun a => growthUpper (kappaOf alpha a) (mom 2 a)) (𝓝[>] 0)
        (𝓝 ((((2 : ℕ) : ℝ) ^ kappaSt alpha * L0 : ℝ) : EReal)) :=
  ⟨(moment_growth_logconvex_paper h hΓ mom c L0 hin 2 (Or.inr rfl)).2.2.1,
    ((static_moment_constant_continuity_paper h hΓ mom c L0 hin).1 2 (Or.inr rfl)).2.2⟩

#check @audit_consumer
#print axioms audit_consumer

end StratonovichHAMSecondMoment.Audit.TypeContinuity
