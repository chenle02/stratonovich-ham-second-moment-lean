namespace StratonovichHAMSecondMoment.Audit.TerminalWickInputs

open StratonovichHAMSecondMoment.FiniteWick StratonovichHAMSecondMoment.TerminalWick
  StratonovichHAMSecondMoment.TerminalWickInputs

/-- Consumer of the constructed wrapper: for a field with nonnegative covariance and the
constructed chain measures `g_n^{T,x}` (no mass input, no measurability of the product or
of `K`), the input
`TerminalWickInput` of `L:uniform-series-tail` holds at `r = 2`, `E[Y_1 Y_2] = 0`, and the
mass of `g_3^{T,x}` is `T^6/6!`. -/
private theorem audit_consumer {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω)
    [IsProbabilityMeasure P] (d : ℕ) (hd : d = 1 ∨ d = 2 ∨ d = 3) (T : ℝ) (hT : 0 < T)
    (x : HomogHypothesis.Rd d) (W : Pt d T → Ω → ℝ) (K : Pt d T → Pt d T → ℝ)
    (hW : CenteredGaussianField W K P)
    (hVfin : BddAbove (Set.range fun p => K p p)) (hcell : MeanSquareCellContinuous K)
    (hpos : ∀ p q, 0 ≤ K p q) :
    UniformSeriesTail.TerminalWickInput P
        (fun n => chainIntegral (fun n => chainMeasure d n T hT.le x) hW n) 2 ∧
      ∫ ω, chainIntegral (fun n => chainMeasure d n T hT.le x) hW 1 ω *
        chainIntegral (fun n => chainMeasure d n T hT.le x) hW 2 ω ∂P = 0 ∧
      chainMeasure d 3 T hT.le x Set.univ = ENNReal.ofReal (T ^ 6 / 720) := by
  have h := terminal_wick_constructed_paper P d hd T hT x W K hW hVfin hcell
  refine ⟨h.2.2.2.2.2.2.2.2 hpos 2, h.2.2.2.2.2.1 1 2 (by decide), ?_⟩
  rw [chainMeasure_univ d hd 3 T hT.le x]
  norm_num [Nat.factorial]

#check @audit_consumer
#print axioms audit_consumer

end StratonovichHAMSecondMoment.Audit.TerminalWickInputs
