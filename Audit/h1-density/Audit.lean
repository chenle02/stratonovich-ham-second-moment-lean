open MeasureTheory Filter Topology

namespace StratonovichHAMSecondMoment.Audit.H1Density

open StratonovichHAMSecondMoment.H1Density

/-- Consumer of the density theorem, used the way a consumer of the
predicate `H1TestDense d` uses it: for `f ∈ H^1(ℝ^d; ℝ)` with `L²` weak
gradient `g` and every `ε > 0` there is one test function within `ε` of `f`
and with gradient within `ε` of `g` in `L²`. -/
private theorem audit_consumer {d : ℕ} {f : HomogHypothesis.Rd d → ℝ}
    {g : HomogHypothesis.Rd d → HomogHypothesis.Rd d} (hf : MemLp f 2 volume)
    (hg : MemLp g 2 volume) (hw : WeakSobolev.HasWeakGradient f g) {ε : ENNReal}
    (hε : 0 < ε) :
    ∃ ψ : HomogHypothesis.Rd d → ℝ, WeakSobolev.IsTestFunction ψ ∧
      eLpNorm (fun x => ψ x - f x) 2 volume < ε ∧
      eLpNorm (fun x => VariationalFloor.grad ψ x - g x) 2 volume < ε := by
  obtain ⟨φ, hφt, h1, h2⟩ := h1TestDense d f g hf hg hw
  obtain ⟨n, hn1, hn2⟩ :=
    ((h1.eventually (gt_mem_nhds hε)).and (h2.eventually (gt_mem_nhds hε))).exists
  exact ⟨φ n, hφt n, hn1, hn2⟩

#check @audit_consumer
#print axioms audit_consumer

/-- The module doc's claim: `mollify (bumpN d n)` is `VariationalFloor.moll`
by definition. -/
example {d : ℕ} (f : HomogHypothesis.Rd d → ℝ) (n : ℕ) :
    mollify (VariationalFloor.bumpN d n) f = VariationalFloor.moll f n := rfl

end StratonovichHAMSecondMoment.Audit.H1Density
