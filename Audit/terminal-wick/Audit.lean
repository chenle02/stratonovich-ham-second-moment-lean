open MeasureTheory StratonovichHAMSecondMoment

namespace StratonovichHAMSecondMoment.Audit.TerminalWick

open StratonovichHAMSecondMoment.FiniteWick StratonovichHAMSecondMoment.TerminalWick

/-- Consumer of the wrapper: for a field with nonnegative covariance, the input
`TerminalWickInput` of `L:uniform-series-tail` holds at `r = 2`, and
`E[Y_1 Y_2] = 0` (odd total order). -/
private theorem audit_consumer {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω)
    [IsProbabilityMeasure P] (d : ℕ) (hd : d = 1 ∨ d = 2 ∨ d = 3) (T : ℝ) (hT : 0 < T)
    (W : Pt d T → Ω → ℝ) (K : Pt d T → Pt d T → ℝ) (hW : CenteredGaussianField W K P)
    (hVfin : BddAbove (Set.range fun p => K p p)) (hcell : MeanSquareCellContinuous K)
    (ν : ∀ n : ℕ, Measure (Fin n → Pt d T)) [∀ n, IsFiniteMeasure (ν n)]
    (hmass : ∀ n, ν n Set.univ = chainMass d n T)
    (hmeas : ∀ n, AEStronglyMeasurable (fun z : Fin n → Pt d T => prodL2 hW z) (ν n))
    (hK : Measurable fun q : Pt d T × Pt d T => K q.1 q.2) (hpos : ∀ p q, 0 ≤ K p q) :
    UniformSeriesTail.TerminalWickInput P (fun n => chainIntegral ν hW n) 2 ∧
      ∫ ω, chainIntegral ν hW 1 ω * chainIntegral ν hW 2 ω ∂P = 0 := by
  have h := terminal_wick_paper P d hd T hT W K hW hVfin hcell ν hmass hmeas hK
  exact ⟨h.2.2.2.2.2.2.2.2 hpos 2, h.2.2.2.2.2.1 1 2 (by decide)⟩

#check @audit_consumer
#print axioms audit_consumer

end StratonovichHAMSecondMoment.Audit.TerminalWick
