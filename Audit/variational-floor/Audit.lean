namespace StratonovichHAMSecondMoment.Audit.VariationalFloor

open MeasureTheory Metric StratonovichHAMSecondMoment HomogHypothesis WeakSobolev
  VariationalDilation VariationalFloor

/-- Consumer of `rayleighSet_floor`: under `H:homog` with `Γ ≠ 0`, every
bounded potential `V ≥ Γ * z` (for a nonzero bump-like `z`) has a positive
Rayleigh supremum, and every centred ball has positive `Γ`-mass. -/
theorem audit_consumer {d : ℕ} {alpha alpha0 : ℝ} {Γ μ : Measure (Rd d)}
    (hH : HomogCovariance d alpha alpha0 Γ μ) (hΓ0 : Γ ≠ 0) {z : Rd d → ℝ}
    (hzc : Continuous z) (hzs : HasCompactSupport z) (hz0 : ∀ x, 0 ≤ z x) (hzne : z ≠ 0)
    (hzi : ∀ x, Integrable (fun y => z (x - y)) Γ) {V : Rd d → ℝ} (hV : ∀ x, conv Γ z x ≤ V x)
    (hVi : ∀ f : Rd d → ℝ, MemLp f 2 volume → Integrable (fun x => V x * f x ^ 2) volume)
    (hb : BddAbove (rayleighSet V)) :
    0 < sSup (rayleighSet V) ∧ 0 < Γ (ball 0 1) := by
  have := hH.Γ_radon
  have hα : alpha < 2 := by linarith [hH.threshold, hH.alpha0_pos]
  exact ⟨(rayleighSet_floor hH.scaling hα hΓ0 hzc hzs hz0 hzne hzi hV hVi).2 hb,
    measure_ball_pos hH.scaling hΓ0 one_pos⟩

end StratonovichHAMSecondMoment.Audit.VariationalFloor
