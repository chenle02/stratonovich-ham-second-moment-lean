namespace StratonovichHAMSecondMoment.Audit.WhiteFour

open MeasureTheory StratonovichHAMSecondMoment DiagramModel WhiteCollapse WhiteFour
open scoped ENNReal

/-- Consumer: the white-noise total-order-four coefficient `A_2(t)` in `d = 1`
is finite and equals the `E:total-four` combination of the table rows. -/
theorem audit_consumer {α₀ : ℝ} (hα : 0 < α₀ ∧ α₀ < 1) (t : ℝ) :
    coeffALim 1 (Measure.dirac 0) α₀ 2 t =
      2 * ∑ D ∈ Pi2 0 4, diagramLim 1 (Measure.dirac 0) α₀ 0 4 D t +
        2 * ∑ D ∈ Pi2 1 3, diagramLim 1 (Measure.dirac 0) α₀ 1 3 D t +
          ∑ D ∈ Pi2 2 2, diagramLim 1 (Measure.dirac 0) α₀ 2 2 D t ∧
    diagramLim 1 (Measure.dirac 0) α₀ 0 4 pA t < ⊤ :=
  ⟨(white_four_paper hα t).2.2.2.2.2.2.2.2.2.2.2.2.2.1,
    (diagramLim_white_paper hα 0 4 (by rw [Pi2_04]; simp) t).2.2⟩

#check @audit_consumer
#print axioms audit_consumer

end StratonovichHAMSecondMoment.Audit.WhiteFour
