open MeasureTheory StratonovichHAMSecondMoment

namespace StratonovichHAMSecondMoment.Audit.SpatialFourierBound

open StratonovichHAMSecondMoment.SpatialFourierBound

/-- Consumer of the wrapper: under `H:homog` (no `Γ ≠ 0`), every real unit test
has `A_sp(g) ≤ 2^{1+α} R_Γ(1) b(g)^{α/2}` with `b(g) > 0`. -/
private theorem audit_consumer {d : ℕ} {alpha alpha0 : ℝ} {Γ μ : Measure (HomogHypothesis.Rd d)}
    (h : HomogHypothesis.HomogCovariance d alpha alpha0 Γ μ) {g : HomogHypothesis.Rd d → ℝ}
    (hg : IsUnitTest g) :
    0 < gradEnergy g ∧ spatialEnergy Γ g ≤
      2 ^ (1 + alpha) * SpectralHomog.resolvent μ 1 * gradEnergy g ^ (alpha / 2) :=
  ⟨(spatial_fourier_bound_paper h hg).1, (spatial_fourier_bound_paper h hg).2.2.2.2.2.2⟩

#check @audit_consumer
#print axioms audit_consumer

end StratonovichHAMSecondMoment.Audit.SpatialFourierBound
