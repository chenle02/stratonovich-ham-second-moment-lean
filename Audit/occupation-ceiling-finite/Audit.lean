open MeasureTheory StratonovichHAMSecondMoment

namespace StratonovichHAMSecondMoment.Audit.OccupationCeilingFinite

open StratonovichHAMSecondMoment.OccupationCeilingFinite

/-- Consumer of the wrapper: under `H:homog`, `Γ ≠ 0` and the named input `SpaceTimeCS`, the
coefficient-one value set is bounded above by `U_1` with `K_0 R_sp`, and `S1Bdd` holds. -/
private theorem audit_consumer {d : ℕ} {alpha alpha0 : ℝ} {Γ μ : Measure (HomogHypothesis.Rd d)}
    (h : HomogHypothesis.HomogCovariance d alpha alpha0 Γ μ) (hΓ : Γ ≠ 0)
    (hST : SpaceTimeCS alpha0 Γ) :
    VariationalRate.S1Bdd alpha0 Γ ∧ ∀ Ψ ∈ VariationalDilation.CPos d,
      VariationalDilation.integratedRate alpha0 Γ Ψ - VariationalDilation.rawCost alpha0 Γ Ψ / 2 ≤
        ceilingValue alpha 1 (K0 alpha0 * SpatialFourLinear.Rsp Γ alpha) :=
  ⟨s1Bdd_paper h hΓ hST, fun Ψ hΨ => by
    simpa using occupation_ceiling_K0_paper h hΓ hST 1 one_pos Ψ hΨ⟩

#check @audit_consumer
#print axioms audit_consumer

example : K0 0 = 1 := by simp [K0]

end StratonovichHAMSecondMoment.Audit.OccupationCeilingFinite
