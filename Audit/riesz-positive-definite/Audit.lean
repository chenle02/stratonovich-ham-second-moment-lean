set_option pp.all false

namespace StratonovichHAMSecondMoment.Audit.RieszPositiveDefinite

open MeasureTheory StratonovichHAMSecondMoment.EndpointLemmas
  StratonovichHAMSecondMoment.EndpointCorollaries StratonovichHAMSecondMoment.RieszPositiveDefinite
open StratonovichHAMSecondMoment.HomogHypothesis (Rd)

/-- Consumer: one isotropic Riesz component pushed by an invertible `T` with weight one
satisfies `H:three-endpoints` and, with `ThreeTransfer`, the transfer conclusions, now with
no positive-definiteness input. -/
theorem audit_consumer (Mdl : ThreeMomentModel) {α₀ α c : ℝ}
    (hT : ThreeTransfer Mdl α₀ (midTheta α₀ α))
    (hα₀ : 0 < α₀) (hα₀1 : α₀ < 1) (hα1 : 1 < α) (hα2 : α < 2 - α₀) (hc : 0 < c)
    (T : Rd 3 ≃L[ℝ] Rd 3) :
    ThreeEndpoints (midTheta α₀ α) (chi α (midTheta α₀ α))
        (wsum (fun _ : Fin 1 => (1 : ℝ)) fun _ => ((Component.riesz c).meas α).map T) ∧
      ∃ L S, TransferConclusion Mdl α₀ α (midTheta α₀ α)
        (wsum (fun _ : Fin 1 => (1 : ℝ)) fun _ => ((Component.riesz c).meas α).map T) L S := by
  obtain ⟨-, hpair, hconc⟩ := three_finite_images_paper_proved Mdl hT hα₀ hα₀1 hα1 hα2
    (fun _ : Fin 1 => Component.riesz c) (fun _ => hc) (fun _ => T) (fun _ => zero_le_one)
    (by simp)
  exact ⟨⟨_, _, hpair⟩, _, _, hconc⟩

/-- Consumer: the three inputs, as plain propositions. -/
theorem audit_inputs : RieszProductPD ∧ PlaneRieszPD ∧ RieszIsoPD :=
  ⟨rieszProductPD_proved, planeRieszPD_proved, rieszIsoPD_proved⟩

#check @audit_consumer
#print axioms audit_consumer
#check @audit_inputs
#print axioms audit_inputs

end StratonovichHAMSecondMoment.Audit.RieszPositiveDefinite
