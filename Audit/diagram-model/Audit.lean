namespace StratonovichHAMSecondMoment.Audit.DiagramModel

open MeasureTheory StratonovichHAMSecondMoment DiagramModel

/-- Consumer: under `H:homog` and `MixedMoment`, `E X_0² = 1`, `A_0 = 1`, the
odd moment `E[X_0 X_1]` vanishes, and `#Π_1 · 2 = 2!`. -/
theorem audit_consumer {d : ℕ} {alpha α₀ t : ℝ} {Γ μ : Measure (HomogHypothesis.Rd d)}
    {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω} {X : ℕ → Ω → ℝ} {u : Ω → ℝ}
    (hH : HomogHypothesis.HomogCovariance d alpha α₀ Γ μ) (h : MixedMoment d α₀ Γ P X u t) :
    ∫ ω, X 0 ω * X 0 ω ∂P = 1 ∧ coeffALim d Γ α₀ 0 t = 1 ∧
      ∫ ω, X 0 ω * X 1 ω ∂P = 0 ∧ (Pi2 1 1).card * (2 ^ 1 * Nat.factorial 1) = Nat.factorial 2 :=
  ⟨(mixed_moment_paper hH h).2.1, coeffALim_zero d Γ α₀ t,
    (mixed_moment_paper hH h).1 0 1 (by decide), card_Pi2_mul (k := 1) rfl⟩

#check @audit_consumer
#print axioms audit_consumer

end StratonovichHAMSecondMoment.Audit.DiagramModel
