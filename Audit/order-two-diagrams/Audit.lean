namespace StratonovichHAMSecondMoment.Audit.OrderTwoDiagrams

open MeasureTheory StratonovichHAMSecondMoment DiagramModel OrderTwoDiagrams
open scoped ENNReal

/-- Consumer: for white noise in `d = 1` the order-two coefficient `A_1(t)` is
`2 c_0 t^{3-α₀}`, which is exactly the sum of the three order-two diagram values
(`J_{0,2} + J_{1,1} + J_{2,0} = c_0 t^{3-α₀}/2 + c_0 t^{3-α₀} + c_0 t^{3-α₀}/2`). -/
theorem audit_consumer {α₀ : ℝ} (hα0 : α₀ < 1) {t : ℝ} (ht : 0 ≤ t) :
    coeffALim 1 (Measure.dirac 0) α₀ 1 t =
      ENNReal.ofReal (c0 α₀ / 2 * t ^ (3 - α₀)) + ENNReal.ofReal (c0 α₀ * t ^ (3 - α₀)) +
        ENNReal.ofReal (c0 α₀ / 2 * t ^ (3 - α₀)) := by
  have hnn : 0 ≤ c0 α₀ * t ^ (3 - α₀) := mul_nonneg (c0_pos hα0).le (Real.rpow_nonneg ht _)
  rw [white_coeffALim_one hα0 ht, ← ENNReal.ofReal_add (by linarith) hnn,
    ← ENNReal.ofReal_add (by linarith) (by linarith)]
  congr 1
  ring

#check @audit_consumer
#print axioms audit_consumer

end StratonovichHAMSecondMoment.Audit.OrderTwoDiagrams
