namespace StratonovichHAMSecondMoment.Audit.VariationalMean

open MeasureTheory Set StratonovichHAMSecondMoment HomogHypothesis VariationalDilation VariationalMean

/-- Consumer of `variational_global_mean_paper`: under the section's
hypotheses each `h_s`, `s ∈ [0,1]`, has bounded range, and the heat
envelope gives a positive value at zero. -/
theorem audit_consumer {d : ℕ} {alpha alpha0 : ℝ} {Γ μ : Measure (Rd d)}
    (hH : HomogCovariance d alpha alpha0 Γ μ) (hΓ0 : Γ ≠ 0) {Ψ : ℝ × Rd d → ℝ}
    (hΨ : Ψ ∈ CPos d) {s : ℝ} (hs : s ∈ Icc (0 : ℝ) 1) :
    BddAbove (range (mean alpha0 Γ Ψ s)) ∧ 0 < conv Γ (heatK 1) 0 := by
  obtain ⟨M, -, -, -, -, -, h3, -⟩ := variational_global_mean_paper hH hΓ0 hΨ
  refine ⟨⟨M, ?_⟩, (variational_heat_envelope_paper hH hΓ0 one_pos).2.2.2.2⟩
  rintro _ ⟨x, rfl⟩
  exact (h3 s hs x).2

#check @audit_consumer
#print axioms audit_consumer

example : gMass (0 : Measure (Rd 1)) = 0 := by simp [gMass]

end StratonovichHAMSecondMoment.Audit.VariationalMean
