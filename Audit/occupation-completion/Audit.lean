open MeasureTheory StratonovichHAMSecondMoment

namespace StratonovichHAMSecondMoment.Audit.OccupationCompletion

open StratonovichHAMSecondMoment.OccupationCompletion

/-- Consumer of the wrappers: under `H:homog`, `Γ ≠ 0`, for `Ψ ∈ C_pos` and a field of `𝒪`
(joint representatives), `‖Ψ‖²_{H_I} = v_Ψ`, `‖ρ_g‖²_{H_I} = A(g)`,
`⟨Ψ, ρ_g⟩_{H_I} ≤ √(v_Ψ A(g))` and `⟨Ψ, ρ_g⟩_{H_I} = ∫_I ∫ h_{Ψ,s} g_s²`. -/
private theorem audit_consumer {d : ℕ} {alpha alpha0 : ℝ}
    {Γ μ : Measure (HomogHypothesis.Rd d)}
    (hH : HomogHypothesis.HomogCovariance d alpha alpha0 Γ μ) (hΓ : Γ ≠ 0)
    {Ψ : ℝ × HomogHypothesis.Rd d → ℝ} (hΨ : Ψ ∈ VariationalDilation.CPos d)
    {G : ℝ → HomogHypothesis.Rd d → ℝ} {DG : ℝ → HomogHypothesis.Rd d → HomogHypothesis.Rd d}
    (hO : OccupationPhysicalClass.IsOccField G DG) :
    ‖incl (TParams.ofHomog hH) (SpData.ofHomog hH) Ψ‖ ^ 2 =
        VariationalDilation.rawCost alpha0 Γ Ψ ∧
      ‖rho (TParams.ofHomog hH) (SpData.ofHomog hH) G‖ ^ 2 =
        RawOccupationEnergy.A alpha0 Γ G ∧
      inner ℝ (incl (TParams.ofHomog hH) (SpData.ofHomog hH) Ψ)
          (rho (TParams.ofHomog hH) (SpData.ofHomog hH) G) ≤
        Real.sqrt (VariationalDilation.rawCost alpha0 Γ Ψ * RawOccupationEnergy.A alpha0 Γ G) ∧
      inner ℝ (incl (TParams.ofHomog hH) (SpData.ofHomog hH) Ψ)
          (rho (TParams.ofHomog hH) (SpData.ofHomog hH) G) =
        ∫ s in Set.Ioo (0 : ℝ) 1, ∫ x, VariationalDilation.mean alpha0 Γ Ψ s x * G s x ^ 2 := by
  obtain ⟨-, -, -, -, h5⟩ := occupation_raw_square_paper hH hΓ
  obtain ⟨h51, h52, h53⟩ := h5 G DG hO
  exact ⟨((positive_raw_embedding_paper hH hΓ ℝ).2 Ψ hΨ).1, h52, (h53 Ψ hΨ).2.1,
    (h53 Ψ hΨ).2.2.2.2⟩

#check @audit_consumer
#print axioms audit_consumer

end StratonovichHAMSecondMoment.Audit.OccupationCompletion
