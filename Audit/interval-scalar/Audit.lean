open MeasureTheory StratonovichHAMSecondMoment

namespace StratonovichHAMSecondMoment.Audit.IntervalScalar

open StratonovichHAMSecondMoment.IntervalScalar

/-- Consumer of the wrapper `interval_phase_bound_paper`: under `H:homog`, a
coefficient sequence with the hypotheses of `E:interval-coefficient-bound`
(and the supplied identification inputs) has a summable coefficient series and
the energy bound of `E:interval-phase-bound`. -/
private theorem audit_consumer {d : ℕ} {alpha alpha0 : ℝ}
    {Γ μ : Measure (HomogHypothesis.Rd d)}
    (hH : HomogHypothesis.HomogCovariance d alpha alpha0 Γ μ)
    {R C T V energy : ℝ} (c : ℕ → ℝ)
    (hRdef : R = alpha * Real.pi * (μ (Metric.ball 0 1)).toReal /
      (2 * Real.sin (Real.pi * alpha / 2)))
    (hC : 0 ≤ C) (hT : 0 < T) (hV : 0 ≤ V)
    (hodd : ∀ k, c (2 * k + 1) = 0) (h0 : c 0 ≤ Real.exp 1 * V)
    (hcoef : ∀ k, 1 ≤ k → |c (2 * k)| ≤
      C ^ k * R ^ k * T ^ ((4 - alpha - alpha0) * k) / (k.factorial : ℝ) ^ (3 - alpha) * V)
    (henergy : energy = ∑' m, c m) :
    Summable c :=
  (interval_phase_bound_paper hH c hRdef hC hT hV hodd h0 hcoef henergy).1

end StratonovichHAMSecondMoment.Audit.IntervalScalar
