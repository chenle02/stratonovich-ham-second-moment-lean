open MeasureTheory StratonovichHAMSecondMoment

namespace StratonovichHAMSecondMoment.Audit.SpatialStaticControls

open StratonovichHAMSecondMoment.SpatialStaticControls StratonovichHAMSecondMoment.VariationalRate

/-- Consumer of the wrappers: under `H:homog`, `Γ ≠ 0` and `S1Bdd`, for a
nonnegative nonzero test function `z`, `B_Γ(z,z)` is finite and
`S_1^pos ≥ λ_z(1) - (M_a/2) B_Γ(z,z)`; with the floor, `λ_z(1) > 0`. -/
private theorem audit_consumer {d : ℕ} {alpha alpha0 : ℝ}
    {Γ μ : Measure (HomogHypothesis.Rd d)}
    (h : HomogHypothesis.HomogCovariance d alpha alpha0 Γ μ) (hΓ : Γ ≠ 0)
    (hfloor : RayleighFloor Γ) (hS : S1Bdd alpha0 Γ) {z : HomogHypothesis.Rd d → ℝ}
    (hz : WeakSobolev.IsTestFunction z) (hz0 : ∀ x, 0 ≤ z x) (hzne : z ≠ 0) :
    OccupationKernelRow.pairing Γ (zE z) (zE z) ≠ ⊤ ∧ 0 < lamZ Γ z 1 ∧
      lamZ Γ z 1 - TemporalEquilibrium.mass alpha0 / 2 *
        (OccupationKernelRow.pairing Γ (zE z) (zE z)).toReal ≤ S1pos alpha0 Γ :=
  ⟨(spatial_static_score_paper h hΓ hz hz0 hzne).1,
    ((spatial_static_controls_rate_paper h hΓ hfloor hz hz0 hzne).2.1 1 one_pos).2.2.2.1,
    spatial_static_score_sSup_paper h hΓ hS hz hz0 hzne⟩

#check @audit_consumer
#print axioms audit_consumer

example : RayleighFloor (volume : Measure (HomogHypothesis.Rd 2)) := rayleighFloor_volume

end StratonovichHAMSecondMoment.Audit.SpatialStaticControls
