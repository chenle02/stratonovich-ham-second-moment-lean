open MeasureTheory Metric in
/-- Consumer: the wrapper of `P:frequency-row` bounds each single row `J_h(ξ)` by the
same constant, chosen before the dimension and the measure. -/
private theorem single_row_consumer {α a γ : ℝ} (hγ0 : 0 < γ)
    (hγ : γ < min (1 / 2) ((2 - α) / 2)) :
    ∃ K : ℝ, 0 ≤ K ∧ ∀ (d : ℕ) (Γ μ : Measure (StratonovichHAMSecondMoment.HomogHypothesis.Rd d)),
      StratonovichHAMSecondMoment.HomogHypothesis.HomogCovariance d α a Γ μ →
      ∀ ν : Measure (StratonovichHAMSecondMoment.HomogHypothesis.Rd d), IsLocallyFiniteMeasure ν →
      ∀ C : ℝ, 0 ≤ C →
      (∀ y r, 0 < r → ν (ball y r) ≤ ENNReal.ofReal (C * r ^ α)) →
      ∀ h : ℝ, 0 < h → h ≤ 1 → ∀ ξ,
        StratonovichHAMSecondMoment.FrequencyRow.rowIntegral a γ h ν ξ ≠ ⊤ := by
  obtain ⟨K, hK0, hK⟩ := StratonovichHAMSecondMoment.FrequencyRow.frequency_row_paper hγ0 hγ
  refine ⟨K, hK0, fun d Γ μ hH ν hν C hC hg h h0 h1 ξ => ?_⟩
  exact ne_top_of_le_ne_top ENNReal.ofReal_ne_top
    ((le_iSup (fun ξ => StratonovichHAMSecondMoment.FrequencyRow.rowIntegral a γ h ν ξ) ξ).trans
      (hK d Γ μ hH ν hν C hC hg h h0 h1).1)
#check @single_row_consumer
#print axioms single_row_consumer
open MeasureTheory in
example (d : ℕ) (a γ h : ℝ) (ξ : StratonovichHAMSecondMoment.HomogHypothesis.Rd d) :
    StratonovichHAMSecondMoment.FrequencyRow.rowIntegral a γ h 0 ξ = 0 := by
  simp [StratonovichHAMSecondMoment.FrequencyRow.rowIntegral]
example : StratonovichHAMSecondMoment.FrequencyRow.scaleProfile 1 1 = 1 := by
  simp [StratonovichHAMSecondMoment.FrequencyRow.scaleProfile]
