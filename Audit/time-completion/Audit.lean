open MeasureTheory Set StratonovichHAMSecondMoment

namespace StratonovichHAMSecondMoment.Audit.TimeCompletion

open StratonovichHAMSecondMoment.TimeCompletion

/-- Consumer of the wrapper: for `0 < a < 1` and `T > 0`, `H_a` is separable, and every
`f ∈ L²(0,T)` has `‖f‖_a² ≤ (2T^{1-a}/(1-a)) ∫_0^T |f|²` with `‖f‖_a²` real and equal
to the complex double integral. -/
private theorem audit_consumer (a T : ℝ) (ha0 : 0 < a) (ha1 : a < 1) (hT : 0 < T)
    (f : ℝ → ℂ) (hf : MemLp f 2 (volume.restrict (Icc 0 T))) :
    TopologicalSpace.SeparableSpace (Ha ⟨a, T, ha0, ha1, hT⟩) ∧
      ‖emb ⟨a, T, ha0, ha1, hT⟩ ⟨f, hf⟩‖ ^ 2 ≤
        2 * T ^ (1 - a) / (1 - a) * ∫ t in Icc 0 T, ‖f t‖ ^ 2 ∧
      ((‖emb ⟨a, T, ha0, ha1, hT⟩ ⟨f, hf⟩‖ ^ 2 : ℝ) : ℂ) = TimeSchur.timeForm a T f f :=
  let h := masked_time_completion_paper a T ha0 ha1 hT
  ⟨h.2.1, h.2.2.1 f hf, (h.2.2.2.2.1 f hf).2.1⟩

#check @audit_consumer
#print axioms audit_consumer

end StratonovichHAMSecondMoment.Audit.TimeCompletion
