namespace StratonovichHAMSecondMoment.Audit.MaskedAuxiliaryReal

open MeasureTheory StratonovichHAMSecondMoment.MaskedAuxiliaryNorm
open StratonovichHAMSecondMoment.MaskedAuxiliaryReal

/-- Consumer of the real wrapper: under `H:homog`, `Γ ≠ 0` and `ζ ≠ 0`, for a
separable real Hilbert space `H` and every `R > 0`, the complexified form of
`E:masked-hilbert-fourier` holds, its left integrand is the transform of the
complexified real masked map `ι(ζ_R F)`, and the right integrand is
`c_d² (‖∫ cos F‖² + ‖∫ sin F‖²)`. -/
private theorem audit_consumer {d : ℕ} {alpha alpha0 : ℝ} {Γ μ : Measure (HomogHypothesis.Rd d)}
    (h : HomogHypothesis.HomogCovariance d alpha alpha0 Γ μ) (hΓ : Γ ≠ 0)
    (ζ : SchwartzMap (HomogHypothesis.Rd d) ℝ) (hζ : ζ ≠ 0)
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
    [TopologicalSpace.SeparableSpace H] (F : SchwartzMap (HomogHypothesis.Rd d) H)
    (R : ℝ) (hR : 0 < R) :
    ∫ ξ, ‖paperHat (fun x => Cx.ofRealCLM (zetaR ζ R x • F x)) ξ‖ ^ 2 ∂μ ≤
      ∫ η, cd d ^ 2 * (‖∫ x, Real.cos (inner ℝ η x) • F x‖ ^ 2 +
        ‖∫ x, Real.sin (inner ℝ η x) • F x‖ ^ 2) ∂nu μ ζ R := by
  obtain ⟨-, -, -, -, hn, hm, -, hall⟩ := masked_auxiliary_norm_real_paper h hΓ ζ hζ F
  obtain ⟨-, -, -, -, -, hf⟩ := hall R hR
  have h1 := hf.2.2.2.2
  rw [hm R] at h1
  simpa only [hn] using h1

#check @audit_consumer
#print axioms audit_consumer

end StratonovichHAMSecondMoment.Audit.MaskedAuxiliaryReal
