open MeasureTheory Set in
/-- Consumer: the time mass `M_a` is not renormalized, so the downstream
normalized density `f_a / M_a` has constant potential `1 / M_a`. -/
private theorem normalized_potential_consumer {a : ℝ} (ha0 : 0 < a) (ha1 : a < 1)
    (s : ℝ) (hs : s ∈ Icc (0 : ℝ) 1) :
    0 < StratonovichHAMSecondMoment.TemporalEquilibrium.mass a ∧
      ∫ t in Ioo (0 : ℝ) 1, |s - t| ^ (-a) *
          StratonovichHAMSecondMoment.TemporalEquilibrium.density a t /
          StratonovichHAMSecondMoment.TemporalEquilibrium.mass a =
        1 / StratonovichHAMSecondMoment.TemporalEquilibrium.mass a := by
  obtain ⟨-, -, -, hpot, -, hpos⟩ :=
    StratonovichHAMSecondMoment.TemporalEquilibrium.temporal_equilibrium_paper ha0 ha1
  refine ⟨hpos, ?_⟩
  rw [integral_div, (hpot s hs).2]
#check @normalized_potential_consumer
#print axioms normalized_potential_consumer
open MeasureTheory Set in
example : 0 < StratonovichHAMSecondMoment.TemporalEquilibrium.mass (1 / 2) ∧
    ∫ t in Ioo (0 : ℝ) 1, |0 - t| ^ (-(1 / 2 : ℝ)) *
        StratonovichHAMSecondMoment.TemporalEquilibrium.density (1 / 2) t /
        StratonovichHAMSecondMoment.TemporalEquilibrium.mass (1 / 2) =
      1 / StratonovichHAMSecondMoment.TemporalEquilibrium.mass (1 / 2) :=
  normalized_potential_consumer (by norm_num) (by norm_num) 0 ⟨le_rfl, by norm_num⟩
example : Real.Gamma (1 + 1) = 1 * Real.Gamma 1 ∧
    StratonovichHAMSecondMoment.TemporalEquilibrium.Beta 1 1 =
      Real.Gamma 1 * Real.Gamma 1 / Real.Gamma (1 + 1) ∧
    Real.Gamma (2 * 1) = 2 ^ (2 * 1 - 1 : ℝ) * Real.Gamma 1 * Real.Gamma (1 + 1 / 2) /
      √Real.pi :=
  StratonovichHAMSecondMoment.TemporalEquilibrium.gamma_beta_paper one_pos one_pos
