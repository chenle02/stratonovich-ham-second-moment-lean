open MeasureTheory StratonovichHAMSecondMoment

namespace StratonovichHAMSecondMoment.Audit.PhaseContractions

open StratonovichHAMSecondMoment.PhaseContractions

/-- Consumer of the wrapper: under `H:homog` in `d = 3` and the two supplied
inputs, the shifted resolvent is at most `R_α λ^{α-2}` and the trace is at most
`D_Γ a^{1-α}`. -/
private theorem audit_consumer {alpha alpha0 : ℝ} {Γ μ : Measure (HomogHypothesis.Rd 3)}
    (h : HomogHypothesis.HomogCovariance 3 alpha alpha0 Γ μ) (hW : WaveFourierThree)
    (hA : ArchimedesLaw) (lam a ε : ℝ) (hlam : 0 < lam) (ha : 0 < a) (hε : 0 < ε)
    (q : HomogHypothesis.Rd 3) :
    ∫ ξ, 1 / (lam ^ 2 + ‖q + ξ‖ ^ 2) ∂μ ≤
        SpectralMassIdentity.ralpha μ alpha * lam ^ (alpha - 2) ∧
      ‖traceT Γ ε a q‖ ≤ dGam Γ alpha * a ^ (1 - alpha) := by
  have hP := phase_contractions_paper (PhaseCovariance.of_homog h) hW hA
  exact ⟨(hP.1 lam hlam q).2, (hP.2 a ha ε hε q).2.2.2.2⟩

#check @audit_consumer
#print axioms audit_consumer

end StratonovichHAMSecondMoment.Audit.PhaseContractions
