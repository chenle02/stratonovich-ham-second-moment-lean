-- Consumer: under `H:homog` in `d = 3` with `α ≤ 1`, the regularized
-- coefficients obey the bound of `P:low-alpha-upper` at width `1`.
open MeasureTheory StratonovichHAMSecondMoment DiagramModel LowAlphaUpper in
open scoped Nat in
theorem audit_consumer_low {α α₀ : ℝ} {Γ μ : Measure (HomogHypothesis.Rd 3)}
    (hH : HomogHypothesis.HomogCovariance 3 α α₀ Γ μ) (hα : α ≤ 1)
    (hV : 0 < (LowAlphaConvolution.specV μ).toReal) {k : ℕ} (hk : 1 ≤ k) {t : ℝ}
    (ht : 0 < t) :
    coeffA (WaveGreen.waveGreen 3) (covEps Γ 1) α₀ k t ≤
      ENNReal.ofReal ((2 * TwoSimplexTime.Zc α₀ *
          Kgen α (LowAlphaConvolution.specV μ).toReal) ^ k * t ^ ((4 - α - α₀) * k) /
        ((k ! : ℝ) * (k : ℝ) ^ ((2 - α) * k))) :=
  (low_alpha_upper_paper hH hα hV hk ht).1 1 one_pos

#print axioms audit_consumer_low
