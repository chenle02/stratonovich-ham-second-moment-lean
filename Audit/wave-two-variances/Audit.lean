open MeasureTheory StratonovichHAMSecondMoment
open scoped ComplexConjugate

namespace StratonovichHAMSecondMoment.Audit.WaveTwoVariances

open StratonovichHAMSecondMoment.WaveTwoVariances

/-- Consumer of the wrapper: under the hypotheses of `wave_two_variances_paper`, a single
unit phase `e` gives `var(e, z) ≤ C_T h^{2-a} B_α(h) ‖z‖²_{E_{s-γ}}` (input direction,
family of size one), with `C_T` independent of `R` and `I`. -/
private theorem audit_consumer {d : ℕ} {alpha alpha0 γ : ℝ}
    {Γ μ : Measure (HomogHypothesis.Rd d)}
    (hH : HomogHypothesis.HomogCovariance d alpha alpha0 Γ μ) (hγ0 : 0 < γ)
    (hγ : γ < min (1 / 2) ((2 - alpha) / 2)) (p : TimeCompletion.TimeParams)
    (hpa : p.a = alpha0) (ζ : SchwartzMap (HomogHypothesis.Rd d) ℝ)
    (hζe : ∀ x, ζ (-x) = ζ x) (hζ0 : ∀ x, 0 ≤ ζ x)
    (hζ1 : ∀ x : HomogHypothesis.Rd d, ‖x‖ ≤ 1 → ζ x = 1)
    (hζ2 : ∀ x : HomogHypothesis.Rd d, 2 ≤ ‖x‖ → ζ x = 0)
    {P : Type*} [NormedAddCommGroup P] [InnerProductSpace ℂ P]
    (J : P → Fin 2 → HomogHypothesis.Rd d → ℂ) (hJL2 : ∀ z i, MemLp (J z i) 2 volume)
    (hJ : ∀ z w, ∫ η, ∑ j, J z j η * conj (J w j η) = inner ℂ w z)
    (normSG : P → ℝ)
    (hnormSG : ∀ z, normSG z ^ 2 = ∫ ξ, MaskedTrigProducts.bracket ‖ξ‖ ^ (-(2 * γ)) *
      ∑ i, ‖J z i ξ‖ ^ 2)
    (var : ℝ → ℝ → ℝ → P → P → ℝ)
    (hlink : ∀ R : ℝ, 0 < R → ∀ t0 h : ℝ, 0 < h → h ≤ 1 → 0 ≤ t0 → t0 + h ≤ p.T →
      ∀ z w : P, ENNReal.ofReal (var R t0 h z w) ≤
        ∫⁻ l, ‖coef p t0 h (J z) (J w) l‖ₑ ^ 2 ∂(MaskedAuxiliaryNorm.nu μ ζ R))
    (e : P) (he : ‖e‖ = 1) :
    ∃ CT : ℝ, 0 ≤ CT ∧ ∀ R : ℝ, 0 < R → ∀ t0 h : ℝ, 0 < h → h ≤ 1 → 0 ≤ t0 →
      t0 + h ≤ p.T → ∀ z : P,
        var R t0 h e z ≤ CT * h ^ (2 - alpha0) * FrequencyRow.scaleProfile alpha h *
          normSG z ^ 2 := by
  obtain ⟨⟨CT, hCT, hb⟩, -⟩ := wave_two_variances_paper hH hγ0 hγ p hpa ζ hζe hζ0 hζ1 hζ2
    J hJL2 hJ normSG hnormSG var hlink
  refine ⟨CT, hCT, fun R hR t0 h hh0 hh1 ht0 hT z => ?_⟩
  have hon : Orthonormal ℂ (fun _ : Fin 1 => e) := by
    rw [orthonormal_iff_ite]; intro i j
    rw [Subsingleton.elim i j, inner_self_eq_norm_sq_to_K, he]; simp
  have := (hb R hR t0 h hh0 hh1 ht0 hT 1 (fun _ => e) hon z).1
  simpa using this

#check @audit_consumer
#print axioms audit_consumer

end StratonovichHAMSecondMoment.Audit.WaveTwoVariances
