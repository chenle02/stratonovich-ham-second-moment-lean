namespace StratonovichHAMSecondMoment.Audit.FockSandwichModel

open StratonovichHAMSecondMoment MeasureTheory

/-- Consumer: under the class of `S:static-phase`, for real orthonormal modes in `L²(μ_ε)`,
`E:fock-sandwich` holds for the model operators, with no supplied input. -/
private theorem audit_consumer {m : ℕ} {alpha R ε : ℝ} {Γ μ : Measure (HomogHypothesis.Rd 3)}
    (hPC : PhaseContractions.PhaseCovariance alpha Γ μ)
    (hRdef : R = alpha * Real.pi * (μ (Metric.ball 0 1)).toReal /
      (2 * Real.sin (Real.pi * alpha / 2)))
    (hε : 0 < ε) (ψ : Fin m → Lp ℂ 2 (FockColumnBound.nuEps μ ε)) (hψ : Orthonormal ℂ ψ)
    (hreal : ∀ i, ∀ᵐ ξ ∂(FockColumnBound.nuEps μ ε), ψ i (-ξ) = (starRingEnd ℂ) (ψ i ξ))
    (N : ℕ) (b : ℝ) :
    StaticInteractionCompleted.FockSandwich (FockSandwichModel.opA0 (d := 3) (m := m) (N := N) b)
      (FockSandwichModel.fieldB b (FockColumnBound.nuEps_finite hPC.μ_tempered hε) ψ hψ)
      (StaticPhaseCauchy.fockD N R) (alpha / 2) :=
  (FockSandwichModel.fock_sandwich_paper hPC hRdef hε ψ hψ hreal N b).2.2.2.2

#check @audit_consumer
#print axioms audit_consumer

end StratonovichHAMSecondMoment.Audit.FockSandwichModel
