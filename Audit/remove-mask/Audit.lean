open MeasureTheory StratonovichHAMSecondMoment Filter

namespace StratonovichHAMSecondMoment.Audit.RemoveMask

open StratonovichHAMSecondMoment.RemoveMask

/-- Consumer of the wrapper: under `H:homog`, `Γ ≠ 0` and the named input,
the integrated masked rates converge to `I_Ψ` and the point-moment liminf is
at least `2 I_Ψ - v_Ψ/2`. -/
private theorem audit_consumer {d : ℕ} {alpha alpha0 : ℝ} {Γ μ : Measure (HomogHypothesis.Rd d)}
    (h : HomogHypothesis.HomogCovariance d alpha alpha0 Γ μ) (hΓ : Γ ≠ 0)
    {Ψ : ℝ × HomogHypothesis.Rd d → ℝ} (hΨ : Ψ ∈ VariationalDilation.CPos d) {L : ℝ → ℝ}
    (hRB : RawBlockOriginalLower alpha0 Γ Ψ (VariationalDilation.rawCost alpha0 Γ Ψ) L) :
    Tendsto (maskedIntegratedRate alpha0 Γ Ψ) atTop
        (nhds (VariationalDilation.integratedRate alpha0 Γ Ψ)) ∧
      ((2 * VariationalDilation.integratedRate alpha0 Γ Ψ -
          VariationalDilation.rawCost alpha0 Γ Ψ / 2 : ℝ) : EReal) ≤
        liminf (fun T => (L T : EReal)) atTop := by
  obtain ⟨-, -, -, ⟨ε, M, C, R₀, -, -, -, -, -, -, -, -, -, -, -, -, hlim⟩, hpt⟩ :=
    variational_remove_mask_paper h hΓ hΨ hRB
  exact ⟨hlim, hpt⟩

#check @audit_consumer
#print axioms audit_consumer

example : chi 0 = 1 := chi_eq_one (by norm_num)

end StratonovichHAMSecondMoment.Audit.RemoveMask
