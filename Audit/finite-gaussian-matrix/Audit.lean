open MeasureTheory ProbabilityTheory Matrix StratonovichHAMSecondMoment.FiniteGaussianMatrix in
/-- Consumer: at `p = 2`, the wrapper gives `E ‖X‖_{S_2}^2 = Tr V_in`, and the
`p = 4` bound gives `E ‖X‖_{S_4}^4 ≤ 9 (Tr V_out^2 + Tr V_in^2)/2`. -/
private theorem finite_gaussian_matrix_consumer {Ω : Type*} [MeasurableSpace Ω]
    (P : Measure Ω) [IsProbabilityMeasure P] {o n : Type*} [Fintype o] [Fintype n]
    [DecidableEq o] [DecidableEq n] [Nonempty o] [Nonempty n] {N : ℕ} (hN : 1 ≤ N)
    (A : Fin N → Matrix o n ℂ) (g : Fin N → Ω → ℝ) (hind : iIndepFun g P)
    (hlaw : ∀ k, HasLaw (g k) (gaussianReal 0 1) P) :
    ∫ ω, schattenPow (gaussLin A (fun k => g k ω)) 1 ∂P = (trace (vIn A)).re ∧
      (∫ ω, schattenPow (gaussLin A (fun k => g k ω)) 2 ∂P) ^ (1 / (2 * ((2 : ℕ) : ℝ))) ≤
        √(2 * ((2 : ℕ) : ℝ) - 1) *
          (((trace (vOut A ^ 2)).re + (trace (vIn A ^ 2)).re) / 2) ^
            (1 / (2 * ((2 : ℕ) : ℝ))) :=
  ⟨((finite_gaussian_matrix_paper P hN A g hind hlaw 1 le_rfl).2.2.2.1 rfl).2.1,
    (finite_gaussian_matrix_paper P hN A g hind hlaw 2 (by norm_num)).2.1⟩
#check @finite_gaussian_matrix_consumer
#print axioms finite_gaussian_matrix_consumer
open MeasureTheory StratonovichHAMSecondMoment.FiniteGaussianMatrix StratonovichHAMSecondMoment.GaussianIBP in
example : ∫ x, schattenPow (gaussLin (rowFamily 16) x) 2 ∂stdPi 16 = 288 :=
  gaussian_one_variance_test.2.2.1
