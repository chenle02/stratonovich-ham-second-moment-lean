open MeasureTheory Filter Topology StratonovichHAMSecondMoment.RadiusMeanAnchor in
/-- Consumer: the paper proposition at the manuscript's radius `R = δ⁻¹ + 2`,
keeping the decay bound `E:radius-mean-anchor-decay` together with its limit
`→ 0` as `δ → 0⁺` (the form in which "the averaged block mean tends to zero"
is used downstream). -/
private theorem radius_decay_consumer {E Ω : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    [MeasurableSpace Ω] (μ : Measure Ω) [IsProbabilityMeasure μ]
    (d : ℕ) (hd : d = 1 ∨ d = 2 ∨ d = 3) (a α : ℝ) (ha0 : 0 < a) (ha1 : a < 1)
    (hα : (0 < α ∧ α < d) ∨ (α = d ∧ d = 1)) (hthr : a + α < 2)
    (γ θ ηt βt : ℝ) (hγ0 : 0 < γ) (hγ : γ < min (1 / 2) ((2 - α) / 2))
    (hθ : 1 / 2 < θ) (hθη : θ < ηt) (hηβ : ηt < βt)
    (hβ : βt < min (1 - a / 2) ((3 - a - α) / 2))
    (Q : ℕ) (hQeven : Even Q) (hQ2 : 2 ≤ Q) (hQγ : (d : ℝ) < Q * γ)
    (hQβ : 0 < βt - ηt - 1 / Q) (hQa : 2 * (d : ℝ) / (1 - a) < Q)
    (B : ℕ) (hB : 1 ≤ B) (δ : ℝ) (hδ0 : 0 < δ) (hδ : δ < min 1 (1 / (B : ℝ)))
    (p : ℝ) (hp : 1 ≤ p) (C : ℝ) (M : ℕ → Ω → ℝ → E)
    (hMC : ∀ m ∈ Finset.range (⌊1 / (δ * B)⌋₊ + 1), ∀ᵐ ω ∂μ, IsCHolder θ B (M m ω))
    (hMint : ∀ m ∈ Finset.range (⌊1 / (δ * B)⌋₊ + 1),
      Integrable (fun ω => holderNorm θ B (M m ω) ^ p) μ)
    (hMmom : ∀ m ∈ Finset.range (⌊1 / (δ * B)⌋₊ + 1),
      (∫ ω, holderNorm θ B (M m ω) ^ p ∂μ) ^ (1 / p) ≤
        C * Real.sqrt p * (δ⁻¹ + 2) ^ ((d : ℝ) / Q))
    (hXmeas : ∀ m ∈ Finset.range (⌊1 / (δ * B)⌋₊ + 1),
      AEStronglyMeasurable (fun ω =>
        holderNorm θ B (blockPath (δ ^ ((1 - a) / 2)) (ell δ B m) (M m ω))) μ) :
    2 * ∫ ω, (δ * ∑ m ∈ Finset.range (⌊1 / (δ * B)⌋₊ + 1),
        holderNorm θ B (blockPath (δ ^ ((1 - a) / 2)) (ell δ B m) (M m ω)) ^ p)
          ^ (1 / p) ∂μ ≤
        2 * (2 / (B : ℝ)) ^ (1 / p) * C * Real.sqrt p * 3 ^ ((d : ℝ) / Q) *
          δ ^ ((1 - a) / 2 - (d : ℝ) / Q) ∧
      Tendsto (fun δ' : ℝ => 2 * (2 / (B : ℝ)) ^ (1 / p) * C * Real.sqrt p *
        3 ^ ((d : ℝ) / Q) * δ' ^ ((1 - a) / 2 - (d : ℝ) / Q)) (𝓝[>] 0) (𝓝 0) := by
  have hR : 1 ≤ δ⁻¹ + 2 := by
    have := inv_pos.mpr hδ0
    linarith
  obtain ⟨-, -, hdecay, hlim⟩ := radius_mean_anchor_paper μ d hd a α ha0 ha1 hα hthr
    γ θ ηt βt hγ0 hγ hθ hθη hηβ hβ Q hQeven hQ2 hQγ hQβ hQa B hB δ hδ0 hδ p hp
    (δ⁻¹ + 2) hR C M hMC hMint hMmom hXmeas
  exact ⟨hdecay rfl, hlim⟩
#check @radius_decay_consumer
#print axioms radius_decay_consumer
/- No example instantiating `radius_decay_consumer`: it needs a probability
space and a family of random `C^θ` paths carrying the supplied moment input of
`C:radius-covariance-residuals` (integrability and the `L^p(C^θ)` bound), which
this package does not construct. The scalar margin is instantiated instead
(`a = 1/2`, `d = 1`, `Q = 16`: `2d/(1-a) = 4 < 16`). -/
example : 0 < (1 - (1 / 2 : ℝ)) / 2 - 1 / 16 :=
  StratonovichHAMSecondMoment.RadiusMeanAnchor.anchor_margin_pos (1 / 2) 16 1
    (by norm_num) (by norm_num) (by norm_num)
