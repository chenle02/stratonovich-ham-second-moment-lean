namespace StratonovichHAMSecondMoment.Audit.FockColumnBound

open StratonovichHAMSecondMoment MeasureTheory

/-- Consumer: under `H:homog`, for real orthonormal modes in `L²(μ_ε)`, the band-compressed
sandwiched fields of `L:interval-contractions` have column bound `R_α ρ^{α-4}` and the
spatial operators `A_ρ^{-1/2} M_{e_i}` satisfy `E:interval-column`, with no supplied input. -/
private theorem audit_consumer {d : ℕ} {alpha alpha0 R ε ρ b : ℝ}
    {Γ μ : Measure (HomogHypothesis.Rd d)}
    (hH : HomogHypothesis.HomogCovariance d alpha alpha0 Γ μ)
    (hRdef : R = alpha * Real.pi * (μ (Metric.ball 0 1)).toReal /
      (2 * Real.sin (Real.pi * alpha / 2)))
    (hε : 0 < ε) (hρ : 0 < ρ) {m : ℕ} (ψ : Fin m → Lp ℂ 2 (FockColumnBound.nuEps μ ε))
    (hψ : Orthonormal ℂ ψ)
    (hreal : ∀ i, ∀ᵐ ξ ∂(FockColumnBound.nuEps μ ε), ψ i (-ξ) = (starRingEnd ℂ) (ψ i ξ)) :
    FockForm.FockColumn (fun i => FockColumnBound.sqrtResolvent ρ hρ ∘L
        FockColumnBound.modes (FockColumnBound.nuEps_finite hH.μ_tempered hε) ψ hψ i)
        (R * ρ ^ (alpha - 2)) ∧
      FockForm.FockColumn (fun i => FockColumnBound.sqrtResolvent ρ hρ ∘L
        (FockColumnBound.bandProj b ∘L
          FockColumnBound.modes (FockColumnBound.nuEps_finite hH.μ_tempered hε) ψ hψ i ∘L
          FockColumnBound.bandProj b) ∘L FockColumnBound.sqrtResolvent ρ hρ)
        (R * ρ ^ (alpha - 4)) :=
  ⟨FockColumnBound.interval_column_completed hH hRdef hε hρ ψ hψ,
    (FockColumnBound.interval_contractions_paper_completed (b := b) hH hRdef hε hρ ψ hψ
      hreal).2.2.2.1⟩

#check @audit_consumer
#print axioms audit_consumer

end StratonovichHAMSecondMoment.Audit.FockColumnBound
