namespace StratonovichHAMSecondMoment.Audit.RieszFourDiagrams

open MeasureTheory StratonovichHAMSecondMoment DiagramModel OrderTwoDiagrams RieszFourDiagrams
open scoped ENNReal

/-- Consumer: for `Γ(dy) = |y|^{-1/2} dy`, `α₀ = 1/2`, `t = 1`, the measure-form
order-two coefficient `A_1` equals the density coefficient (so the order-two
closed forms of `E:riesz-two` apply to the TeX's `J`), and the order-four
coefficient `A_2` of the density is finite and positive. -/
theorem audit_consumer :
    coeffALim 1 ((volume : Measure (HomogHypothesis.Rd 1)).withDensity
        (HigherRieszTwo.riesz 1 (1 / 2))) (1 / 2) 1 1 =
      coeffA (WaveGreen.waveGreen 1) (HigherRieszTwo.riesz 1 (1 / 2)) (1 / 2) 1 1 ∧
    coeffA (WaveGreen.waveGreen 1) (HigherRieszTwo.riesz 1 (1 / 2)) (1 / 2) 2 1 ≠ ⊤ ∧
    0 < coeffA (WaveGreen.waveGreen 1) (HigherRieszTwo.riesz 1 (1 / 2)) (1 / 2) 2 1 := by
  have hL := rieszDiagramLimit (c := 1) (α := 1 / 2) (α₀ := 1 / 2) (t := 1) zero_le_one
    (by norm_num) (by norm_num) (by norm_num) (by norm_num) zero_le_one
  refine ⟨?_, (riesz_coeffA_two zero_le_one (by norm_num) (by norm_num) (by norm_num)
    (by norm_num) one_pos).2, ?_⟩
  · unfold coeffALim coeffA
    refine Finset.sum_congr rfl fun m hm => Finset.sum_congr rfl fun D hD => ?_
    exact hL m (2 * 1 - m) D (by have := Finset.mem_range.1 hm; omega) hD
  · unfold coeffA
    refine pos_iff_ne_zero.2 fun h0 => ?_
    rw [Finset.sum_eq_zero_iff] at h0
    have h1 := h0 0 (Finset.mem_range.2 (by norm_num))
    rw [Finset.sum_eq_zero_iff] at h1
    obtain ⟨D, hD⟩ : (Pi2 0 (2 * 2 - 0)).Nonempty :=
      Finset.card_pos.1 (by rw [card_Pi2 (m := 0) (n := 2 * 2 - 0) (k := 2) rfl]; decide)
    exact (diagram_riesz_pos one_pos (by norm_num) D one_pos).ne' (h1 D hD)

#check @audit_consumer
#print axioms audit_consumer

end StratonovichHAMSecondMoment.Audit.RieszFourDiagrams
