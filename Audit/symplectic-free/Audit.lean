namespace StratonovichHAMSecondMoment.Audit.SymplecticFree

open StratonovichHAMSecondMoment.SymplecticFree

/-- Consumer of the wrapper: under `H:homog`, a compact-valued path with a convergent
Young evolution gives a physical endpoint of norm at least one. -/
private theorem audit_consumer {d : ℕ} {alpha alpha0 : ℝ}
    {Γ μ : MeasureTheory.Measure (HomogHypothesis.Rd d)}
    (hH : HomogHypothesis.HomogCovariance d alpha alpha0 Γ μ)
    {E : Type} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E] [Nontrivial E]
    (F : FreeWaveData d E) (T : ℝ) (hT : 0 < T) (θ : NNReal) (hθ : 1 / 2 < θ) (hθ1 : θ < 1)
    (X : ℝ → E →L[ℝ] E) (CX : NNReal) (hXhol : HolderOnWith CX θ X (Set.Icc 0 T))
    (hX0 : X 0 = 0) (hXK : ∀ r ∈ Set.Icc 0 T, IsCompactOperator (X r))
    (U : ℝ → ℝ → E →L[ℝ] E)
    (hU : ∀ s t : ℝ, 0 ≤ s → s ≤ t → t ≤ T → LeftYoungSumsConverge X U s t) :
    1 ≤ ‖F.S T * U T 0 * F.S (-0)‖ := by
  have h := symplectic_compact_young_baseline_paper hH F T hT θ hθ hθ1 X CX hXhol hX0 hXK U hU
    0 T le_rfl hT.le le_rfl
  have h2 := h.2.2
  rw [sub_zero] at h2
  exact h2.trans (by simpa using h.2.1)

example : sineQuotient 3 0 = 3 := sineQuotient_zero 3

end StratonovichHAMSecondMoment.Audit.SymplecticFree
