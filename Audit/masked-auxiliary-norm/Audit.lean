namespace StratonovichHAMSecondMoment.Audit.MaskedAuxiliaryNorm

open MeasureTheory StratonovichHAMSecondMoment.MaskedAuxiliaryNorm

/-- Consumer of the wrapper: under `H:homog`, `Γ ≠ 0` and `ζ ≠ 0`, for every
`R > 0` the unit balls have finite `ν_R`-mass with a bound independent of
`R`, `ν_R` is tempered, and the scalar (`H = ℂ`) form of
`E:masked-hilbert-fourier` holds. -/
private theorem audit_consumer {d : ℕ} {alpha alpha0 : ℝ} {Γ μ : Measure (HomogHypothesis.Rd d)}
    (h : HomogHypothesis.HomogCovariance d alpha alpha0 Γ μ) (hΓ : Γ ≠ 0)
    (ζ : SchwartzMap (HomogHypothesis.Rd d) ℝ) (hζ : ζ ≠ 0)
    (F : SchwartzMap (HomogHypothesis.Rd d) ℂ) (R : ℝ) (hR : 0 < R) (y : HomogHypothesis.Rd d) :
    nu μ ζ R (Metric.closedBall y 1) ≤
        ENNReal.ofReal (cd d ^ 2 * Lz ζ ^ 2 * MaskedSpectralGrowth.CGamma Γ * 1 ^ alpha) ∧
      HomogHypothesis.IsTempered (nu μ ζ R) ∧
      ∫ ξ, ‖paperHat (fun x => (zetaR ζ R x : ℂ) • F x) ξ‖ ^ 2 ∂μ ≤
        ∫ η, ‖paperHat (F : HomogHypothesis.Rd d → ℂ) η‖ ^ 2 ∂nu μ ζ R := by
  obtain ⟨-, hall⟩ := masked_auxiliary_norm_paper h hΓ ζ hζ F
  obtain ⟨-, -, ht, -, hb, hf⟩ := hall R hR
  exact ⟨(hb y 1 one_pos).2, ht, hf.2.2.2.2⟩

#check @audit_consumer
#print axioms audit_consumer

end StratonovichHAMSecondMoment.Audit.MaskedAuxiliaryNorm
