open MeasureTheory ProbabilityTheory Set StratonovichHAMSecondMoment

namespace StratonovichHAMSecondMoment.Audit.SourceTube

open StratonovichHAMSecondMoment.SourceTube

/-- Consumer of `source_finite_comparison_paper`: a centered Gaussian vector with
covariance `≤ I` has `L^2` norm of `∑ ξⱼ vⱼ` at most that of `∑ gⱼ vⱼ`. -/
private theorem audit_consumer_source {ι Ω Ω' : Type} [Fintype ι] [DecidableEq ι]
    [MeasurableSpace Ω] [MeasurableSpace Ω'] {P : Measure Ω} {Q : Measure Ω'}
    [IsProbabilityMeasure Q] (v : ι → ℝ) (ξ : ι → Ω → ℝ)
    (hξ : HasGaussianLaw (fun ω => WithLp.toLp 2 (fun j => ξ j ω)) P)
    (hcent : ∀ j, ∫ ω, ξ j ω ∂P = 0)
    (hcov : ((1 : ℝ) • (1 : Matrix ι ι ℝ) - covMatrix P ξ).PosSemidef)
    (g : ι → Ω' → ℝ) (hgm : ∀ j, AEMeasurable (g j) Q) (hind : iIndepFun g Q)
    (hgl : ∀ j, Q.map (g j) = gaussianReal 0 1) :
    (∫ ω, ‖∑ j, ξ j ω • v j‖ ^ (2 : ℝ) ∂P) ^ (1 / (2 : ℝ)) ≤
      (∫ ω, ‖∑ j, g j ω • v j‖ ^ (2 : ℝ) ∂Q) ^ (1 / (2 : ℝ)) := by
  have h := (source_finite_comparison_paper v ξ hξ hcent 1 zero_le_one hcov g hgm hind hgl 2
    (by norm_num)).2.2
  simpa using h

/-- Consumer of `tube_half_action_paper`: for `J = 0` both sides are `0`. -/
private theorem audit_consumer_half {H : Type} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    [CompleteSpace H] :
    (⨆ (r : ℝ) (_ : 0 ≤ r), ((ballSup (fun _ : H => (0 : ℝ)) r - r ^ 2 / 2 : ℝ) : EReal)) =
      ⨆ h : H, (((0 : ℝ) - ‖h‖ ^ 2 / 2 : ℝ) : EReal) :=
  tube_half_action_paper (fun _ : H => (0 : ℝ)) fun _ _ => ⟨0, by
    rintro _ ⟨_, _, rfl⟩
    exact le_rfl⟩

/-- Consumer of the two transfer wrappers: under either case, `E e^{F(X)/δ}` is
bounded by `e^{c/δ}` whenever `F ≤ c` on the tubes (take `G = c`). -/
private theorem audit_consumer_transfer_zero {Ω : Type} [MeasurableSpace Ω] {P : Measure Ω}
    [IsProbabilityMeasure P] (X : Ω → ℝ) (hX0 : ∀ᵐ ω ∂P, X ω = 0) (F : ℝ → ℝ)
    (hF : Measurable F) (c : ℝ) (hc : F 0 ≤ c) :
    ∫⁻ ω, ENNReal.ofReal (Real.exp (F (X ω) / (1 / 2))) ∂P ≤
      ENNReal.ofReal (Real.exp (c / (1 / 2))) := by
  have h := tube_rayleigh_transfer_zero_paper X hX0 (1 / 2) (by norm_num) (by norm_num) F hF
    (fun _ => c) measurable_const (fun _ _ _ _ _ => le_rfl) hc
  refine h.trans (le_of_eq ?_)
  rw [← mul_one (ENNReal.ofReal (Real.exp (c / (1 / 2)))),
    ← lintegral_rayleigh_one (δ := 1 / 2) (by norm_num),
    ← lintegral_const_mul _ (measurable_rayleighDensity _).ennreal_ofReal]
  refine setLIntegral_congr_fun measurableSet_Ioi fun r hr => ?_
  simp only [rayleighDensity]
  rw [← ENNReal.ofReal_mul (Real.exp_pos _).le]
  congr 1
  rw [mul_left_comm, ← Real.exp_add]
  congr 2
  ring

/-- Consumer of `tube_rayleigh_transfer_paper` (nonzero law): the bound with the
constant `G = c`. -/
private theorem audit_consumer_transfer {𝔅 H Ω : Type} [NormedAddCommGroup 𝔅]
    [NormedSpace ℝ 𝔅] [CompleteSpace 𝔅] [MeasurableSpace 𝔅] [BorelSpace 𝔅]
    [TopologicalSpace.SeparableSpace 𝔅] [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    [CompleteSpace H] [TopologicalSpace.SeparableSpace H] [MeasurableSpace Ω]
    {P : Measure Ω} [IsProbabilityMeasure P] (M : H →L[ℝ] 𝔅) (hM : IsCompactOperator M)
    (X : Ω → 𝔅) (hX : AEMeasurable X P) (hX2 : MemLp X 2 P) (hlaw : ¬ ∀ᵐ ω ∂P, X ω = 0)
    (hAtt : TubeAttained (paperTube P X M))
    (hTail : TubeTail P X (paperTube P X M) (1 / 2)) (F : 𝔅 → ℝ) (hF : Measurable F) (c : ℝ)
    (hFc : ∀ x, F x ≤ c) :
    ∫⁻ ω, ENNReal.ofReal (Real.exp (F (X ω) / (1 / 2))) ∂P ≤
      ∫⁻ r in Ioi 0, ENNReal.ofReal (r / (1 / 2) * Real.exp ((c - r ^ 2 / 2) / (1 / 2))) :=
  tube_rayleigh_transfer_paper M hM (1 / 2) (by norm_num) (by norm_num) X hX hX2 hlaw hAtt hTail
    F hF (fun _ => c) measurable_const (fun _ _ _ _ _ => le_rfl) fun _ _ x _ => hFc x

