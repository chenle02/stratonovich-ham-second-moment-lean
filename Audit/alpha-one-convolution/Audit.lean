open MeasureTheory StratonovichHAMSecondMoment

namespace StratonovichHAMSecondMoment.Audit.AlphaOneConvolution

open StratonovichHAMSecondMoment.AlphaOneConvolution

/-- Consumer of the wrapper: under `H:homog` with `α = 1` and the two named inputs,
the smoothed pairing is bounded by `πV/2` for `ε = η = 1`, `h = 1`, `z = 0`. -/
private theorem audit_consumer {d : ℕ} {alpha0 : ℝ} {Γ μ : Measure (HomogHypothesis.Rd d)}
    (hH : HomogHypothesis.HomogCovariance d 1 alpha0 Γ μ) (hpair : SpectralPairing Γ μ)
    (hG : WaveGreenFourier d) :
    ∫ y, VariationalDilation.conv Γ (VariationalMean.heatK 1) (y + 0)
        ∂(LowAlphaConvolution.smoothedGreen (WaveGreen.waveGreen d) 1 1) ≤
      Real.pi * (μ (Metric.closedBall 0 1)).toReal / 2 :=
  ((alpha_one_convolution_paper hH hpair hG).2 1 one_pos 1 one_pos 1 zero_le_one 0).2.2.2.2.2

#check @audit_consumer
#print axioms audit_consumer

end StratonovichHAMSecondMoment.Audit.AlphaOneConvolution
