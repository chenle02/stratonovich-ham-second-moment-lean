/-- Consumer: `0 ≤ Ψ_a(r,v) ≤ r^{-a}`. -/
private theorem psi_consumer (a r v : ℝ) (ha : 0 < a) (hr : 0 < r) (hv : 0 ≤ v) :
    0 ≤ StratonovichHAMSecondMoment.TimeFractional.Psi a r v ∧
      StratonovichHAMSecondMoment.TimeFractional.Psi a r v ≤ r ^ (-a) := by
  obtain ⟨-, h0, -, h1⟩ :=
    StratonovichHAMSecondMoment.TimeFractional.Psi_properties_paper a r v v ha hr hv le_rfl
  exact ⟨h0, h1⟩
#check @psi_consumer
#print axioms psi_consumer
example : StratonovichHAMSecondMoment.TimeFractional.Psi (1 / 2) 1 0 = 1 := by
  rw [StratonovichHAMSecondMoment.TimeFractional.Psi_zero _ _ (by norm_num) one_pos,
    Real.one_rpow]
