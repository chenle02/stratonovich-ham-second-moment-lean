/-- The capped kernel is finite at positive width (`κ_δ(u) ≤ κ_δ(0) < ∞`). -/
theorem kerA_capSet_ne_top (hH : HomogCovariance d alpha α₀ Γ μ) {δ : ℝ} (hδ : 0 < δ) (u : ℝ) :
