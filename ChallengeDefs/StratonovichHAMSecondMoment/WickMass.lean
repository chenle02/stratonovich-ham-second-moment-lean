/-! ### The pair product lower bound -/

/-- The constant `κ₀ = Γ(α₀)⁻¹ δ^{α₀}`, `δ = 1/(2k)`. -/
def kappa0 (a : ℝ) (k : ℕ) : ℝ := (Real.Gamma a)⁻¹ * (1 / (2 * (k : ℝ))) ^ a

