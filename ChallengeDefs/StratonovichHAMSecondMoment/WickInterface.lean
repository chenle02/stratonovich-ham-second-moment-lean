    ∀ η : ℝ, 0 < η →
      wickF (waveGreen d) Γ α₀ (capDom fun _ : Fin (m + n) => η) ε m D T1 T2 ≤
          wickF (waveGreen d) Γ α₀ (capDom (0 : Fin (m + n) → ℝ)) ε m D T1 T2 ∧
        wickF (waveGreen d) Γ α₀ (capDom (0 : Fin (m + n) → ℝ)) ε m D T1 T2 ≠ ⊤ ∧
        wickF (waveGreen d) Γ α₀ (capDom (0 : Fin (m + n) → ℝ)) ε m D T1 T2 ≤
          wickF (waveGreen d) Γ α₀ (capDom fun _ : Fin (m + n) => η) ε m D T1 T2 +
