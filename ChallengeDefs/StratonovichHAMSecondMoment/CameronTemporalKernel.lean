/-! ### Schur kernels on `I` -/

/-- **Schur data** for a kernel `k(s,t)` on `I = (0,1)`: measurable, row and column integrals
(of `|k|`, over `I`) at most `A ≥ 0` for every `s` (resp. `t`) in `I`. -/
structure SchurKernel (k : ℝ × ℝ → ℝ) (A : ℝ) : Prop where
  meas : Measurable k
  nonneg : 0 ≤ A
  row : ∀ s ∈ Ioo (0 : ℝ) 1, ∫⁻ t, ‖k (s, t)‖ₑ ∂timeMeasure ≤ ENNReal.ofReal A
  col : ∀ t ∈ Ioo (0 : ℝ) 1, ∫⁻ s, ‖k (s, t)‖ₑ ∂timeMeasure ≤ ENNReal.ofReal A

variable {k : ℝ × ℝ → ℝ} {A : ℝ}

/-- Auxiliary: `x^{1/2} (x y²)^{1/2} = x y` in `ℝ≥0∞`. -/
theorem sqrt_mul_sqrt_ennreal (x y : ℝ≥0∞) :
    x ^ (1 / 2 : ℝ) * (x * y ^ (2 : ℝ)) ^ (1 / 2 : ℝ) = x * y := by
  rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num), ← ENNReal.rpow_mul, ← mul_assoc,
    ← ENNReal.rpow_add_of_nonneg _ _ (by norm_num) (by norm_num)]
  norm_num

/-- **Schur's test in `ℝ≥0∞` form** (TeX line 249): for a Schur kernel and `g ≥ 0`,
`∫_I (∫_I |k(s,t)| g(t) dt)² ds ≤ A² ∫_I g²`.  Cauchy-Schwarz in `t` against the row integral,
then Tonelli and the column integral. -/
theorem schur_sq (hk : SchurKernel k A) (g : ℝ → ℝ≥0∞) (hg : AEMeasurable g timeMeasure) :
    ∫⁻ s, (∫⁻ t, ‖k (s, t)‖ₑ * g t ∂timeMeasure) ^ (2 : ℝ) ∂timeMeasure ≤
      ENNReal.ofReal A ^ (2 : ℝ) * ∫⁻ t, g t ^ (2 : ℝ) ∂timeMeasure := by
  set μ := timeMeasure
  set Ae := ENNReal.ofReal A
  have hkm : Measurable fun p : ℝ × ℝ => ‖k p‖ₑ := hk.meas.enorm
  have hrow : ∀ s ∈ Ioo (0 : ℝ) 1, (∫⁻ t, ‖k (s, t)‖ₑ * g t ∂μ) ^ (2 : ℝ) ≤
      Ae * ∫⁻ t, ‖k (s, t)‖ₑ * g t ^ (2 : ℝ) ∂μ := by
    intro s hs
    have hks : Measurable fun t => ‖k (s, t)‖ₑ := hkm.comp (measurable_const.prodMk measurable_id)
    have hH0 := ENNReal.lintegral_mul_norm_pow_le (μ := μ) hks.aemeasurable
      (hks.aemeasurable.mul (hg.pow_const (2 : ℝ))) (p := 1 / 2) (q := 1 / 2)
      (by norm_num) (by norm_num) (by norm_num)
    have hH : ∫⁻ t, ‖k (s, t)‖ₑ * g t ∂μ ≤ (∫⁻ t, ‖k (s, t)‖ₑ ∂μ) ^ (1 / 2 : ℝ) *
        (∫⁻ t, ‖k (s, t)‖ₑ * g t ^ (2 : ℝ) ∂μ) ^ (1 / 2 : ℝ) := by
      refine le_of_eq_of_le (lintegral_congr fun t => ?_) hH0
      simp only [Pi.mul_apply]
      exact (sqrt_mul_sqrt_ennreal _ _).symm
    calc (∫⁻ t, ‖k (s, t)‖ₑ * g t ∂μ) ^ (2 : ℝ)
        ≤ ((∫⁻ t, ‖k (s, t)‖ₑ ∂μ) ^ (1 / 2 : ℝ) *
            (∫⁻ t, ‖k (s, t)‖ₑ * g t ^ (2 : ℝ) ∂μ) ^ (1 / 2 : ℝ)) ^ (2 : ℝ) :=
          ENNReal.rpow_le_rpow hH (by norm_num)
      _ = (∫⁻ t, ‖k (s, t)‖ₑ ∂μ) * ∫⁻ t, ‖k (s, t)‖ₑ * g t ^ (2 : ℝ) ∂μ := by
          rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num), ← ENNReal.rpow_mul,
            ← ENNReal.rpow_mul]
          norm_num
      _ ≤ Ae * ∫⁻ t, ‖k (s, t)‖ₑ * g t ^ (2 : ℝ) ∂μ := by gcongr; exact hk.row s hs
  have hprod : AEMeasurable (Function.uncurry fun s t => ‖k (s, t)‖ₑ * g t ^ (2 : ℝ))
      (μ.prod μ) := hkm.aemeasurable.mul (hg.pow_const (2 : ℝ)).comp_snd
  calc ∫⁻ s, (∫⁻ t, ‖k (s, t)‖ₑ * g t ∂μ) ^ (2 : ℝ) ∂μ
      ≤ ∫⁻ s, Ae * ∫⁻ t, ‖k (s, t)‖ₑ * g t ^ (2 : ℝ) ∂μ ∂μ := by
        refine lintegral_mono_ae ?_
        filter_upwards [ae_restrict_mem measurableSet_Ioo] with s hs
        exact hrow s hs
    _ = Ae * ∫⁻ t, (∫⁻ s, ‖k (s, t)‖ₑ ∂μ) * g t ^ (2 : ℝ) ∂μ := by
        rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top, lintegral_lintegral_swap hprod]
        congr 1
        refine lintegral_congr fun t => ?_
        exact lintegral_mul_const _ (hkm.comp (measurable_id.prodMk measurable_const))
    _ ≤ Ae * ∫⁻ t, Ae * g t ^ (2 : ℝ) ∂μ := by
        gcongr Ae * ?_
        refine lintegral_mono_ae ?_
        filter_upwards [ae_restrict_mem measurableSet_Ioo] with t ht
        gcongr
        exact hk.col t ht
    _ = Ae ^ (2 : ℝ) * ∫⁻ t, g t ^ (2 : ℝ) ∂μ := by
        rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top, ← mul_assoc, ENNReal.rpow_two, sq]

/-- The kernel transform `(T_k f)(s) = ∫_I k(s,t) f(t) dt` (B1's `L²`-kernel form). -/
def kfun (k : ℝ × ℝ → ℝ) (f : ℝ → ℝ) (s : ℝ) : ℝ := ∫ t, k (s, t) * f t ∂timeMeasure

/-- Auxiliary: the `ℝ≥0∞` majorant `∫ |k(s,t)| |f(t)| dt` is square integrable. -/
theorem lintegral_majorant_sq_lt (hk : SchurKernel k A) {f : ℝ → ℝ} (hf : MemLp f 2 timeMeasure) :
    ∫⁻ s, (∫⁻ t, ‖k (s, t)‖ₑ * ‖f t‖ₑ ∂timeMeasure) ^ (2 : ℝ) ∂timeMeasure < ⊤ := by
  refine (schur_sq hk _ hf.aestronglyMeasurable.enorm).trans_lt ?_
  refine ENNReal.mul_lt_top (ENNReal.rpow_lt_top_of_nonneg (by norm_num) ENNReal.ofReal_ne_top) ?_
  have := hf.eLpNorm_lt_top
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by norm_num) (by norm_num) hf.aestronglyMeasurable]
    at this
  simp only [ENNReal.toReal_ofNat] at this
  exact (ENNReal.rpow_lt_top_iff_of_pos (by norm_num)).mp this

/-- Auxiliary: the majorant is a.e.-measurable in `s`. -/
theorem aemeasurable_majorant (hk : SchurKernel k A) {f : ℝ → ℝ}
    (hf : AEStronglyMeasurable f timeMeasure) :
    AEMeasurable (fun s => ∫⁻ t, ‖k (s, t)‖ₑ * ‖f t‖ₑ ∂timeMeasure) timeMeasure :=
  (hk.meas.enorm.aemeasurable.mul hf.enorm.comp_snd).lintegral_prod_right'

/-- Auxiliary: for a.e. `s ∈ I`, `t ↦ k(s,t) f(t)` is integrable. -/
theorem ae_integrable_kfun (hk : SchurKernel k A) {f : ℝ → ℝ} (hf : MemLp f 2 timeMeasure) :
    ∀ᵐ s ∂timeMeasure, Integrable (fun t => k (s, t) * f t) timeMeasure := by
  have hlt := ae_lt_top' ((aemeasurable_majorant hk hf.aestronglyMeasurable).pow_const (2 : ℝ))
    (lintegral_majorant_sq_lt hk hf).ne
  filter_upwards [hlt] with s hs
  refine ⟨((hk.meas.comp (measurable_const.prodMk measurable_id)).aestronglyMeasurable.mul
    hf.aestronglyMeasurable), ?_⟩
  have h2 : ∫⁻ t, ‖k (s, t)‖ₑ * ‖f t‖ₑ ∂timeMeasure < ⊤ :=
    (ENNReal.rpow_lt_top_iff_of_pos (by norm_num)).mp hs
  simpa [HasFiniteIntegral, enorm_mul] using h2

/-- Auxiliary: `‖(T_k f)(s)‖ₑ ≤ ∫ |k(s,t)| |f(t)| dt`. -/
theorem enorm_kfun_le (f : ℝ → ℝ) (s : ℝ) :
    ‖kfun k f s‖ₑ ≤ ∫⁻ t, ‖k (s, t)‖ₑ * ‖f t‖ₑ ∂timeMeasure := by
  refine (enorm_integral_le_lintegral_enorm _).trans (le_of_eq ?_)
  simp only [enorm_mul]

/-- **Schur's bound on `L²(I)`**: `T_k f ∈ L²(I)` with `‖T_k f‖₂ ≤ A ‖f‖₂`. -/
theorem memLp_kfun (hk : SchurKernel k A) {f : ℝ → ℝ} (hf : MemLp f 2 timeMeasure) :
    MemLp (kfun k f) 2 timeMeasure ∧
      eLpNorm (kfun k f) 2 timeMeasure ≤ ENNReal.ofReal A * eLpNorm f 2 timeMeasure := by
  have hm : AEStronglyMeasurable (kfun k f) timeMeasure :=
    ((hk.meas.aestronglyMeasurable (μ := timeMeasure.prod timeMeasure)).mul
      hf.aestronglyMeasurable.comp_snd).integral_prod_right'
  have hle : eLpNorm (kfun k f) 2 timeMeasure ≤ ENNReal.ofReal A * eLpNorm f 2 timeMeasure := by
    rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by norm_num) (by norm_num) hm,
      eLpNorm_eq_lintegral_rpow_enorm_toReal (by norm_num) (by norm_num) hf.aestronglyMeasurable]
    simp only [ENNReal.toReal_ofNat]
    calc (∫⁻ s, ‖kfun k f s‖ₑ ^ (2 : ℝ) ∂timeMeasure) ^ (1 / 2 : ℝ)
        ≤ (ENNReal.ofReal A ^ (2 : ℝ) * ∫⁻ t, ‖f t‖ₑ ^ (2 : ℝ) ∂timeMeasure) ^ (1 / 2 : ℝ) := by
          gcongr
          calc ∫⁻ s, ‖kfun k f s‖ₑ ^ (2 : ℝ) ∂timeMeasure
              ≤ ∫⁻ s, (∫⁻ t, ‖k (s, t)‖ₑ * ‖f t‖ₑ ∂timeMeasure) ^ (2 : ℝ) ∂timeMeasure :=
                lintegral_mono fun s => ENNReal.rpow_le_rpow (enorm_kfun_le f s) (by norm_num)
            _ ≤ _ := schur_sq hk _ hf.aestronglyMeasurable.enorm
      _ = ENNReal.ofReal A * (∫⁻ t, ‖f t‖ₑ ^ (2 : ℝ) ∂timeMeasure) ^ (1 / 2 : ℝ) := by
          rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num), ← ENNReal.rpow_mul]
          norm_num
  exact ⟨hle.trans_lt (ENNReal.mul_lt_top ENNReal.ofReal_lt_top hf.eLpNorm_lt_top), hle⟩

/-- Auxiliary: `T_k` respects a.e. equality on `I` (pointwise in `s`). -/
theorem kfun_congr {f g : ℝ → ℝ} (h : f =ᵐ[timeMeasure] g) (s : ℝ) : kfun k f s = kfun k g s :=
  integral_congr_ae (h.mono fun t ht => by simp only [ht])

/-- Auxiliary: the linear map `f ↦ T_k f` on `L²(I)`. -/
def kOpL (hk : SchurKernel k A) : L2I →ₗ[ℝ] L2I where
  toFun f := (memLp_kfun hk (Lp.memLp f)).1.toLp _
  map_add' f g := by
    apply Lp.ext
    filter_upwards [(memLp_kfun hk (Lp.memLp (f + g))).1.coeFn_toLp,
      Lp.coeFn_add ((memLp_kfun hk (Lp.memLp f)).1.toLp _) ((memLp_kfun hk (Lp.memLp g)).1.toLp _),
      (memLp_kfun hk (Lp.memLp f)).1.coeFn_toLp, (memLp_kfun hk (Lp.memLp g)).1.coeFn_toLp,
      ae_integrable_kfun hk (Lp.memLp f), ae_integrable_kfun hk (Lp.memLp g)]
      with s h1 h2 h3 h4 hif hig
    rw [h1, h2, Pi.add_apply, h3, h4, kfun_congr (Lp.coeFn_add f g), kfun, kfun, kfun,
      ← integral_add hif hig]
    simp only [Pi.add_apply, mul_add]
  map_smul' c f := by
    apply Lp.ext
    filter_upwards [(memLp_kfun hk (Lp.memLp (c • f))).1.coeFn_toLp,
      Lp.coeFn_smul c ((memLp_kfun hk (Lp.memLp f)).1.toLp _),
      (memLp_kfun hk (Lp.memLp f)).1.coeFn_toLp] with s h1 h2 h3
    rw [h1, RingHom.id_apply, h2, Pi.smul_apply, h3, kfun_congr (Lp.coeFn_smul c f), kfun, kfun,
      smul_eq_mul, ← integral_const_mul]
    simp only [Pi.smul_apply, smul_eq_mul]
    congr 1
    funext t
    ring

/-- Auxiliary: `‖T_k f‖ ≤ A ‖f‖`. -/
theorem norm_kOpL_le (hk : SchurKernel k A) (f : L2I) : ‖kOpL hk f‖ ≤ A * ‖f‖ := by
  change ‖(memLp_kfun hk (Lp.memLp f)).1.toLp _‖ ≤ A * ‖f‖
  rw [Lp.norm_toLp, Lp.norm_def, ← ENNReal.toReal_ofReal hk.nonneg, ← ENNReal.toReal_mul]
  exact ENNReal.toReal_mono (ENNReal.mul_ne_top ENNReal.ofReal_ne_top (Lp.eLpNorm_ne_top f))
    (memLp_kfun hk (Lp.memLp f)).2

/-- **The Schur kernel operator** on `L²(I)`: `(T_k f)(s) = ∫_I k(s,t) f(t) dt`, of norm at most
`A` (TeX line 249). -/
def kOp (hk : SchurKernel k A) : L2I →L[ℝ] L2I := (kOpL hk).mkContinuous A (norm_kOpL_le hk)

/-- The defining formula of `kOp` (B1's `L²`-kernel form). -/
theorem kOp_ae (hk : SchurKernel k A) (f : L2I) :
    (kOp hk f : ℝ → ℝ) =ᵐ[timeMeasure] fun x => ∫ y, k (x, y) * f y ∂timeMeasure :=
  (memLp_kfun hk (Lp.memLp f)).1.coeFn_toLp

/-! ### The operator `K` -/

/-- Auxiliary: `|s-t|^{-a}` (with `0 ≤ a < 1`) is a Schur kernel with constant `K_0 = 2^a/(1-a)`. -/
theorem schurKernel_kern {a : ℝ} (ha0 : 0 ≤ a) (ha1 : a < 1) :
    SchurKernel (fun p => kern a (p.1 - p.2)) (K0 a) where
  meas := (measurable_kern a).comp (measurable_fst.sub measurable_snd)
  nonneg := (K0_pos ha1).le
  row s hs := by
    simp_rw [Real.enorm_of_nonneg (kern_nonneg _ _)]
    exact OccupationCeilingFinite.row_le ha0 ha1 (Ioo_subset_Icc_self hs)
  col t ht := by
    simp_rw [Real.enorm_of_nonneg (kern_nonneg _ _), kern_sub_comm a _ t]
    exact OccupationCeilingFinite.row_le ha0 ha1 (Ioo_subset_Icc_self ht)

/-- **The operator `K`** of `P:cameron-temporal-map` (TeX line 227): the Schur operator with
kernel `|s-t|^{-a}`. -/
def kOpK (p : TParams) : L2I →L[ℝ] L2I := kOp (schurKernel_kern p.ha0.le p.ha1)

/-- `K` has kernel `|s-t|^{-a}` (`IsTimeKernelOp`). -/
theorem isTimeKernelOp_kOpK (p : TParams) : IsTimeKernelOp p (kOpK p) := fun f =>
  kOp_ae (schurKernel_kern p.ha0.le p.ha1) f

/-- Auxiliary: the `L²(I)` inner product of real classes. -/
theorem inner_L2I (f g : L2I) : ⟪f, g⟫ = ∫ s, f s * g s ∂timeMeasure := by
  rw [MeasureTheory.L2.inner_def]
  refine integral_congr_ae (ae_of_all _ fun s => ?_)
  simp only [RCLike.inner_apply, conj_trivial]
  ring

/-- **The form of `K`** (TeX lines 249-256): for every operator with kernel `|s-t|^{-a}`,
`⟪K f, g⟫ = ∫∫_{I²} |s-t|^{-a} g(s) f(t) ds dt` (`kform a g f`). -/
theorem inner_K_eq_kform {p : TParams} {K : L2I →L[ℝ] L2I} (hK : IsTimeKernelOp p K)
    (f g : L2I) : ⟪K f, g⟫ = kform p.a (g : ℝ → ℝ) (f : ℝ → ℝ) := by
  rw [inner_L2I, OccupationCompletion.kform,
    integral_prod _ (kform_integrable (G := ℝ) p.ha0.le p.ha1 (Lp.memLp g) (Lp.memLp f))]
  refine integral_congr_ae ?_
  filter_upwards [hK f] with s hs
  rw [hs, kMean, mul_comm, ← integral_const_mul]
  refine integral_congr_ae (ae_of_all _ fun t => ?_)
  simp only [RCLike.inner_apply, conj_trivial]
  ring

/-! ### Strict positivity and injectivity (TeX lines 249-259) -/

open TimeCompletion (mixWeight mixProfile mixMeasure measurable_mixWeight measurable_mixProfile mixWeight_nonneg mixProfile_nonneg)

/-- Auxiliary: on `I²`, `|s-t|^{-a}` is a.e. the Gamma-subordination mixture of products. -/
theorem kern_mixture_ae {a : ℝ} (ha0 : 0 < a) :
    ∀ᵐ q ∂(timeMeasure.prod timeMeasure), ENNReal.ofReal (kern a (q.1 - q.2)) =
      ∫⁻ w, ENNReal.ofReal (mixWeight a w * mixProfile w q.1 * mixProfile w q.2) ∂mixMeasure := by
  rw [timeMeasure_eq_Icc]
  filter_upwards [TimeCompletion.ae_ne_diag 1] with q hq
  exact TimeCompletion.kern_eq_mixture a ha0 q.1 q.2 hq

/-- **The form as an integral of squares** (TeX lines 251-258, Lean route): for real
`f ∈ L²(I)`, `∫∫ |s-t|^{-a} f(s) f(t) = ∫ ρ(w) (∫_I φ_w f)² dw` over `w = (λ,u) ∈ (0,∞) × ℝ`,
`ρ(w) = Γ(a)⁻¹ 2λ^a`, `φ_w(t) = 1_{u ≤ t} e^{-λ(t-u)}`; the right side is integrable. -/
theorem kform_eq_mixture {a : ℝ} (ha0 : 0 < a) (ha1 : a < 1) {f : ℝ → ℝ}
    (hf : MemLp f 2 timeMeasure) :
    Integrable (fun w => mixWeight a w * (∫ t, mixProfile w t * f t ∂timeMeasure) ^ 2)
        mixMeasure ∧
      kform a f f =
        ∫ w, mixWeight a w * (∫ t, mixProfile w t * f t ∂timeMeasure) ^ 2 ∂mixMeasure := by
  have hkm : Measurable fun q : (ℝ × ℝ) × (ℝ × ℝ) =>
      mixWeight a q.2 * mixProfile q.2 q.1.1 * mixProfile q.2 q.1.2 := by
    have h1 : Measurable fun q : (ℝ × ℝ) × (ℝ × ℝ) => mixProfile q.2 q.1.1 :=
      measurable_mixProfile.comp (measurable_snd.prodMk (measurable_fst.comp measurable_fst))
    have h2 : Measurable fun q : (ℝ × ℝ) × (ℝ × ℝ) => mixProfile q.2 q.1.2 :=
      measurable_mixProfile.comp (measurable_snd.prodMk (measurable_snd.comp measurable_fst))
    exact (((measurable_mixWeight a).comp measurable_snd).mul h1).mul h2
  have hknn : ∀ q : (ℝ × ℝ) × (ℝ × ℝ),
      0 ≤ mixWeight a q.2 * mixProfile q.2 q.1.1 * mixProfile q.2 q.1.2 := fun q =>
    mul_nonneg (mul_nonneg (mixWeight_nonneg a ha0 _) (mixProfile_nonneg _ _))
      (mixProfile_nonneg _ _)
  set F : (ℝ × ℝ) × (ℝ × ℝ) → ℝ := fun q =>
    mixWeight a q.2 * mixProfile q.2 q.1.1 * mixProfile q.2 q.1.2 * (f q.1.1 * f q.1.2) with hFdef
  have hf1 : AEStronglyMeasurable (fun q : (ℝ × ℝ) × (ℝ × ℝ) => f q.1.1) ((timeMeasure.prod timeMeasure).prod mixMeasure) :=
    hf.aestronglyMeasurable.comp_fst.comp_fst
  have hf2 : AEStronglyMeasurable (fun q : (ℝ × ℝ) × (ℝ × ℝ) => f q.1.2) ((timeMeasure.prod timeMeasure).prod mixMeasure) :=
    hf.aestronglyMeasurable.comp_snd.comp_fst
  have hFm : AEStronglyMeasurable F ((timeMeasure.prod timeMeasure).prod mixMeasure) := hkm.aestronglyMeasurable.mul (hf1.mul hf2)
  have hK := kern_mixture_ae (a := a) ha0
  have hsec : ∀ᵐ q ∂(timeMeasure.prod timeMeasure), ∫ w, F (q, w) ∂mixMeasure = kern a (q.1 - q.2) * (f q.1 * f q.2) := by
    filter_upwards [hK] with q hq
    have hmw : Measurable fun w => mixWeight a w * mixProfile w q.1 * mixProfile w q.2 :=
      hkm.comp (measurable_const.prodMk measurable_id)
    have hKr : ∫ w, mixWeight a w * mixProfile w q.1 * mixProfile w q.2 ∂mixMeasure = kern a (q.1 - q.2) := by
      rw [integral_eq_lintegral_of_nonneg_ae (ae_of_all _ fun w => hknn (q, w))
        hmw.aestronglyMeasurable, ← hq, ENNReal.toReal_ofReal (kern_nonneg _ _)]
    simp only [hFdef]
    rw [integral_mul_const, hKr]
  have hint : Integrable (fun q : ℝ × ℝ => kern a (q.1 - q.2) * (‖f q.1‖ * ‖f q.2‖)) (timeMeasure.prod timeMeasure) :=
    (kform_integrable (G := ℝ) ha0.le ha1 hf.norm hf.norm).congr (ae_of_all _ fun q => by
      simp only [RCLike.inner_apply, conj_trivial]
      ring)
  have hFi : Integrable F ((timeMeasure.prod timeMeasure).prod mixMeasure) := by
    refine ⟨hFm, ?_⟩
    have hle : ∀ q : (ℝ × ℝ) × (ℝ × ℝ), ‖F q‖ₑ = ENNReal.ofReal
        (mixWeight a q.2 * mixProfile q.2 q.1.1 * mixProfile q.2 q.1.2) *
          (‖f q.1.1‖ₑ * ‖f q.1.2‖ₑ) := by
      intro q
      show ‖(mixWeight a q.2 * mixProfile q.2 q.1.1 * mixProfile q.2 q.1.2) *
        (f q.1.1 * f q.1.2)‖ₑ = _
      rw [enorm_mul, Real.enorm_of_nonneg (hknn q), enorm_mul]
    have hm2 : AEMeasurable (fun q : (ℝ × ℝ) × (ℝ × ℝ) => ENNReal.ofReal
        (mixWeight a q.2 * mixProfile q.2 q.1.1 * mixProfile q.2 q.1.2) *
          (‖f q.1.1‖ₑ * ‖f q.1.2‖ₑ)) ((timeMeasure.prod timeMeasure).prod mixMeasure) :=
      (ENNReal.measurable_ofReal.comp hkm).aemeasurable.mul (hf1.enorm.mul hf2.enorm)
    show ∫⁻ q, ‖F q‖ₑ ∂((timeMeasure.prod timeMeasure).prod mixMeasure) < ⊤
    rw [lintegral_congr hle, lintegral_prod _ hm2]
    have heq : ∀ᵐ q ∂(timeMeasure.prod timeMeasure), ∫⁻ w, ENNReal.ofReal (mixWeight a w * mixProfile w q.1 * mixProfile w q.2) *
        (‖f q.1‖ₑ * ‖f q.2‖ₑ) ∂mixMeasure = ‖kern a (q.1 - q.2) * (‖f q.1‖ * ‖f q.2‖)‖ₑ := by
      filter_upwards [hK] with q hq
      have hmw : Measurable fun w => ENNReal.ofReal (mixWeight a w * mixProfile w q.1 *
          mixProfile w q.2) :=
        (hkm.comp (measurable_const.prodMk measurable_id :
          Measurable fun w : ℝ × ℝ => (q, w))).ennreal_ofReal
      rw [lintegral_mul_const _ hmw, ← hq, enorm_mul, enorm_mul,
        Real.enorm_of_nonneg (kern_nonneg a (q.1 - q.2)), enorm_norm, enorm_norm]
    rw [lintegral_congr_ae heq]
    exact hint.2
  have hinner : ∀ w, ∫ q, F (q, w) ∂(timeMeasure.prod timeMeasure) =
      mixWeight a w * (∫ t, mixProfile w t * f t ∂timeMeasure) ^ 2 := by
    intro w
    have hpt : ∀ q : ℝ × ℝ, F (q, w) = mixWeight a w *
        ((mixProfile w q.1 * f q.1) * (mixProfile w q.2 * f q.2)) := by
      intro q; simp only [hFdef]; ring
    simp_rw [hpt]
    rw [integral_const_mul, integral_prod_mul (fun t => mixProfile w t * f t)
      (fun t => mixProfile w t * f t), sq]
  refine ⟨(hFi.integral_prod_right).congr (ae_of_all _ hinner), ?_⟩
  have hk : kform a f f = ∫ q, kern a (q.1 - q.2) * (f q.1 * f q.2) ∂(timeMeasure.prod timeMeasure) := by
    unfold kform
    refine integral_congr_ae (ae_of_all _ fun q => ?_)
    simp only [RCLike.inner_apply, conj_trivial]
    ring
  rw [hk, integral_congr_ae (Filter.EventuallyEq.symm hsec), integral_integral_swap hFi]
  exact integral_congr_ae (ae_of_all _ hinner)

/-- Auxiliary (the last step of the injectivity argument): if `λ > 0` and
`∫_I 1_{u ≤ t} e^{-λ(t-u)} f(t) dt = 0` for a.e. `u`, then `f = 0` a.e. on `I`.  The tail
integrals `u ↦ ∫_{t ≥ u} e^{-λ t} f(t) dt` are continuous, so they vanish for every `u`; the
half-lines `[u,∞)` form a π-system generating the Borel sets. -/
theorem eq_zero_of_mixProfile {l : ℝ} (hl : 0 < l) {f : ℝ → ℝ} (hf : MemLp f 2 timeMeasure)
    (h : ∀ᵐ u, ∫ t, mixProfile (l, u) t * f t ∂timeMeasure = 0) : f =ᵐ[timeMeasure] 0 := by
  set I : Set ℝ := Ioo (0 : ℝ) 1
  set φ : ℝ → ℝ := fun t => Real.exp (-(l * t)) * f t with hφ
  set g : ℝ → ℝ := I.indicator φ with hg
  have hfi : Integrable f timeMeasure := hf.integrable one_le_two
  have hgi : Integrable g := by
    rw [hg, integrable_indicator_iff measurableSet_Ioo]
    have hem : Measurable fun t : ℝ => Real.exp (-(l * t)) := by fun_prop
    refine hfi.norm.mono' (hem.aestronglyMeasurable.mul hfi.aestronglyMeasurable) ?_
    filter_upwards [ae_restrict_mem measurableSet_Ioo] with t ht
    simp only [hφ, norm_mul, Real.norm_of_nonneg (Real.exp_pos _).le]
    refine mul_le_of_le_one_left (norm_nonneg _) (Real.exp_le_one_iff.2 ?_)
    have : 0 ≤ l * t := mul_nonneg hl.le ht.1.le
    linarith
  have hprof : ∀ u t, mixProfile (l, u) t * f t = Real.exp (l * u) * (Ici u).indicator φ t := by
    intro u t
    by_cases hut : u ≤ t
    · simp only [mixProfile, hut, ite_true, indicator_of_mem (show t ∈ Ici u from hut), hφ]
      rw [← mul_assoc, ← Real.exp_add]
      congr 2
      ring
    · simp only [mixProfile, hut, ite_false, indicator_of_notMem (show t ∉ Ici u from hut),
        zero_mul, mul_zero]
  set H : ℝ → ℝ := fun u => ∫ t, (Ici u).indicator g t with hH
  have hXH : ∀ u, ∫ t, mixProfile (l, u) t * f t ∂timeMeasure = Real.exp (l * u) * H u := by
    intro u
    simp_rw [hprof u]
    rw [integral_const_mul]
    congr 1
    change ∫ t in I, (Ici u).indicator φ t = _
    rw [← integral_indicator measurableSet_Ioo, hH, hg]
    congr 1
    funext t
    rw [indicator_indicator, indicator_indicator, inter_comm]
  have hH0ae : ∀ᵐ u, H u = 0 := by
    filter_upwards [h] with u hu
    rw [hXH] at hu
    exact (mul_eq_zero.1 hu).resolve_left (Real.exp_pos _).ne'
  have hHc : Continuous H := by
    rw [continuous_iff_continuousAt]
    intro u₀
    refine continuousAt_of_dominated (bound := fun t => ‖g t‖) ?_ ?_ hgi.norm ?_
    · exact Eventually.of_forall fun u => hgi.aestronglyMeasurable.indicator measurableSet_Ici
    · exact Eventually.of_forall fun u => ae_of_all _ fun t => norm_indicator_le_norm_self _ _
    · have hne : ∀ᵐ t ∂(volume : Measure ℝ), t ≠ u₀ := by
        rw [ae_iff]
        simp
      filter_upwards [hne] with t ht
      rcases lt_or_gt_of_ne ht with h1 | h1
      · refine continuousAt_const.congr (f := fun _ => (0 : ℝ)) ?_
        filter_upwards [eventually_gt_nhds h1] with u hu
        exact (indicator_of_notMem (show t ∉ Ici u from fun h2 => (not_le.2 hu) h2) _).symm
      · refine continuousAt_const.congr (f := fun _ => g t) ?_
        filter_upwards [eventually_lt_nhds h1] with u hu
        exact (indicator_of_mem (show t ∈ Ici u from hu.le) _).symm
  have hH0 : ∀ u, H u = 0 := fun u =>
    congrFun ((Continuous.ae_eq_iff_eq volume hHc continuous_const).1 hH0ae) u
  have htot : ∫ t, g t = 0 := by
    have h1 : H (-1) = ∫ t, g t := by
      show ∫ t, (Ici (-1 : ℝ)).indicator g t = ∫ t, g t
      congr 1
      funext t
      by_cases ht : t ∈ Ici (-1 : ℝ)
      · rw [indicator_of_mem ht]
      · rw [indicator_of_notMem ht, hg, indicator_of_notMem]
        intro htI
        exact ht (show (-1 : ℝ) ≤ t by linarith [htI.1])
    rw [← h1, hH0]
  have hall : ∀ s (hs : MeasurableSet s), ∫ t in s, g t = 0 := by
    refine MeasurableSpace.induction_on_inter
      (BorelSpace.measurable_eq.trans (borel_eq_generateFrom_Ici ℝ)) isPiSystem_Ici ?_ ?_ ?_ ?_
    · simp
    · rintro _ ⟨u, rfl⟩
      rw [← integral_indicator measurableSet_Ici]
      exact hH0 u
    · intro t htm ht
      have := integral_add_compl htm hgi
      rw [ht, zero_add, htot] at this
      exact this
    · intro F hdisj hFm hF
      rw [integral_iUnion hFm hdisj hgi.integrableOn]
      simp [hF]
  have hg0 : g =ᵐ[volume] 0 := hgi.ae_eq_zero_of_forall_setIntegral_eq_zero fun s hs _ => hall s hs
  filter_upwards [ae_restrict_of_ae hg0, ae_restrict_mem measurableSet_Ioo] with t ht htI
  rw [Pi.zero_apply, hg, indicator_of_mem htI] at ht
  exact (mul_eq_zero.1 ht).resolve_left (Real.exp_pos _).ne'

/-- **Strict positivity of the form** (TeX lines 249-259): for real `f ∈ L²(I)` not a.e. zero,
`∫∫_{I²} |s-t|^{-a} f(s) f(t) > 0`. -/
theorem kform_pos {a : ℝ} (ha0 : 0 < a) (ha1 : a < 1) {f : ℝ → ℝ} (hf : MemLp f 2 timeMeasure)
    (hne : ¬ f =ᵐ[timeMeasure] 0) : 0 < kform a f f := by
  obtain ⟨hint, heq⟩ := kform_eq_mixture ha0 ha1 hf
  refine lt_of_le_of_ne (kform_self_nonneg (G := ℝ) ha0 ha1 hf) (fun h0 => hne ?_)
  rw [heq] at h0
  have hnn : 0 ≤ᵐ[mixMeasure] fun w => mixWeight a w *
      (∫ t, mixProfile w t * f t ∂timeMeasure) ^ 2 :=
    ae_of_all _ fun w => mul_nonneg (mixWeight_nonneg a ha0 w) (sq_nonneg _)
  have hz := (integral_eq_zero_iff_of_nonneg_ae hnn hint).1 h0.symm
  have hpos : ∀ᵐ w ∂mixMeasure, w.1 ∈ Ioi (0 : ℝ) :=
    (Measure.quasiMeasurePreserving_fst (μ := volume.restrict (Ioi (0 : ℝ)))
      (ν := (volume : Measure ℝ))).ae (ae_restrict_mem measurableSet_Ioi)
  have hX : ∀ᵐ w ∂mixMeasure, ∫ t, mixProfile w t * f t ∂timeMeasure = 0 := by
    filter_upwards [hz, hpos] with w hw hw1
    have hρ : 0 < mixWeight a w :=
      mul_pos (inv_pos.2 (Real.Gamma_pos_of_pos ha0))
        (mul_pos two_pos (Real.rpow_pos_of_pos (abs_pos.2 (ne_of_gt hw1)) _))
    simp only [Pi.zero_apply] at hw
    exact pow_eq_zero_iff two_ne_zero |>.1 ((mul_eq_zero.1 hw).resolve_left hρ.ne')
  have hX2 := Measure.ae_ae_of_ae_prod hX
  have : (ae (volume.restrict (Ioi (0 : ℝ)))).NeBot := ae_neBot.2 (by simp)
  obtain ⟨l, hl, hl0⟩ := (hX2.and (ae_restrict_mem measurableSet_Ioi)).exists
  exact eq_zero_of_mixProfile hl0 hf hl

/-- **`K` is strictly positive** (TeX line 228): `⟪K f, f⟫ > 0` for `f ≠ 0` in `L²(I)`. -/
theorem inner_pos_of_isTimeKernelOp {p : TParams} {K : L2I →L[ℝ] L2I} (hK : IsTimeKernelOp p K)
    {f : L2I} (hf : f ≠ 0) : 0 < ⟪K f, f⟫ := by
  rw [inner_K_eq_kform hK]
  exact kform_pos p.ha0 p.ha1 (Lp.memLp f) fun h => hf (Lp.eq_zero_iff_ae_eq_zero.2 h)

/-- **`K` is injective** (TeX line 228). -/
theorem injective_of_isTimeKernelOp {p : TParams} {K : L2I →L[ℝ] L2I} (hK : IsTimeKernelOp p K) :
    Function.Injective K := by
  intro f g hfg
  by_contra hne
  have h := inner_pos_of_isTimeKernelOp hK (sub_ne_zero.2 hne)
  rw [map_sub, hfg, sub_self, inner_zero_left] at h
  exact lt_irrefl _ h

/-! ### Compactness of `K` (TeX lines 260-265) -/

/-- **B1's `L²`-kernel lemma, specialized to `μ = timeMeasure`** (item L16-B1,
`CompactOperatorFoundation.isCompactOperator_of_L2_kernel`, frozen signature): an operator on
`L²(I)` given by a square-integrable kernel is compact.  Used as a hypothesis until B1 lands. -/
def L2KernelCompact : Prop :=
  ∀ (T : L2I →L[ℝ] L2I) (k : ℝ × ℝ → ℝ), MemLp k 2 (timeMeasure.prod timeMeasure) →
    (∀ f : L2I, (T f : ℝ → ℝ) =ᵐ[timeMeasure] fun x => ∫ y, k (x, y) * f y ∂timeMeasure) →
      IsCompactOperator T

/-- The truncated kernel `K_ε = |s-t|^{-a} 1_{|s-t| ≥ ε}` (TeX line 262). -/
def ktr (a ε : ℝ) (q : ℝ × ℝ) : ℝ := if ε ≤ |q.1 - q.2| then kern a (q.1 - q.2) else 0

/-- The near-diagonal remainder `|s-t|^{-a} 1_{|s-t| < ε}` (TeX line 264). -/
def kdiag (a ε : ℝ) (q : ℝ × ℝ) : ℝ := if ε ≤ |q.1 - q.2| then 0 else kern a (q.1 - q.2)

