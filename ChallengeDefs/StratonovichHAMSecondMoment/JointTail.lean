/-! ### The difference of products (TeX 1900-1903) -/

/-- The Laplace domains with one marked edge `e₀` carrying the tail `(M,∞)`. -/
def markA {N : ℕ} (e0 : Sym2 (Fin N)) (M : ℝ) : Sym2 (Fin N) → Set ℝ :=
  fun e => if e = e0 then Ioi M else Ioi 0

