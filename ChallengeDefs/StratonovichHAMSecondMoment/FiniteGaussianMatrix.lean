/-- The Gaussian matrix sum `Σ_k g_k A_k` (the manuscript's `X`, and `Y` for Hermitian `B_k`). -/
def gaussLin {ι : Type*} [Fintype ι] {a b : Type*} (A : ι → Matrix a b ℂ) (g : ι → ℝ) :
    Matrix a b ℂ := ∑ k, g k • A k

end Growth

