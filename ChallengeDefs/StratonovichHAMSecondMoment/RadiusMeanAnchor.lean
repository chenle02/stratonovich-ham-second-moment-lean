/-! ### The block partition -/

/-- The true block lengths of `S:actual-cameron-mean`: `ℓ_m = B` for `m < N`,
`ℓ_N = δ⁻¹ - N B`. -/
def ell (δ B : ℝ) (m : ℕ) : ℝ :=
  if m < ⌊1 / (δ * B)⌋₊ then B else δ⁻¹ - (⌊1 / (δ * B)⌋₊ : ℝ) * B

