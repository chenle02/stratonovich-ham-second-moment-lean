/-! ### The kernel -/

/-- The temporal kernel `|x|^{-a}` (Lean `rpow`; its value at `x = 0` is
`0 ^ (-a)`, used only on a null set). -/
def kern (a x : ℝ) : ℝ := |x| ^ (-a)

/-- Auxiliary: the kernel is nonnegative. -/
theorem kern_nonneg (a x : ℝ) : 0 ≤ kern a x :=
  Real.rpow_nonneg (abs_nonneg x) _

/-- Auxiliary: `|x-y|^{-a} = |y-x|^{-a}`. -/
theorem kern_sub_comm (a x y : ℝ) : kern a (x - y) = kern a (y - x) := by
  simp [kern, abs_sub_comm]

/-- Auxiliary: the kernel is measurable. -/
theorem measurable_kern (a : ℝ) : Measurable (kern a) := by
  unfold kern
  fun_prop

/-- Auxiliary to the Lean proof route: `|y|^r` is interval integrable for
`r > -1` on every interval. -/
theorem intervalIntegrable_abs_rpow {r : ℝ} (hr : -1 < r) (u v : ℝ) :
    IntervalIntegrable (fun y : ℝ => |y| ^ r) volume u v := by
  have hpos : ∀ w : ℝ, 0 ≤ w → IntervalIntegrable (fun y : ℝ => |y| ^ r) volume 0 w := by
    intro w hw
    refine (intervalIntegral.intervalIntegrable_rpow' (a := 0) (b := w) hr).congr ?_
    intro y hy
    rw [uIoc_of_le hw] at hy
    simp [abs_of_pos hy.1]
  have h0 : ∀ w : ℝ, IntervalIntegrable (fun y : ℝ => |y| ^ r) volume 0 w := by
    intro w
    rcases le_total 0 w with hw | hw
    · exact hpos w hw
    · have := (IntervalIntegrable.iff_comp_neg (f := fun y : ℝ => |y| ^ r)
        (a := 0) (b := -w)).mp (hpos (-w) (by linarith))
      simpa using this
  exact (h0 u).symm.trans (h0 v)

/-- Auxiliary: `∫_0^w |y|^r dy = w^{r+1}/(r+1)` for `w ≥ 0`, `r > -1`. -/
theorem integral_abs_rpow_zero {r : ℝ} (hr : -1 < r) {w : ℝ} (hw : 0 ≤ w) :
    ∫ y in (0 : ℝ)..w, |y| ^ r = w ^ (r + 1) / (r + 1) := by
  have hne : r + 1 ≠ 0 := by linarith
  rw [intervalIntegral.integral_congr (g := fun y : ℝ => y ^ r), integral_rpow (Or.inl hr),
    Real.zero_rpow hne, sub_zero]
  intro y hy
  rw [uIcc_of_le hw] at hy
  simp [abs_of_nonneg hy.1]

/-- Auxiliary: `∫_{-w}^0 |y|^r dy = w^{r+1}/(r+1)` for `w ≥ 0`, `r > -1`. -/
theorem integral_abs_rpow_neg {r : ℝ} (hr : -1 < r) {w : ℝ} (hw : 0 ≤ w) :
    ∫ y in (-w)..0, |y| ^ r = w ^ (r + 1) / (r + 1) := by
  have h := intervalIntegral.integral_comp_neg (a := 0) (b := w) (fun y : ℝ => |y| ^ r)
  simp only [abs_neg, neg_zero] at h
  rw [← h, integral_abs_rpow_zero hr hw]

/-- Auxiliary: the exact row integral `∫_0^T |t-s|^{-a} ds = (t^{1-a}+(T-t)^{1-a})/(1-a)`
for `t ∈ [0,T]`, with integrability. -/
theorem integral_row {a T t : ℝ} (ha1 : a < 1) (ht : t ∈ Icc 0 T) :
    IntegrableOn (fun s => kern a (t - s)) (Icc 0 T) ∧
      ∫ s in Icc 0 T, kern a (t - s) = (t ^ (1 - a) + (T - t) ^ (1 - a)) / (1 - a) := by
  have hr : -1 < -a := by linarith
  have hT : 0 ≤ T := ht.1.trans ht.2
  have hII : IntervalIntegrable (fun s => kern a (t - s)) volume 0 T := by
    have := (intervalIntegrable_abs_rpow hr (t - T) (t - 0)).comp_sub_left t
    simpa [kern] using this.symm
  refine ⟨(intervalIntegrable_iff_integrableOn_Icc_of_le hT).mp hII, ?_⟩
  rw [integral_Icc_eq_integral_Ioc, ← intervalIntegral.integral_of_le hT]
  have e1 : ∫ s in (0 : ℝ)..T, kern a (t - s) = ∫ y in (t - T)..(t - 0), |y| ^ (-a) := by
    simp only [kern]
    exact intervalIntegral.integral_comp_sub_left (fun y : ℝ => |y| ^ (-a)) t
  rw [e1, sub_zero, ← intervalIntegral.integral_add_adjacent_intervals
    (intervalIntegrable_abs_rpow hr _ _) (intervalIntegrable_abs_rpow hr _ _)]
  have e2 : t - T = -(T - t) := by ring
  rw [e2, integral_abs_rpow_neg hr (by linarith [ht.2]), integral_abs_rpow_zero hr ht.1]
  have : -a + 1 = 1 - a := by ring
  rw [this]
  ring

/-- Auxiliary: the row bound `∫_0^T |t-s|^{-a} ds ≤ 2T^{1-a}/(1-a)` for `t ∈ [0,T]`
(TeX line 171-172), in `ℝ≥0∞`. -/
theorem lintegral_row_le {a T t : ℝ} (ha1 : a < 1) (ht : t ∈ Icc 0 T) :
    ∫⁻ s in Icc 0 T, ENNReal.ofReal (kern a (t - s)) ≤
      ENNReal.ofReal (2 * T ^ (1 - a) / (1 - a)) := by
  obtain ⟨hi, he⟩ := integral_row ha1 ht
  rw [← ofReal_integral_eq_lintegral_ofReal hi (ae_of_all _ fun s => kern_nonneg _ _), he]
  apply ENNReal.ofReal_le_ofReal
  have h1a : 0 < 1 - a := by linarith
  have hT : 0 ≤ T := ht.1.trans ht.2
  have e1 : t ^ (1 - a) ≤ T ^ (1 - a) := Real.rpow_le_rpow ht.1 ht.2 h1a.le
  have e2 : (T - t) ^ (1 - a) ≤ T ^ (1 - a) :=
    Real.rpow_le_rpow (by linarith [ht.2]) (by linarith [ht.1]) h1a.le
  rw [div_le_div_iff_of_pos_right h1a]
  linarith

/-- Auxiliary: `2xy ≤ x² + y²` in `ℝ≥0∞`. -/
theorem two_mul_le_add_sq_ennreal (x y : ℝ≥0∞) : 2 * x * y ≤ x ^ 2 + y ^ 2 := by
  rcases eq_or_ne x ⊤ with rfl | hx
  · simp
  rcases eq_or_ne y ⊤ with rfl | hy
  · simp
  lift x to NNReal using hx
  lift y to NNReal using hy
  exact_mod_cast two_mul_le_add_sq x y

/-- Auxiliary (Tonelli form of the Schur bound): for `g ≥ 0` a.e.-measurable on
`[0,T]`,
`∫∫_{[0,T]²} g(t) g(s) |t-s|^{-a} ≤ (2T^{1-a}/(1-a)) ∫_{[0,T]} g²`.
Here `volume.restrict (Icc 0 T)` is a finite measure (so s-finite). -/
theorem schur_lintegral {a T : ℝ} (ha1 : a < 1) (g : ℝ → ℝ≥0∞)
    (hg : AEMeasurable g (volume.restrict (Icc 0 T))) :
    ∫⁻ p : ℝ × ℝ, g p.1 * g p.2 * ENNReal.ofReal (kern a (p.1 - p.2))
        ∂((volume.restrict (Icc 0 T)).prod (volume.restrict (Icc 0 T))) ≤
      ENNReal.ofReal (2 * T ^ (1 - a) / (1 - a)) *
        ∫⁻ t in Icc 0 T, g t ^ 2 := by
  set μ := volume.restrict (Icc (0 : ℝ) T)
  set R := ENNReal.ofReal (2 * T ^ (1 - a) / (1 - a))
  have hk : Measurable fun p : ℝ × ℝ => ENNReal.ofReal (kern a (p.1 - p.2)) :=
    ENNReal.measurable_ofReal.comp ((measurable_kern a).comp (measurable_fst.sub measurable_snd))
  have hf1 : AEMeasurable (fun p : ℝ × ℝ => g p.1) (μ.prod μ) := hg.comp_fst
  have hf2 : AEMeasurable (fun p : ℝ × ℝ => g p.2) (μ.prod μ) := hg.comp_snd
  have hg1 : AEMeasurable (fun p : ℝ × ℝ => g p.1 ^ 2 * ENNReal.ofReal (kern a (p.1 - p.2)))
      (μ.prod μ) := (hf1.pow_const 2).mul hk.aemeasurable
  have hg2 : AEMeasurable (fun p : ℝ × ℝ => g p.2 ^ 2 * ENNReal.ofReal (kern a (p.1 - p.2)))
      (μ.prod μ) := (hf2.pow_const 2).mul hk.aemeasurable
  -- the two halves
  have hA : ∫⁻ p : ℝ × ℝ, g p.1 ^ 2 * ENNReal.ofReal (kern a (p.1 - p.2)) ∂(μ.prod μ) ≤
      R * ∫⁻ t, g t ^ 2 ∂μ := by
    rw [lintegral_prod _ hg1]
    calc ∫⁻ x, ∫⁻ y, g x ^ 2 * ENNReal.ofReal (kern a (x - y)) ∂μ ∂μ
        = ∫⁻ x, g x ^ 2 * ∫⁻ y, ENNReal.ofReal (kern a (x - y)) ∂μ ∂μ := by
          refine lintegral_congr fun x => ?_
          exact lintegral_const_mul _ (ENNReal.measurable_ofReal.comp
            ((measurable_kern a).comp (measurable_const.sub measurable_id)))
      _ ≤ ∫⁻ x, g x ^ 2 * R ∂μ := by
          refine lintegral_mono_ae ?_
          filter_upwards [ae_restrict_mem measurableSet_Icc] with x hx
          gcongr
          exact lintegral_row_le ha1 hx
      _ = R * ∫⁻ t, g t ^ 2 ∂μ := by
          rw [lintegral_mul_const'' _ (hg.pow_const 2), mul_comm]
  have hB : ∫⁻ p : ℝ × ℝ, g p.2 ^ 2 * ENNReal.ofReal (kern a (p.1 - p.2)) ∂(μ.prod μ) ≤
      R * ∫⁻ t, g t ^ 2 ∂μ := by
    rw [lintegral_prod_symm _ hg2]
    calc ∫⁻ y, ∫⁻ x, g y ^ 2 * ENNReal.ofReal (kern a (x - y)) ∂μ ∂μ
        = ∫⁻ y, g y ^ 2 * ∫⁻ x, ENNReal.ofReal (kern a (y - x)) ∂μ ∂μ := by
          refine lintegral_congr fun y => ?_
          simp_rw [kern_sub_comm a _ y]
          exact lintegral_const_mul _ (ENNReal.measurable_ofReal.comp
            ((measurable_kern a).comp (measurable_const.sub measurable_id)))
      _ ≤ ∫⁻ y, g y ^ 2 * R ∂μ := by
          refine lintegral_mono_ae ?_
          filter_upwards [ae_restrict_mem measurableSet_Icc] with y hy
          gcongr
          exact lintegral_row_le ha1 hy
      _ = R * ∫⁻ t, g t ^ 2 ∂μ := by
          rw [lintegral_mul_const'' _ (hg.pow_const 2), mul_comm]
  have h2 : 2 * ∫⁻ p : ℝ × ℝ, g p.1 * g p.2 * ENNReal.ofReal (kern a (p.1 - p.2)) ∂(μ.prod μ)
      ≤ 2 * (R * ∫⁻ t, g t ^ 2 ∂μ) := by
    rw [← lintegral_const_mul' _ _ (by norm_num)]
    calc ∫⁻ p : ℝ × ℝ, 2 * (g p.1 * g p.2 * ENNReal.ofReal (kern a (p.1 - p.2))) ∂(μ.prod μ)
        ≤ ∫⁻ p : ℝ × ℝ, (g p.1 ^ 2 * ENNReal.ofReal (kern a (p.1 - p.2)) +
            g p.2 ^ 2 * ENNReal.ofReal (kern a (p.1 - p.2))) ∂(μ.prod μ) := by
          refine lintegral_mono fun p => ?_
          rw [← add_mul, ← mul_assoc, ← mul_assoc]
          gcongr
          exact two_mul_le_add_sq_ennreal _ _
      _ = ∫⁻ p : ℝ × ℝ, g p.1 ^ 2 * ENNReal.ofReal (kern a (p.1 - p.2)) ∂(μ.prod μ) +
            ∫⁻ p : ℝ × ℝ, g p.2 ^ 2 * ENNReal.ofReal (kern a (p.1 - p.2)) ∂(μ.prod μ) :=
          lintegral_add_left' hg1 _
      _ ≤ R * ∫⁻ t, g t ^ 2 ∂μ + R * ∫⁻ t, g t ^ 2 ∂μ := add_le_add hA hB
      _ = 2 * (R * ∫⁻ t, g t ^ 2 ∂μ) := by rw [two_mul]
  exact (ENNReal.mul_le_mul_iff_right (by norm_num) (by norm_num)).mp h2

/-! ### The Schur bound -/

/-- Auxiliary: the integrand `f(t) conj f(s) |t-s|^{-a}` of the (complexified)
form, for any `RCLike` scalar field. -/
def integrand {𝕜 : Type*} [RCLike 𝕜] (a : ℝ) (f : ℝ → 𝕜) (p : ℝ × ℝ) : 𝕜 :=
  f p.1 * starRingEnd 𝕜 (f p.2) * ((kern a (p.1 - p.2) : ℝ) : 𝕜)

/-- The Schur bound for an `RCLike`-valued `f ∈ L²(0,T)`: the integrand is
integrable on `[0,T]²` and the double integral is bounded in absolute value by
`(2T^{1-a}/(1-a)) ∫_{[0,T]} ‖f‖²`.  Hypotheses: `a < 1`, `0 ≤ T`,
`f ∈ L²(0,T)`. -/
theorem time_schur_rclike {𝕜 : Type*} [RCLike 𝕜] {a T : ℝ} (ha1 : a < 1)
    (hT : 0 ≤ T) (f : ℝ → 𝕜) (hf : MemLp f 2 (volume.restrict (Icc 0 T))) :
    Integrable (integrand a f) ((volume.restrict (Icc 0 T)).prod (volume.restrict (Icc 0 T))) ∧
      ‖∫ t in Icc 0 T, ∫ s in Icc 0 T, integrand a f (t, s)‖ ≤
        2 * T ^ (1 - a) / (1 - a) * ∫ t in Icc 0 T, ‖f t‖ ^ 2 := by
  set μ := volume.restrict (Icc (0 : ℝ) T)
  set R := 2 * T ^ (1 - a) / (1 - a)
  have hR : 0 ≤ R := div_nonneg (by have := Real.rpow_nonneg hT (1 - a); linarith) (by linarith)
  have hm : AEStronglyMeasurable (integrand a f) (μ.prod μ) := by
    unfold integrand
    refine (hf.aestronglyMeasurable.comp_fst.mul
      (RCLike.continuous_conj.comp_aestronglyMeasurable hf.aestronglyMeasurable.comp_snd)).mul ?_
    exact (RCLike.continuous_ofReal.measurable.comp
      ((measurable_kern a).comp (measurable_fst.sub measurable_snd))).aestronglyMeasurable
  set g : ℝ → ℝ≥0∞ := fun t => ENNReal.ofReal ‖f t‖
  have hg : AEMeasurable g μ := hf.aestronglyMeasurable.norm.aemeasurable.ennreal_ofReal
  have hpt : ∀ p : ℝ × ℝ, ENNReal.ofReal ‖integrand a f p‖ =
      g p.1 * g p.2 * ENNReal.ofReal (kern a (p.1 - p.2)) := by
    intro p
    simp only [integrand, norm_mul, RCLike.norm_conj, RCLike.norm_ofReal,
      abs_of_nonneg (kern_nonneg a _), g]
    rw [ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_mul (norm_nonneg _)]
  have hI2 : Integrable (fun t => ‖f t‖ ^ 2) μ := hf.integrable_norm_pow (by norm_num)
  have hg2 : ∫⁻ t, g t ^ 2 ∂μ = ENNReal.ofReal (∫ t, ‖f t‖ ^ 2 ∂μ) := by
    rw [ofReal_integral_eq_lintegral_ofReal hI2 (ae_of_all _ fun t => by positivity)]
    refine lintegral_congr fun t => ?_
    simp only [g, ENNReal.ofReal_pow (norm_nonneg _)]
  have hbound : ∫⁻ p, ENNReal.ofReal ‖integrand a f p‖ ∂(μ.prod μ) ≤
      ENNReal.ofReal R * ENNReal.ofReal (∫ t, ‖f t‖ ^ 2 ∂μ) := by
    simp_rw [hpt]
    rw [← hg2]
    exact schur_lintegral ha1 g hg
  have hint : Integrable (integrand a f) (μ.prod μ) := by
    refine ⟨hm, (hasFiniteIntegral_iff_norm _).2 (lt_of_le_of_lt hbound ?_)⟩
    exact ENNReal.mul_lt_top ENNReal.ofReal_lt_top ENNReal.ofReal_lt_top
  refine ⟨hint, ?_⟩
  have hfub : ∫ t in Icc 0 T, ∫ s in Icc 0 T, integrand a f (t, s) =
      ∫ p, integrand a f p ∂(μ.prod μ) := (integral_prod _ hint).symm
  rw [hfub]
  refine (norm_integral_le_lintegral_norm _).trans ?_
  have hnn : 0 ≤ ∫ t, ‖f t‖ ^ 2 ∂μ := integral_nonneg fun t => by positivity
  calc (∫⁻ p, ENNReal.ofReal ‖integrand a f p‖ ∂(μ.prod μ)).toReal
      ≤ (ENNReal.ofReal R * ENNReal.ofReal (∫ t, ‖f t‖ ^ 2 ∂μ)).toReal :=
        ENNReal.toReal_mono (ENNReal.mul_ne_top ENNReal.ofReal_ne_top ENNReal.ofReal_ne_top) hbound
    _ = R * ∫ t, ‖f t‖ ^ 2 ∂μ := by
        rw [ENNReal.toReal_mul, ENNReal.toReal_ofReal hR, ENNReal.toReal_ofReal hnn]

/-! ### The complexified form and the paper statements -/

/-- The complexified temporal form
`⟨f,g⟩_a = ∫_0^T ∫_0^T f(t) conj g(s) |t-s|^{-a} dt ds`
(TeX lines 143-145, complexified as in lines 153-154).  A Bochner iterated
integral: it is the manuscript's form only where the integrand is integrable,
which every theorem below proves or assumes explicitly. -/
def timeForm (a T : ℝ) (f g : ℝ → ℂ) : ℂ :=
  ∫ t in Icc 0 T, ∫ s in Icc 0 T, f t * conj (g s) * ((kern a (t - s) : ℝ) : ℂ)

/-- `E:masked-time-schur` (TeX lines 150-152) after complexification (TeX lines
153-154 and 175-177), double-integral form: for `0 < a < 1`, `T > 0` and complex
`f ∈ L²(0,T)`, the integrand `f(t) conj f(s) |t-s|^{-a}` is integrable on
`[0,T]²` and `|⟨f,f⟩_a| ≤ (2T^{1-a}/(1-a)) ‖f‖₂²`.  The hypothesis `0 < a` is
the manuscript's standing assumption; the proof uses only `a < 1` and `0 ≤ T`. -/
theorem time_schur_complex {a T : ℝ} (_ha0 : 0 < a) (ha1 : a < 1) (hT : 0 < T)
    (f : ℝ → ℂ) (hf : MemLp f 2 (volume.restrict (Icc 0 T))) :
    Integrable (fun p : ℝ × ℝ => f p.1 * conj (f p.2) * ((kern a (p.1 - p.2) : ℝ) : ℂ))
        ((volume.restrict (Icc 0 T)).prod (volume.restrict (Icc 0 T))) ∧
      ‖timeForm a T f f‖ ≤ 2 * T ^ (1 - a) / (1 - a) * ∫ t in Icc 0 T, ‖f t‖ ^ 2 :=
  time_schur_rclike ha1 hT.le f hf

