/-! ### Linear substitutions in polynomials -/

/-- The linear form `x ↦ Σ_j S_ij x_j` as a polynomial. -/
def linPoly {m : ℕ} (S : Matrix (Fin m) (Fin m) ℝ) (i : Fin m) : MvPolynomial (Fin m) ℝ :=
  ∑ j, MvPolynomial.C (S i j) * MvPolynomial.X j

