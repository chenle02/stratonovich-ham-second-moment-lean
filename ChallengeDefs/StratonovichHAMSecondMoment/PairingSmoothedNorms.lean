/-! ### The second norm -/

/-- The combined multiplier `e^{-ε|ξ|²/2} e^{-η|ξ|²}` as an `ℝ≥0`-valued function. -/
def multNN (ε η : ℝ) (ξ : Rd d) : NNReal := (gaussFactor ε ξ * gaussFactor η ξ ^ 2).toNNReal

section Second

