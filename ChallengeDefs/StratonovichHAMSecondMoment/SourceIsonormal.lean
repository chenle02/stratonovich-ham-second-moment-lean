/-! ### The characteristic functional on `L²(P)` -/

section CharL2

variable {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]

/-- `E exp(i f)` for `f ∈ L²(P)` (computed on the canonical representative). -/
def charL2 (f : Lp ℝ 2 P) : ℂ := ∫ ω, exp ((f ω : ℂ) * I) ∂P

/-- `|e^{ia} - e^{ib}| ≤ |a - b|`. -/
theorem norm_cexp_sub_cexp_le (a b : ℝ) :
    ‖exp ((a : ℂ) * I) - exp ((b : ℂ) * I)‖ ≤ |a - b| := by
  have h : exp ((a : ℂ) * I) - exp ((b : ℂ) * I) =
      exp ((b : ℂ) * I) * (exp (I * ((a - b : ℝ) : ℂ)) - 1) := by
    rw [mul_sub, mul_one, ← Complex.exp_add]
    congr 2
    push_cast
    ring
  rw [h, norm_mul, Complex.norm_exp_ofReal_mul_I, one_mul]
  simpa [Real.norm_eq_abs] using (Real.norm_exp_I_mul_ofReal_sub_one_le (x := a - b))

omit [IsProbabilityMeasure P] in
theorem measurable_cexp_L2 (f : Lp ℝ 2 P) : Measurable fun ω => exp ((f ω : ℂ) * I) :=
  ((Complex.measurable_ofReal.comp (Lp.stronglyMeasurable f).measurable).mul_const I).cexp

theorem integrable_cexp_L2 (f : Lp ℝ 2 P) : Integrable (fun ω => exp ((f ω : ℂ) * I)) P :=
  (integrable_const (1 : ℝ)).mono' (measurable_cexp_L2 P f).aestronglyMeasurable
    (Eventually.of_forall fun ω => by rw [Complex.norm_exp_ofReal_mul_I])

/-- `‖f‖₁ ≤ ‖f‖₂` on a probability space. -/
theorem integral_abs_le_norm (f : Lp ℝ 2 P) : ∫ ω, |f ω| ∂P ≤ ‖f‖ := by
  have hm := Lp.aestronglyMeasurable f
  have h1 : ∫ ω, |f ω| ∂P = (eLpNorm f 1 P).toReal := by
    rw [eLpNorm_one_eq_lintegral_enorm, ← integral_norm_eq_lintegral_enorm hm]
    all_goals first | exact hm | simp only [Real.norm_eq_abs]
  rw [h1, Lp.norm_def]
  exact ENNReal.toReal_mono (Lp.eLpNorm_ne_top f)
    (eLpNorm_le_eLpNorm_of_exponent_le (by norm_num))

/-- `charL2` is `1`-Lipschitz on `L²(P)`. -/
theorem norm_charL2_sub_le (f g : Lp ℝ 2 P) : ‖charL2 P f - charL2 P g‖ ≤ ‖f - g‖ := by
  unfold charL2
  rw [← integral_sub (integrable_cexp_L2 P f) (integrable_cexp_L2 P g)]
  refine (norm_integral_le_integral_norm _).trans ?_
  refine le_trans ?_ (integral_abs_le_norm P (f - g))
  refine integral_mono_ae ((integrable_cexp_L2 P f).sub (integrable_cexp_L2 P g)).norm
    ((Lp.memLp (f - g)).integrable (by norm_num)).abs ?_
  filter_upwards [Lp.coeFn_sub f g] with ω h
  simp only [Pi.sub_apply] at h
  simpa only [h] using norm_cexp_sub_cexp_le (f ω) (g ω)

theorem continuous_charL2 : Continuous (charL2 P) :=
  (LipschitzWith.of_dist_le_mul (K := 1) fun f g => by
    simpa [dist_eq_norm, NNReal.coe_one, one_mul] using norm_charL2_sub_le P f g).continuous

end CharL2

/-! ### The standard Gaussian product and its coordinates -/

section Noise

variable (ι : Type*)

/-- The product of standard Gaussians on `ι → ℝ` (any index type). -/
def gP : Measure (ι → ℝ) := Measure.infinitePi fun _ : ι => gaussianReal 0 1

instance instIsProbabilityMeasureGP : IsProbabilityMeasure (gP ι) := by
  unfold gP; infer_instance

variable {ι}

theorem measurePreserving_coord (i : ι) :
    MeasurePreserving (fun ω : ι → ℝ => ω i) (gP ι) (gaussianReal 0 1) :=
  measurePreserving_eval_infinitePi (fun _ : ι => gaussianReal 0 1) i

theorem memLp_coord (i : ι) : MemLp (fun ω : ι → ℝ => ω i) 2 (gP ι) :=
  (memLp_id_gaussianReal' 2 (by norm_num)).comp_measurePreserving (measurePreserving_coord i)

theorem integral_coord_comp (i : ι) {g : ℝ → ℝ} (hg : Measurable g) :
    ∫ ω, g (ω i) ∂gP ι = ∫ x, g x ∂gaussianReal 0 1 := by
  rw [← (measurePreserving_coord i).map_eq,
    integral_map (measurePreserving_coord i).measurable.aemeasurable hg.aestronglyMeasurable]

theorem integral_coord (i : ι) : ∫ ω, ω i ∂gP ι = 0 := by
  rw [integral_coord_comp i (g := fun x => x) measurable_id]
  exact integral_id_gaussianReal

theorem integral_coord_sq (i : ι) : ∫ ω, ω i * ω i ∂gP ι = 1 := by
  rw [integral_coord_comp i (g := fun x => x * x) (measurable_id.mul measurable_id)]
  have hv := variance_id_gaussianReal (μ := 0) (v := 1)
  rw [variance_of_integral_eq_zero aemeasurable_id integral_id_gaussianReal] at hv
  simpa [sq] using hv

theorem integral_coord_mul_of_ne {i j : ι} (hij : i ≠ j) : ∫ ω, ω i * ω j ∂gP ι = 0 := by
  have hind : iIndepFun (fun k (ω : ι → ℝ) => ω k) (gP ι) :=
    iIndepFun_infinitePi (P := fun _ : ι => gaussianReal 0 1) (X := fun _ (x : ℝ) => x)
      fun _ => measurable_id
  rw [(hind.indepFun hij).integral_fun_mul_eq_mul_integral
    (measurable_pi_apply i).aestronglyMeasurable (measurable_pi_apply j).aestronglyMeasurable,
    integral_coord i, zero_mul]

variable (ι)

/-- The coordinate `ξ_i` as an element of `L²(gP ι)`. -/
def xi (i : ι) : Lp ℝ 2 (gP ι) := (memLp_coord i).toLp _

theorem coeFn_xi (i : ι) : (xi ι i : (ι → ℝ) → ℝ) =ᵐ[gP ι] fun ω => ω i :=
  MemLp.coeFn_toLp _

theorem orthonormal_xi : Orthonormal ℝ (xi ι) := by
  classical
  rw [orthonormal_iff_ite]
  intro i j
  rw [MeasureTheory.L2.inner_def]
  have h : ∫ ω, inner ℝ (xi ι i ω) (xi ι j ω) ∂gP ι = ∫ ω, ω i * ω j ∂gP ι := by
    refine integral_congr_ae ?_
    filter_upwards [coeFn_xi ι i, coeFn_xi ι j] with ω hi hj
    rw [hi, hj, RCLike.inner_apply, conj_trivial, mul_comm]
  rw [h]
  split_ifs with hij
  · subst hij; exact integral_coord_sq i
  · exact integral_coord_mul_of_ne hij

/-- The linear isometry `ℓ²(ι) → L²(gP ι)`, `e_i ↦ ξ_i`. -/
def VL2 : lp (fun _ : ι => ℝ) 2 →ₗᵢ[ℝ] Lp ℝ 2 (gP ι) :=
  (orthonormal_xi ι).orthogonalFamily.linearIsometry

variable {ι}

/-- The key finite computation: `E exp(i Σ_{i ∈ F} c_i ξ_i) = exp(-Σ_{i∈F} c_i²/2)` (the
product structure of `infinitePi` over the finite set `F`). -/
theorem integral_exp_sum (F : Finset ι) (c : ι → ℝ) :
    ∫ ω, exp ((∑ i ∈ F, c i * ω i : ℝ) * I) ∂gP ι = exp (-(∑ i ∈ F, c i ^ 2 : ℝ) / 2) := by
  have hmap : (gP ι).map F.restrict = Measure.pi fun _ : F => gaussianReal 0 1 :=
    Measure.infinitePi_map_restrict (μ := fun _ : ι => gaussianReal 0 1)
  have hfun : (fun ω : ι → ℝ => exp ((∑ i ∈ F, c i * ω i : ℝ) * I)) =
      (fun x : F → ℝ => ∏ i : F, exp ((c i * x i : ℝ) * I)) ∘ F.restrict := by
    funext ω
    simp only [Function.comp_apply, Finset.restrict]
    rw [← Complex.exp_sum, ← Finset.sum_mul]
    congr 2
    push_cast
    exact (Finset.sum_attach F (fun i => (c i : ℂ) * (ω i : ℂ))).symm
  have key : ∫ x, (∏ i : F, exp ((c i * x i : ℝ) * I)) ∂((gP ι).map F.restrict) =
      integral (gP ι) ((fun x : F → ℝ => ∏ i : F, exp ((c i * x i : ℝ) * I)) ∘ F.restrict) :=
    integral_map (Finset.measurable_restrict F).aemeasurable
      (by fun_prop : Continuous fun x : F → ℝ => ∏ i : F, exp ((c i * x i : ℝ) * I)).aestronglyMeasurable
  rw [hfun, ← key, hmap, integral_fintype_prod_eq_prod
      (f := fun (i : F) (x : ℝ) => exp ((c i * x : ℝ) * I))]
  have h1 : ∀ i : F, ∫ x, exp ((c i * x : ℝ) * I) ∂gaussianReal 0 1 =
      exp (-(c i ^ 2 : ℝ) / 2) := by
    intro i
    have := charFun_gaussianReal (μ := 0) (v := 1) (c i)
    rw [charFun_apply_real] at this
    rw [show (fun x : ℝ => exp ((c i * x : ℝ) * I)) = fun x : ℝ => exp (c i * x * I) by
      funext x; push_cast; ring_nf]
    rw [this]
    congr 1
    push_cast
    ring
  simp_rw [h1]
  rw [← Complex.exp_sum]
  congr 1
  push_cast
  rw [neg_div, Finset.sum_div, ← Finset.sum_neg_distrib, ← Finset.sum_coe_sort F]
  refine Finset.sum_congr rfl fun i _ => ?_
  ring

end Noise

/-! ### The isonormal map of a Hilbert space -/

section Iso

variable {ι : Type*} {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
  (b : HilbertBasis ι ℝ H)

/-- The isonormal map `H → L²(gP ι)`, `g ↦ Σ_i ⟪b_i, g⟫ ξ_i`, a linear isometry. -/
def isoL2 : H →ₗᵢ[ℝ] Lp ℝ 2 (gP ι) := (VL2 ι).comp b.repr.toLinearIsometry

theorem hasSum_isoL2 (g : H) : HasSum (fun i => inner ℝ (b i) g • xi ι i) (isoL2 b g) := by
  have h := (orthonormal_xi ι).orthogonalFamily.hasSum_linearIsometry (b.repr g)
  have e : (fun i => inner ℝ (b i) g • xi ι i) = fun i =>
      LinearIsometry.toSpanSingleton ℝ (Lp ℝ 2 (gP ι)) ((orthonormal_xi ι).1 i) (b.repr g i) := by
    funext i
    rw [LinearIsometry.toSpanSingleton_apply, b.repr_apply_apply]
  rw [e]
  exact h

/-- On a finite partial sum, `E exp(i Σ_{i∈F} ⟪b_i,g⟫ ξ_i) = exp(-Σ_{i∈F} ⟪b_i,g⟫²/2)`. -/
theorem charL2_partial (g : H) (F : Finset ι) :
    charL2 (gP ι) (∑ i ∈ F, inner ℝ (b i) g • xi ι i) =
      exp (-(∑ i ∈ F, inner ℝ (b i) g ^ 2 : ℝ) / 2) := by
  unfold charL2
  rw [← integral_exp_sum F (fun i => inner ℝ (b i) g)]
  refine integral_congr_ae ?_
  have h1 := Lp.coeFn_fun_finsetSum F (fun i => inner ℝ (b i) g • xi ι i)
  have h2 : ∀ᵐ ω ∂gP ι, ∀ i ∈ F,
      ((inner ℝ (b i) g • xi ι i : Lp ℝ 2 (gP ι)) : (ι → ℝ) → ℝ) ω = inner ℝ (b i) g * ω i := by
    refine (Filter.eventually_all_finset F).2 fun i _ => ?_
    filter_upwards [Lp.coeFn_smul (inner ℝ (b i) g) (xi ι i), coeFn_xi ι i] with ω h hx
    rw [h, Pi.smul_apply, hx, smul_eq_mul]
  filter_upwards [h1, h2] with ω h1 h2
  rw [h1, Finset.sum_congr rfl h2]

/-- `E exp(i W g) = exp(-‖g‖²/2)` (applied to `t g`, `t ∈ ℝ`, this is the characteristic function
of `N(0, ‖g‖²)`). -/
theorem charL2_isoL2 (g : H) : charL2 (gP ι) (isoL2 b g) = exp (-((‖g‖ ^ 2 : ℝ) : ℂ) / 2) := by
  have hS : Tendsto (fun F : Finset ι => ∑ i ∈ F, inner ℝ (b i) g • xi ι i) atTop
      (𝓝 (isoL2 b g)) := hasSum_isoL2 b g
  have h1 := ((continuous_charL2 (gP ι)).tendsto _).comp hS
  have hq : HasSum (fun i => inner ℝ (b i) g ^ 2) (‖g‖ ^ 2) := by
    have h := b.hasSum_inner_mul_inner g g
    rw [real_inner_self_eq_norm_sq] at h
    convert h using 1
    funext i
    rw [real_inner_comm g (b i), sq]
  have hq' : Tendsto (fun F : Finset ι => ∑ i ∈ F, inner ℝ (b i) g ^ 2) atTop
      (𝓝 (‖g‖ ^ 2)) := hq
  have h2 := ((by fun_prop : Continuous fun r : ℝ => exp (-(r : ℂ) / 2)).tendsto _).comp hq'
  refine tendsto_nhds_unique h1 (h2.congr fun F => ?_)
  simp only [Function.comp_apply]
  exact (charL2_partial b g F).symm

/-- The isonormal field: the canonical representative of `isoL2 b h`. -/
def isoW (h : H) : (ι → ℝ) → ℝ := (isoL2 b h : (ι → ℝ) → ℝ)

/-- `uᵀ G u = ‖Σ_a u_a p_a‖²` for the Gram matrix `G` of `p`. -/
theorem quad_gram {n : ℕ} (p : Fin n → H) (u : Fin n → ℝ) :
    u ⬝ᵥ (Matrix.of fun a b => inner ℝ (p a) (p b)) *ᵥ u = ‖∑ a, u a • p a‖ ^ 2 := by
  rw [← real_inner_self_eq_norm_sq, sum_inner]
  simp only [dotProduct, Matrix.mulVec, Matrix.of_apply, inner_sum, real_inner_smul_left,
    real_inner_smul_right, Finset.mul_sum]
  refine Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun c _ => ?_
  ring

theorem gram_posSemidef {n : ℕ} (p : Fin n → H) :
    (Matrix.of fun a b => inner ℝ (p a) (p b)).PosSemidef :=
  Matrix.posSemidef_gram ℝ p

/-- The law of `(W(p_1), …, W(p_n))` is `multivariateGaussian 0 (Gram)`. -/
theorem hasLaw_isoW {n : ℕ} (p : Fin n → H) :
    HasLaw (fun ω => WithLp.toLp 2 (fun a => isoW b (p a) ω))
      (multivariateGaussian 0 (Matrix.of fun a c => inner ℝ (p a) (p c))) (gP ι) := by
  have hmeas : Measurable fun ω : ι → ℝ => WithLp.toLp 2 (fun a => isoW b (p a) ω) :=
    (PiLp.continuous_toLp 2 _).measurable.comp
      (measurable_pi_iff.mpr fun a => (Lp.stronglyMeasurable _).measurable)
  refine ⟨hmeas.aemeasurable, ?_⟩
  apply Measure.ext_of_charFun
  funext u
  rw [charFun_multivariateGaussian (gram_posSemidef p), charFun_apply,
    integral_map hmeas.aemeasurable (by fun_prop)]
  set g : H := ∑ a, u a • p a
  have hae : (isoL2 b g : (ι → ℝ) → ℝ) =ᵐ[gP ι] fun ω => ∑ a, u a * isoW b (p a) ω := by
    have hg : isoL2 b g = ∑ a, u a • isoL2 b (p a) := by
      simp only [g, map_sum, map_smul]
    rw [hg]
    filter_upwards [Lp.coeFn_fun_finsetSum Finset.univ (fun a => u a • isoL2 b (p a)),
      ae_all_iff.2 fun a => Lp.coeFn_smul (u a) (isoL2 b (p a))] with ω h1 h2
    rw [h1]
    refine Finset.sum_congr rfl fun a _ => ?_
    rw [h2 a, Pi.smul_apply, smul_eq_mul]
    rfl
  have hin : ∀ ω : ι → ℝ, inner ℝ (WithLp.toLp 2 (fun a => isoW b (p a) ω)) u =
      ∑ a, u a * isoW b (p a) ω := by
    intro ω
    simp only [PiLp.inner_apply, RCLike.inner_apply, conj_trivial]
  have hL : ∫ ω, exp ((inner ℝ (WithLp.toLp 2 (fun a => isoW b (p a) ω)) u : ℝ) * I) ∂gP ι =
      charL2 (gP ι) (isoL2 b g) := by
    unfold charL2
    refine integral_congr_ae ?_
    filter_upwards [hae] with ω h
    rw [hin ω, h]
  rw [hL, charL2_isoL2 b g, ← quad_gram p (WithLp.ofLp u)]
  simp only [inner_zero_right, ofReal_zero, zero_mul, zero_sub]
  rw [neg_div]

/-- `h ↦ isoW b h` is a centered Gaussian field with covariance `⟪h, g⟫`. -/
theorem centeredGaussianField_isoW :
    CenteredGaussianField (isoW b) (fun h g => inner ℝ h g) (gP ι) :=
  ⟨fun _ p => gram_posSemidef p, fun _ p => hasLaw_isoW b p⟩

end Iso

/-- **Item L19-A.** The isonormal map exists on every complete real inner product space
`H : Type` (no separability): `Ω = ι → ℝ` for the index type `ι` of a Hilbert basis of `H`,
`P` the product of standard Gaussians, `W h` the canonical representative of
`Σ_i ⟪b_i, h⟫ ξ_i ∈ L²(P)`. -/
theorem isonormal : IsonormalTarget := by
  intro H _ _ _
  obtain ⟨w, b, -⟩ := exists_hilbertBasis ℝ H
  exact ⟨w → ℝ, inferInstance, gP w, isoW b, inferInstance, centeredGaussianField_isoW b⟩

end StratonovichHAMSecondMoment.SourceIsonormal

