                                      ∫⁻ (r : ℝ) in Set.Ioi (0 : ℝ),
                                        ENNReal.ofReal
                                          (r / δ * Real.exp ((G r - r ^ (2 : ℕ) / (2 : ℝ)) / δ)) := by
  sorry

end
