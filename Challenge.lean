/-- For reals a, D, x, y with a > 0, D > 0, x + y = a and x^2 <= D*y/2, one has 2*a^2/(D + 4*a) <= y; the mean relation x + y = a and the bound x^2 <= D*y/2 are supplied hypotheses. -/
theorem StratonovichHamSecondMomentLeanAudit.StratonovichHAMAudit.AllAlphaMoment.moment_lower :
    ∀ (a D x y : ℝ),
      (0 : ℝ) < a →
        (0 : ℝ) < D →
          x + y = a → x ^ (2 : ℕ) ≤ D * y / (2 : ℝ) → (2 : ℝ) * a ^ (2 : ℕ) / (D + (4 : ℝ) * a) ≤ y := by
  sorry

/-- For reals a > 0 and D > 0, a^2/(D*(D+4*a)) - a^2/(2*D*(D+2*a)) = a^2/(2*(D+4*a)*(D+2*a)), and this value is strictly positive. -/
theorem StratonovichHamSecondMomentLeanAudit.StratonovichHAMAudit.AllAlphaMoment.rational_gap :
    ∀ (a D : ℝ),
      (0 : ℝ) < a →
        (0 : ℝ) < D →
          a ^ (2 : ℕ) / (D * (D + (4 : ℝ) * a)) - a ^ (2 : ℕ) / ((2 : ℝ) * D * (D + (2 : ℝ) * a)) =
              a ^ (2 : ℕ) / ((2 : ℝ) * (D + (4 : ℝ) * a) * (D + (2 : ℝ) * a)) ∧
            (0 : ℝ) < a ^ (2 : ℕ) / ((2 : ℝ) * (D + (4 : ℝ) * a) * (D + (2 : ℝ) * a)) := by
  sorry

/-- For reals theta > 0, ell > 0 and any real r, (2*theta + ell) / (2*theta*(theta^2 + r^2)*((theta + ell)^2 + r^2)) = (1/(theta^2 + r^2) - 1/((theta + ell)^2 + r^2)) / (2*theta*ell). -/
theorem StratonovichHamSecondMomentLeanAudit.StratonovichHAMAudit.ClockFilter.resolvent_partial_fraction :
    ∀ (θ ell r : ℝ),
