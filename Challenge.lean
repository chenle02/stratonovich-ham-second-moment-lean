/-- For reals C, e and a real sequence d on the naturals, if 1 <= C, 0 <= e, d 0 <= 0 and d (n+1) <= C * d n + C^n * e for every n, then d n <= n * C^n * e for every natural n; the per-step recurrence is a supplied hypothesis. -/
theorem StratonovichHamSecondMomentLeanAudit.StratonovichHAMAudit.ActualEvent.finite_error_accumulation :
    ∀ (C e : ℝ) (d : ℕ → ℝ),
      (1 : ℝ) ≤ C →
        (0 : ℝ) ≤ e →
          d (0 : ℕ) ≤ (0 : ℝ) →
            (∀ (n : ℕ), d (n + (1 : ℕ)) ≤ C * d n + C ^ n * e) → ∀ (n : ℕ), d n ≤ ↑n * C ^ n * e := by
  sorry

