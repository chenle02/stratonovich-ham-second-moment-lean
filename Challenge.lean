                        (fun (ell : ℝ) => (2 : ℝ) * θ / ((2 : ℝ) * θ + ell) * w ell) σ ∧
                      LT.lt (α := ℝ) (∫ (ell : ℝ), (2 : ℝ) * θ / ((2 : ℝ) * θ + ell) * w ell ∂σ)
